{
    "name": "@formata/limitr",
    "version": "0.8.5",
    "description": "Limits, credits, and billing inside your AI product: an open-source engine that decides what each customer can do, what it costs you, and what to bill, on every call, in-process.",
    "author": "Formata, Inc. (https://limitr.dev)",
    "type": "module",
    "main": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "exports": {
        ".": {
            "types": "./dist/main.d.ts",
            "default": "./dist/main.js"
        }
    },
    "files": [
        "dist",
        "skill",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "skills": "rimraf skill/limitr skill/limitr-network skill/stof && cpy . ../../typescript/skill/limitr --cwd=../skill/limitr && cpy . ../../typescript/skill/limitr-network --cwd=../skill/limitr-network",
        "plugin": "rimraf ../plugin/skills && cpy . ../../plugin/skills/limitr --cwd=../skill/limitr && cpy . ../../plugin/skills/limitr-network --cwd=../skill/limitr-network && cpy . ../../../plugin/skills/limitr-ts --cwd=skill/limitr-ts && cpy . ../../../../../../plugin/skills/stof --cwd=node_modules/@formata/stof/skill/stof",
        "readme": "cpy README.md LICENSE typescript --cwd=..",
        "prepublishOnly": "npm run skills && npm run plugin && npm run readme && npm run build",
        "clean": "rimraf dist"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dev-formata-io/limitr.git",
        "directory": "typescript"
    },
    "homepage": "https://limitr.dev",
    "bugs": {
        "url": "https://github.com/dev-formata-io/limitr/issues"
    },
    "dependencies": {
        "@formata/stof": "^0.11.3"
    },
    "devDependencies": {
        "cpy-cli": "^7.0.0",
        "rimraf": "^6.1.2",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "limitr",
        "pricing",
        "usage-based-pricing",
        "usage-based-billing",
        "metering",
        "billing",
        "monetization",
        "credits",
        "quotas",
        "usage-limits",
        "spend-caps",
        "rate-limiting",
        "entitlements",
        "feature-flags",
        "wasm",
        "webassembly",
        "cost-tracking",
        "margin",
        "ai-cost-management",
        "llm",
        "token-metering",
        "stof"
    ]
}
