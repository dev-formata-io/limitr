{
    "name": "@formata/limitr",
    "version": "0.8.0",
    "description": "Open-source usage-based billing that runs inside your app: limits, credits, pricing, margins, feature flags, and AI cost control from one policy, checked in-process.",
    "author": "Formata, Inc. (https://limitr.dev)",
    "type": "module",
    "main": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "exports": {
        ".": {
            "types": "./dist/main.d.ts",
            "default": "./dist/main.js"
        }
    },
    "files": [
        "dist",
        "skill",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "skills": "cpy \"limitr/**\" ../typescript/skill/limitr --cwd=../skill && cpy \"stof/**\" ../typescript/skill/stof --cwd=../skill",
        "readme": "cpy README.md LICENSE typescript --cwd=..",
        "prepublishOnly": "npm run skills && npm run readme && npm run build",
        "clean": "rimraf dist"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dev-formata-io/limitr.git",
        "directory": "typescript"
    },
    "homepage": "https://limitr.dev",
    "bugs": {
        "url": "https://github.com/dev-formata-io/limitr/issues"
    },
    "dependencies": {
        "@formata/stof": "^0.10.8"
    },
    "devDependencies": {
        "cpy-cli": "^7.0.0",
        "rimraf": "^6.1.2",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "limitr",
        "pricing",
        "usage-based-pricing",
        "usage-based-billing",
        "metering",
        "billing",
        "monetization",
        "credits",
        "quotas",
        "usage-limits",
        "spend-caps",
        "rate-limiting",
        "entitlements",
        "feature-flags",
        "wasm",
        "webassembly",
        "cost-tracking",
        "margin",
        "ai-cost-management",
        "llm",
        "token-metering",
        "stof"
    ]
}
