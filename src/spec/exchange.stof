#[type]
ExchangePair: {
    #[schema((target_val: float): bool => target_val >= 0 ? true : <LimitrValidation>.error('Credit exchange mapping cannot have a negative value'))]
    /// Value/multiplier for this exchange pair.
    float! value: 1

    #[schema((target_val: str): bool => target_val.len() > 0 ? true : <LimitrValidation>.error('Credit exchange mapping must contain a valid currency'))]
    /// Currency of this exchange pair.
    str! currency: 'usd'
}


#[type]
/**
 * A policy-level credit exchange for credit grants.
 * Applied when overage occurs to draw from credit grants instead of charging.
 */
Exchange: {
    #[schema((target_val: str): bool => {
        set('expires_first', 'cheapest_first', 'valuable_first').contains(target_val) ? true :
        <LimitrValidation>.error(`Exchange grant strategy cannot be "${target_val}" - only 'expires_first', 'cheapest_first', or 'valuable_first'`)
    })]
    /// Grant selection strategy.
    /// 'expires_first' - Choose the grant that expires first
    /// 'cheapest_first' - Choose the lowest rune value per unit
    /// 'valuable_first' - Choose the highest rune value per unit
    str! grant_strategy: 'expires_first';

    /// Limitr Rune for an abstract, common exchange unit.
    /// Defined as $1 USD by default, don't change unless needed.
    /// Add currencies: Ex. euro: { value: 1.14, currency: 'usd' }
    ExchangePair! rune: {};
    ExchangePair! usd: { value: 1, currency: 'rune' };


    /**
     * Lookup exchange pair.
     * Pulled out of to_runes in case you'd like to replace with real-time rates.
     */
    fn get_pair(c: str!) -> ExchangePair {
        self.get(c)
    }


    /**
     * Resolve a currency to runes.
     * Returns [factor, credit]: one unit of `c` is `factor` units of `credit`, which prices
     * itself into runes (flat price or tiers). If credit is null, `factor` is the rune value.
     * Exchange pairs take precedence over credit pricing. Null if there is no path (or a cycle).
     */
    fn resolve(c: str!) -> list {
        let policy = self.parent();
        if (policy != null && ((typeof policy) != 'obj' || !policy.instance_of('Limitr'))) {
            policy = null;
        }

        const visited = set();
        let factor = 1.0;
        while (c != 'rune') {
            if (visited.contains(c)) return null; // cycle detected
            visited.insert(c);

            const def: ExchangePair = self.get_pair(c);
            if (def == null) {
                const credit = policy != null ? ?policy.credit(c) : null;
                if (credit != null && credit.priced()) return [factor, credit];
                return null; // no-can-do
            }
            factor *= def.value;
            c = def.currency;
        }
        [factor, null]
    }


    /**
     * To runes.
     * `offset` is the billable position the value starts at (in units of `c`), which only
     * matters for tiered/volume/stairstep credits - see Credit.price_of.
     */
    fn to_runes(v: float!, c: str!, offset: float = 0) -> float {
        const res = self.resolve(c);
        if (res == null) return null;
        const factor = res[0];
        const credit: Credit = res[1];
        if (credit == null) return v * factor;
        const qty = v * factor;
        const pos = offset * factor;
        credit.price_of(qty, pos)
    }


    /**
     * From runes: how many units of `c` a rune amount buys, starting at billable position
     * `offset` (in units of `c`). Inverse of to_runes.
     */
    fn from_runes(runes: float!, c: str!, offset: float = 0) -> float {
        const res = self.resolve(c);
        if (res == null) return null;
        const factor = res[0];
        if (factor <= 0) return null;
        const credit: Credit = res[1];
        if (credit == null) return runes / factor;
        const pos = offset * factor;
        const qty = credit.quantity_for(runes, pos);
        qty == null ? null : qty / factor
    }


    /**
     * Exchange one currency for another.
     * `in_offset` / `out_offset` are billable positions for tier-priced credits on either side
     * (e.g. how far into its tiers a customer already is this period). Both default to 0.
     */
    fn exchange(value: float!, in_currency: str!, out_currency: str!, in_offset: float = 0, out_offset: float = 0) -> float {
        value = value.remove_units();
        if (in_currency == out_currency) return value;
        const runes = self.to_runes(value, in_currency, in_offset);
        runes == null ? null : self.from_runes(runes, out_currency, out_offset)
    }
}
