#[type]
ExchangePair: {
    #[schema((target_val: float): bool => target_val >= 0 ? true : <LimitrValidation>.error('Credit exchange mapping cannot have a negative value'))]
    /// Value/multiplier for this exchange pair.
    float! value: 1

    #[schema((target_val: str): bool => target_val.len() > 0 ? true : <LimitrValidation>.error('Credit exchange mapping must contain a valid currency'))]
    /// Currency of this exchange pair.
    str! currency: 'usd'
}


#[type]
/**
 * A policy-level credit exchange for credit grants.
 * Applied when overage occurs to draw from credit grants instead of charging.
 */
Exchange: {
    #[schema((target_val: str): bool => {
        set('expires_first', 'cheapest_first', 'valuable_first').contains(target_val) ? true :
        <LimitrValidation>.error(`Exchange grant strategy cannot be "${target_val}" - only 'expires_first', 'cheapest_first', or 'valuable_first'`)
    })]
    /// Grant selection strategy.
    /// 'expires_first' - Choose the grant that expires first
    /// 'cheapest_first' - Choose the lowest rune value per unit
    /// 'valuable_first' - Choose the highest rune value per unit
    str! grant_strategy: 'expires_first';

    /// Limitr Rune ("rune") currency mapping.
    ExchangePair! rune: {};


    /**
     * To runes.
     */
    fn to_runes(v: float!, c: str!) -> float {
        const visited = set();
        
        let policy = self.parent();
        if (policy != null && ((typeof policy) != 'obj' || !policy.instance_of('Limitr'))) {
            policy = null;
        }

        while (c != 'rune') {
            if (visited.contains(c)) return null; // cycle detected
            visited.insert(c);

            const def: ExchangePair = self.get(c);
            let credit_defined = false;
            if (def == null) {
                if (policy != null) {
                    // try auto pricing in runes for this credit
                    const credit = ?policy.credit(c);
                    if (credit != null) {
                        if (credit.pricing_model == 'flat' && credit.price != null) {
                            v *= credit.price.amount;
                            c = 'rune';
                            credit_defined = true;
                        } else if (credit.tiers != null && credit.tiers.any()) {
                            let total = 0;
                            if (credit.pricing_model == 'tiered') {
                                // Graduated: each tier prices its own slice of v
                                let remaining = v;
                                let prev_up_to = 0;
                                ^tiers_loop for (const tier: PriceTier in credit.tiers) {
                                    if (remaining <= 0) break ^tiers_loop;
                                    if (tier.up_to != null) {
                                        const band = tier.up_to - prev_up_to;
                                        prev_up_to = tier.up_to;
                                        const slice = remaining >= band ? band : remaining;
                                        total += slice * tier.price.amount;
                                        remaining -= slice;
                                    } else {
                                        total += remaining * tier.price.amount;
                                        remaining = 0;
                                    }
                                }
                            } else if (credit.pricing_model == 'volume') {
                                // Volume: find the tier v falls into, price ALL of v at that rate
                                ^vol_loop for (const tier: PriceTier in credit.tiers) {
                                    if (tier.up_to != null && v > tier.up_to) {
                                        continue ^vol_loop;
                                    }
                                    total = v * tier.price.amount;
                                    break ^vol_loop;
                                }
                            } else if (credit.pricing_model == 'stairstep') {
                                // Stairstep: find the tier v falls into, pay that tier's flat fee
                                ^step_loop for (const tier: PriceTier in credit.tiers) {
                                    if (tier.up_to != null && v > tier.up_to) {
                                        continue ^step_loop;
                                    }
                                    total = tier.price.amount;
                                    break ^step_loop;
                                }
                            }
                            v = total;
                            c = 'rune';
                            credit_defined = true;
                        }
                    }
                }
                if (!credit_defined) return null; // no-can-do
            }
            if (!credit_defined) {
                v *= def.value;
                c = def.currency;
            }
        }
        v
    }


    /**
     * Exchange one currency for another.
     */
    fn exchange(value: float!, in_currency: str!, out_currency: str!) -> float {
        value = value.remove_units();
        if (in_currency == out_currency) return value;
        const val_runes = self.to_runes(value, in_currency);
        const exc_runes = self.to_runes(1, out_currency);
        (val_runes != null && exc_runes != null && exc_runes > 0) ? val_runes / exc_runes : null
    }
}
