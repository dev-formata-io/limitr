#[type]
/**
 * A Limitr subject.
 * Could be a user, organization, etc.
 */
Subject: {
    /// How to identify this subject.
    /// For a user, this could be an email, etc.
    /// This Id is used for metering, etc.
    str! id: '';

    /// Plan ID for this subject.
    str! plan: '';

    /// Alternate IDs for this subject.
    /// Use State API.
    list! alt_ids: [];

    /// An optional type of this subject.
    /// Ex. user, organization, seat, etc.
    str! type: 'user';

    /// Human-facing label for this subject.
    str! label: 'User';

    /// Meters for this subject.
    /// These map to entitlements by name for a plan.
    /// Lazily populated.
    obj! meters: {};


    #[run]
    /**
     * Run this subject.
     * Adds and moves subject to the GlobalState.
     */
    fn add_to_global_state() {
        const state = <State>.global();
        self.move(state.subjects);
        state.subjects.insert(self.id, self);
        
        const alts = copy(self.alt_ids);
        for (const id in alts) {
            state.set_alt_subject_id(self.id, id);
        }
    }
}
