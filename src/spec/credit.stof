#[type]
/**
 * A Limitr credit (abstract currency).
 * Could be a seat, token, etc.
 */
Credit: {
    /// Unit (singular).
    str! unit: 'credit';

    /// Optional description.
    str description: '';

    /// Human-facing label for this credit.
    str! label: 'Credit';


    #[schema((target: obj, target_val: float): bool => {
        target_val >= 0 ? true : LimitrValidation.error(`Credit "${target.label}" has a negative exchange/overhead cost`)
    })]
    /// Exchange rate (per credit).
    /// Typically a raw cost/overhead for a single credit.
    float exchange: 0;


    #[schema((target_val: obj): bool => <Price>.schemafy(target_val))]
    #[schema_optional]
    /// Optional price for this credit (what you charge per credit).
    Price price: null;


    #[schema((target: obj, target_val: str): bool => {
        LimitrValidation.valid_units(target_val) ? true : LimitrValidation.error(`Credit "${target.label}" has invalid stof_units "${target_val}"`)
    })]
    /// Stof units for this credit (ex. 'GB', 'MiB', 'meters', 'kg', etc.).
    /// Anytime this credit is used in metering, these units will be kept for that meter.
    /// Default is 'float', which will not perform casts on values.
    /// Entitlement limit values do not get cast automatically, so set to the units you'd like.
    str! stof_units: 'float';
}
