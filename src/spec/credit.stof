#[type]
/**
 * A Limitr credit (abstract currency).
 * Could be a seat, token, etc.
 */
Credit: {
    /// Unit (singular).
    str! unit: 'credit';

    /// Optional description.
    str description: '';

    /// Human-facing label for this credit.
    str! label: 'Credit';

    /// Is this credit overage only (true)?
    /// If false, treat overage as an indefinite quantity.
    bool resets: false;


    #[schema((target: obj, target_val: float): bool => {
        target_val >= 0 ? true : <LimitrValidation>.error(`Credit "${target.label}" cannot have a negative overhead cost`)
    })]
    /// Single credit cost as provider overhead when redeemed (in runes, see Limitr.exchange).
    float overhead_cost: 0;


    #[schema((target_val: str!): bool => {
        ['flat', 'tiered', 'volume', 'stairstep'].contains(target_val) ? true : <LimitrValidation>.error(`'${target_val}' is not a valid credit pricing model - must be 'flat', 'tiered', 'volume', or 'stairstep'`)
    })]
    /// Pricing model: 'flat', 'tiered', 'volume', or 'stairstep'.
    /// Flat - a single price per unit, applied uniformly regardless of how much is consumed.
    /// Tiered - like tax brackets, each band of consumption has its own per-unit price, and you pay each band's rate only for the units consumed within that band.
    /// Volume - your total consumption determines a single per-unit rate, applied retroactively to all units consumed.
    /// Stairstep - a flat fee per band, where your total consumption determines which band you're in and you pay that band's fixed price regardless of where within the band you land.
    str! pricing_model: 'flat';


    #[schema(<LimitrValidation>.valid_tiers)]
    /// Tiers for tiered, volume, or stairstep pricing models.
    list tiers: null;


    #[schema((target: obj, target_val: obj): bool => {
        const model = target.pricing_model ?? 'flat';
        if (model != 'flat') return target_val == null ? true : <LimitrValidation>.error(`A '${model}' credit pricing model requires 'price' to be null and a 'tiers' list of prices`);
        target_val == null ? true : <Price>.schemafy(target_val)
    })]
    /// Optional price for this credit (what you charge per credit).
    Price price: null;


    #[schema((target: obj, target_val: str): bool => {
        <LimitrValidation>.valid_units(target_val) ? true : <LimitrValidation>.error(`Credit "${target.label}" has invalid units "${target_val}"`)
    })]
    /// Stof units for this credit (ex. 'GB', 'MiB', 'meters', 'kg', etc.).
    /// Anytime this credit is used in metering, these units will be kept for that meter.
    /// Default is 'float', which will not perform casts on values.
    /// Entitlement limit values do not get cast automatically, so set to the units you'd like.
    str! stof_units: 'float';


    /*****************************************************************************
     * Pricing.
     *
     * Tiers are defined over billable units - the units past whatever a plan
     * includes. A "position" is where a quantity starts on that curve: 0 is the
     * first billable unit, negative positions are still inside the included
     * amount. Included units are priced linearly at the first tier's unit rate
     * (tiered/volume) or free (stairstep), so a cap counting raw consumption
     * still sees them.
     *
     * Every place that turns credits into runes (Exchange, caps, grants, margin
     * breakdowns) goes through these functions.
     *****************************************************************************/

    #[no-export]
    #[type_ignore]
    /// Prototype-only constant (not copied onto instances) - reference as <Credit>.UNBOUNDED_QUANTITY.
    /// "Unlimited" quantity for quantity_for (e.g. a stairstep top band, where the fee covers
    /// every further unit). A large finite number rather than inf, which isn't JSON-safe.
    const float UNBOUNDED_QUANTITY: 1e15;


    /// Does this credit have a price (flat price or pricing tiers)?
    fn priced() -> bool {
        if (self.pricing_model == 'flat') return self.price != null;
        self.tiers != null && self.tiers.any()
    }


    /**
     * Runes for a cumulative billable quantity `n` (total from position 0 up to n).
     * Returns null if this credit has no price.
     * Assumes tiers are sorted (valid() sorts & validates them).
     */
    fn total_price(n: float) -> float {
        n = n.remove_units();
        if (self.pricing_model == 'flat') return self.price != null ? n * self.price.amount : null;
        if (self.tiers == null || self.tiers.empty()) return null;

        const model = self.pricing_model;
        if (n <= 0) return model == 'stairstep' ? 0 : n * self.tiers.front().price.amount;

        if (model == 'tiered') {
            // Graduated: each band's units at that band's rate
            let total = 0;
            let prev = 0;
            for (const tier: PriceTier in self.tiers) {
                if (tier.up_to == null || n <= tier.up_to) return total + (n - prev) * tier.price.amount;
                total += (tier.up_to - prev) * tier.price.amount;
                prev = tier.up_to;
            }
            return total;
        }

        // Volume & stairstep: the band n falls into decides the price
        const tier: PriceTier = self.band(n);
        model == 'volume' ? n * tier.price.amount : tier.price.amount
    }


    /// Tier containing billable quantity n (n > 0), bands are (previous up_to, up_to].
    fn band(n: float) -> PriceTier {
        for (const tier: PriceTier in self.tiers) {
            if (tier.up_to == null || n <= tier.up_to) return tier;
        }
        self.tiers.back()
    }


    /**
     * Runes for `quantity` units starting at billable position `offset`.
     * Marginal: total_price(offset + quantity) - total_price(offset).
     * Negative quantities are refunds at the same position (decrements).
     * Note: for volume pricing, crossing into a cheaper band can make this negative.
     */
    fn price_of(quantity: float, offset: float = 0) -> float {
        quantity = quantity.remove_units();
        offset = offset.remove_units();
        if (!self.priced()) return null;
        if (self.pricing_model == 'flat') return quantity * self.price.amount;
        if (self.pricing_model == 'tiered') {
            // walk the bands directly (exact slices, no large-total subtraction)
            if (quantity < 0) {
                // locals on purpose: Stof binds earlier params before evaluating later args,
                // so `self.price_of(-quantity, offset + quantity)` would see the new quantity
                const refund_qty = 0 - quantity;
                const refund_from = offset + quantity;
                return 0 - self.price_of(refund_qty, refund_from);
            }
            let total = 0;
            let cur = offset;
            const end = offset + quantity;
            if (cur < 0) {
                const included = min(end, 0) - cur;
                total += included * self.tiers.front().price.amount;
                cur = min(end, 0);
            }
            let prev = 0;
            for (const tier: PriceTier in self.tiers) {
                if (cur >= end) break;
                const top = tier.up_to;
                if (top == null || cur < top) {
                    const slice_end = top == null ? end : min(end, top);
                    total += (slice_end - max(cur, prev)) * tier.price.amount;
                    cur = slice_end;
                }
                if (top != null) prev = top;
            }
            return total;
        }
        // volume & stairstep price on the total, so the marginal is a difference of totals
        self.total_price(offset + quantity) - self.total_price(offset)
    }


    /**
     * Inverse of price_of: how many units `runes` buys starting at billable position `offset`.
     * Walks forward band by band, stopping where the budget runs out (a band whose entry
     * cost can't be afforded is not entered). Returns null if this credit has no price, and
     * UNBOUNDED_QUANTITY when the budget reaches a band with no per-unit price and no upper
     * bound (stairstep top band) - every further unit is already paid for.
     * Negative runes are converted linearly at the first unit rate.
     */
    fn quantity_for(runes: float, offset: float = 0) -> float {
        runes = runes.remove_units();
        offset = offset.remove_units();
        if (!self.priced()) return null;
        if (self.pricing_model == 'flat') return self.price.amount > 0 ? runes / self.price.amount : null;
        if (runes == 0) return 0;

        const model = self.pricing_model;
        if (runes < 0) {
            const rate = self.tiers.front().price.amount;
            return model != 'stairstep' && rate > 0 ? runes / rate : null;
        }

        let cur = offset;
        let spent = 0;
        loop {
            // next breakpoint above cur: 0 (end of included units), then each tier's up_to
            let next = null;
            if (cur < 0) {
                next = 0;
            } else {
                for (const tier: PriceTier in self.tiers) {
                    if (tier.up_to != null && tier.up_to > cur) { next = tier.up_to; break; }
                }
            }

            // cost structure of the segment (cur, next]: entry jump + unit slope
            let slope = 0;
            let entry = 0;
            if (cur < 0) {
                slope = model == 'stairstep' ? 0 : self.tiers.front().price.amount;
            } else {
                const tier: PriceTier = self.band(next ?? (cur + 1));
                if (model == 'tiered') {
                    slope = tier.price.amount;
                } else if (model == 'volume') {
                    slope = tier.price.amount;
                    entry = cur * tier.price.amount - self.total_price(cur); // reprice everything so far
                } else {
                    entry = tier.price.amount - self.total_price(cur); // pay this band's flat fee
                }
            }

            if (spent + entry > runes) return cur - offset; // can't afford to enter this band
            spent += entry;

            if (slope > 0) {
                const reach = cur + (runes - spent) / slope;
                if (next == null || reach <= next) return reach - offset;
                spent += (next - cur) * slope;
            } else if (next == null) {
                // unlimited units for a fixed fee (stairstep top band, or a free last tier)
                // Finite on purpose: inf panics Stof's JSON export (events, customer-set), see UNBOUNDED_QUANTITY.
                // TODO(stof runtime): make JSON export of inf/NaN safe, then revisit using real infinity.
                return <Credit>.UNBOUNDED_QUANTITY;
            }
            cur = next;
        }
        null
    }
}
