#[type]
/**
 * A Limitr Top-up.
 * Purchasable credit package.
 */
Topup: {
    #[schema(<LimitrValidation>.valid_credit_id)]
    /// Credit ID.
    str! credit: '';

    #[schema(<LimitrValidation>.valid_topup_number)]
    /// How much credit is granted?
    float | str value: 0;

    #[schema((target_val: obj): bool => <Price>.schemafy(target_val))]
    #[schema_optional]
    /// What does this topup cost?
    Price price: null;

    /// Does this topup reset?
    bool resets: false;

    #[schema((target_val: float): bool => target_val > 0 ? true : <LimitrValidation>.error(`Top-up reset increment value must be greater than zero`))]
    /// What is the reset increment?
    ms reset_inc: 30days;

    #[schema((target_val: float): bool => target_val > 0 ? true : <LimitrValidation>.error(`Top-up expiration value must be greater than zero`))]
    #[schema_optional]
    /// Expires N ms after purchase.
    ms expires_after: null;
}
