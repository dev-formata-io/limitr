#[type]
/**
 * Limitr events helpers.
 * Used by host apps, plugins, etc.
 */
Event: {
    #[static]
    /**
     * Send an event.
     * Key will be the attribute(s) of functions to call.
     *
     * Ex. <Event>.send('plan-added', plan);
     */
    async fn send(key: str | list | set, value: unknown = null) {
        let handles = [];
        for (const func in funcs(attributes = key)) {
            const count = func.params().len();
            if (count == 1) {
                if (func.is_async()) handles.push_back(func(value));
                else func(value);
            } else if (count < 1) {
                if (func.is_async()) handles.push_back(func());
                else func();
            }
        }
        await handles;
    }


    #[static]
    /**
     * Send a temp obj as a value.
     * Helper for deleting obj after.
     */
    async fn send_tmp(key: str | list | set, value: obj) {
        await <Event>.send(key, value);
        drop(value);
    }
}


/**
 * Call out to an external "App" library (added by user).
 */
AppEvents: {

    /*****************************************************************************
     * Plans.
     *****************************************************************************/
    
    #[plan-removed]
    /**
     * Called when a plan is being removed via Limitr.delete_plan.
     */
    fn app_plan_removed(value: Plan) {
        if (lib('App')) ?App.plan_removed(stringify('json', value));
    }


    #[plan-set]
    /**
     * Called when a plan has just been set via Limitr.set_plan.
     */
    fn app_set_plan(value: Plan) {
        if (lib('App')) ?App.plan_set(stringify('json', value));
    }


    /*****************************************************************************
     * Meters.
     *****************************************************************************/
    
    #[meter-changed]
    /**
     * Meter changed.
     * Called whenever a Meter is created/updated.
     * Value includes meter (old & new values), subject, entitlement key, plan, and credit.
     */
    fn app_meter_changed(value: obj) {
        if (lib('App')) ?App.meter_changed(stringify('json', value));
    }


    #[meter-limit]
    /**
     * Meter limited.
     * Called whenever a "meter" event fails because of a Limit set on an entitlement.
     */
    fn app_meter_limit(value: obj) {
        if (lib('App')) ?App.meter_limit(stringify('json', value));
    }


    /*****************************************************************************
     * Subjects.
     *****************************************************************************/
    
    #[subject-set]
    /**
     * Subject has been set/modified.
     */
    fn app_subject_set(subject: Subject) {
        if (lib('App')) ?App.subject_set(stringify('json', subject));
    }


    #[subject-removed]
    /**
     * Subject is being removed.
     * Called when <Limitr>.delete_subject is called.
     */
    fn app_subject_removing(subject: Subject) {
        if (lib('App')) ?App.subject_removing(stringify('json', subject));
    }
}
