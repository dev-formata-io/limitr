#[type]
/**
 * Limitr events helpers.
 * Used by host apps, plugins, etc.
 */
Event: {
    #[static]
    /**
     * Send an event.
     * Key will be the attribute(s) of functions to call.
     *
     * Ex. <Event>.send('plan-added', plan);
     */
    async fn send(key: str | list | set, value: unknown = null) {
        let handles = [];
        for (const func in funcs(attributes = key)) {
            const count = func.params().len();
            if (count == 1) {
                if (func.is_async()) handles.push_back(func(value));
                else func(value);
            } else if (count < 1) {
                if (func.is_async()) handles.push_back(func());
                else func();
            }
        }
        if (lib('App')) {
            const val = (typeof value) == 'obj' ? stringify('json', value) : value;
            if ((typeof key) == 'list' || (typeof key) == 'set') {
                for (const k in key) ?App.event_handler(key, val);
            } else {
                ?App.event_handler(key, val);
            }
        }
        await handles;
    }


    #[static]
    /**
     * Send a temp obj as a value.
     * Helper for deleting obj after.
     */
    async fn send_tmp(key: str | list | set, value: obj) {
        await <Event>.send(key, value);
        drop(value);
    }
}


/**
 * Call out to an external "App" library (added by user).
 */
AppEvents: {

    /*****************************************************************************
     * Plans.
     *****************************************************************************/
    
    #[plan-removed]
    /**
     * Called when a plan is being removed via Limitr.delete_plan.
     */
    fn app_plan_removed(value: Plan) {
        if (lib('App')) ?App.plan_removed(stringify('json', value));
    }


    #[plan-set]
    /**
     * Called when a plan has just been set via Limitr.set_plan.
     */
    fn app_set_plan(value: Plan) {
        if (lib('App')) ?App.plan_set(stringify('json', value));
    }


    /*****************************************************************************
     * Meters.
     *****************************************************************************/
    
    #[meter-changed]
    /**
     * Meter changed.
     * Called whenever a Meter is created/updated.
     * Value includes meter (old & new values), customer, entitlement key, plan, and credit.
     */
    fn app_meter_changed(value: obj) {
        if (lib('App')) ?App.meter_changed(stringify('json', value));
    }


    #[meter-overage]
    /**
     * Meter overage.
     * Called when a Limit mode is "soft" and the meter value is over the limit.
     * Equal to #[meter-changed], but only fires when the new value is over the defined limit.
     */
    fn app_meter_overage(value: obj) {
        if (lib('App')) ?App.meter_overage(stringify('json', value));
    }


    #[meter-limit]
    /**
     * Meter limited.
     * Called whenever a "meter" event fails because of a Limit set on an entitlement.
     */
    fn app_meter_limit(value: obj) {
        if (lib('App')) ?App.meter_limit(stringify('json', value));
    }


    #[meter-governed]
    /**
     * Meter governed.
     * Called when a governor rate limit is hit before the hard limit.
     * Value includes meter state, customer, entitlement, plan, credit, and governor details.
     */
    fn app_meter_governed(value: obj) {
        if (lib('App')) ?App.meter_governed(stringify('json', value));
    }


    /*****************************************************************************
     * Customers.
     *****************************************************************************/
    
    #[customer-set]
    /**
     * Customer has been set/modified.
     */
    fn app_customer_set(customer: Customer) {
        if (lib('App')) ?App.customer_set(stringify('json', customer));
    }


    #[customer-removed]
    /**
     * Customer is being removed.
     * Called when <Limitr>.delete_customer is called.
     */
    fn app_customer_removing(customer: Customer) {
        if (lib('App')) ?App.customer_removing(stringify('json', customer));
    }
}
