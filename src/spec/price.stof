#[type]
Price: {
    /// Optional ID of this price (to be interpreted by you).
    str id: null;

    #[schema((target: obj, target_val:float): bool => target_val >= 0 ? true : <LimitrValidation>.error(`Price cannot have a negative amount: ${target.label()}`))]
    /// The amount to charge, using Limitr runes (in runes, default 1 rune = 1 usd).
    float! amount: 0;

    /// Suffix for label & intervals.
    str! suffix: '/month';

    
    /**
     * Label for this price.
     */
    fn label() -> str {
        const amount = self.amount.round(2);
        const suf = self.suffix.len() > 0 ? ' ' + self.suffix : '';
        `${amount} runes ${suf}`
    }
}


#[type]
PriceTier: {
    /// Upper bound for this tier, exclusive (null = infinity, must be last tier).
    float up_to: null;

    #[schema((target_val: obj): bool => <Price>.schemafy(target_val))]
    /// Price for this tier.
    Price! price: {};
}
