#[type]
/**
 * Additional notification contracts.
 * Fields (Notifications) on this contract are fired by name/key.
 */
Notifications: {
    /// Notification event handler.
    async fn handle_event(type: str!, event: obj!) {
        let handles = [];
        for (const pair in self.fields()) {
            const note = pair[1];
            if ((typeof note) == 'obj') {
                note as Notification;
                if (note.matches(type, event)) {
                    let func = note.fire;
                    if ((typeof func) == 'fn') {
                        const count = func.params().len();
                        if (count == 2) {
                            if (func.is_async()) handles.push_back(func(pair[0], event));
                            else func(pair[0], event);
                        } else if (count == 1) {
                            if (func.is_async()) handles.push_back(func(event));
                            else func(event);
                        } else if (count == 0) {
                            if (func.is_async()) handles.push_back(func());
                            else func();
                        }
                    } else {
                        handles.push_back(<Event>.send(pair[0], event));
                    }
                }
            }
        }
        await handles;
    }
}


#[type]
/**
 * Notification observer.
 */
Notification: {
    /// Matches limitr event?
    /// Type is either 'meter-limit', 'meter-overage', or 'meter-changed'.
    fn matches(type: str, event: obj) -> bool {
        // OVERRIDE THIS
        false
    }
}
