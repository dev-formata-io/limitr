#[type]
/**
 * A Limitr plan.
 */
Plan: {
    #[schema((target_val: str): bool => target_val)]
    /// Name for this plan (populated automatically).
    /// This is a field name, so already deduplicated, must be truthy.
    str name: '';

    /// Human-facing label for this plan.
    str! label: '';

    #[schema((target_val: str): bool => ['yearly', 'monthly', 'weekly', 'daily'].contains(target_val) ? true : <LimitrValidation>.error(`Invalid plan period '${target_val}', must be one of 'yearly', 'monthly', 'weekly', 'daily'`))]
    /// Plan period ('yearly', 'monthly', 'weekly', 'daily').
    str! period: 'monthly';

    /// Plan subscription entitlement.
    /// Optionally used to charge for this plan automatically (trials, etc.).
    /// Use a soft limit of 0 if you want to charge for the first/only increment.
    str! subscription: 'subscription';

    #[schema(<LimitrValidation>.valid_plan_trial_period)]
    #[schema_optional]
    /// Optional trial period.
    float | str trial_period: null;

    #[schema(<LimitrValidation>.valid_plan_entitlements)]
    /// Entitlements that this plan contains.
    obj! entitlements: {};

    #[schema(<LimitrValidation>.valid_plan_topups)]
    /// Top-ups offered on this plan.
    obj! topups: {};

    /// Hidden plan?
    bool hidden: false;

    /// Is this the default plan?
    /// If no plan is provided on create customer, this one should be used.
    bool default: false;


    /// Period time in ms.
    fn period_time() -> ms {
        if (self.period.contains('year')) return 365days;
        if (self.period.contains('week')) return 7days;
        if (self.period.contains('day') || self.period.contains('daily')) return 1day;
        30days
    }
}
