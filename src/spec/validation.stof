#[type]
/**
 * LimitrValidation static helpers & output.
 */
LimitrValidation: {
    /// Most recent validation error message.
    str! error_message: '';


    #[static]
    /**
     * Set LimitrValidation error message.
     */
    fn error(message: str!) -> bool {
        self.error_message = message;
        false
    }


    #[static]
    /**
     * Get the policy from a child node.
     */
    fn get_policy(child: obj) -> Limitr {
        if (child.instance_of('Limitr')) return child;
        let parent = child.parent();
        loop {
            if (parent == null) break;
            if (parent.instance_of('Limitr')) return parent;
            parent = parent.parent();
        }
        null
    }


    #[static]
    /**
     * Is valid stof units?
     */
    fn valid_units(units: str!) -> bool {
        let res = false;
        try {
            (42).to_units(units);
            res = true;
        } catch {
            // nada..
        }
        res
    }


    #[static]
    /**
     * Validate plan entitlements.
     */
    fn valid_plan_entitlements(target_val: obj) -> bool {
        for (const pair in target_val.fields()) {
            const ent: Entitlement = pair[1];
            if (!<Entitlement>.schemafy(ent)) return false;
        }
        true
    }


    #[static]
    /**
     * Validate plan topups.
     */
    fn valid_plan_topups(target_val: obj) -> bool {
        for (const pair in target_val.fields()) {
            const top: Topup = pair[1];
            if (!<Topup>.schemafy(top)) return false;
        }
        true
    }


    #[static]
    /**
     * Valid plan trial period.
     */
    fn valid_plan_trial_period(target: Plan, target_val: float | str) -> bool {
        const ent_name = target.subscription ?? 'subscription';
        const ent = target.entitlements.get(ent_name);
        let res = ent != null;
        if (!res) {
            res = self.error(`Plan "${target.name}" has a trial period but no "${ent_name}" entitlement for it to delay (a trial delays the plan's subscription; add one, or remove trial_period)`);
        } else {
            try {
                const val = target_val as float;
                res = val >= 0;
                if (!res) self.error(`Plan trial period value must be positive`);
            } catch {
                res = self.error(`Cannot use "${target_val}" as a plan trial period - not a valid number/units`);
            }
        }
        res
    }


    #[static]
    /**
     * Valid reset schedule (`reset_sch`): 'period' (the customer's billing period) or a calendar schedule starting
     * with monthly, weekly, nth_weekday, yearly, semiannual, or quarterly.
     */
    fn valid_reset_sch(target: obj, target_val: str) -> bool {
        if (target_val == 'period') return true;
        for (const kind in ['monthly', 'weekly', 'nth_weekday', 'yearly', 'semiannual', 'quarterly']) {
            if (target_val.starts_with(kind)) return true;
        }
        self.error(`Invalid reset schedule '${target_val}' - must be 'period' or start with monthly, weekly, nth_weekday, yearly, semiannual, or quarterly`)
    }


    #[static]
    /**
     * Valid credit ID.
     */
    fn valid_credit_id(target: obj, target_val: str) -> bool {
        const policy = self.get_policy(target);
        if (policy == null) return false;
        policy.credit(target_val) != null ? true :
        self.error(`A credit named "${target_val}" does not exist in this policy`)
    }


    #[static]
    /**
     * Valid limit value.
     */
    fn valid_limit_number(target_val: float | str) -> bool {
        let res = true;
        try {
            target_val as float;
        } catch {
            res = self.error(`Cannot use "${target_val}" as a limit value - not a valid number/units`);
        }
        res
    }


    #[static]
    /**
     * Valid topup value.
     */
    fn valid_topup_number(target_val: float | str) -> bool {
        let res = true;
        try {
            const val = target_val as float;
            res = val >= 0;
            if (!res) self.error(`Top-up value must be positive - cannot allocate a negative credit grant`);
        } catch {
            res = self.error(`Cannot use "${target_val}" as a top-up value - not a valid number/units`);
        }
        res
    }


    #[static]
    /**
     * Does any plan in the policy define this entitlement? (Rules can't invent entitlements.)
     */
    fn any_plan_has(policy: Limitr, entitlement: str!) -> bool {
        if (policy == null) return true; // checked once the rule is in a policy
        for (const pair in policy.plans.fields()) {
            const plan: Plan = pair[1];
            if (plan.entitlements.get(entitlement) != null) return true;
        }
        false
    }


    #[static]
    /**
     * Validate a rule's gives: entitlement -> {} or { plan }, for entitlements a plan defines.
     */
    fn valid_rule_given(target: Rule, target_val: obj) -> bool {
        const policy = self.get_policy(target);
        for (const pair in target_val.fields()) {
            const ent = pair[0];
            const given = pair[1];
            if (typeof given != 'obj') return self.error(`Rule "${target.name}" gives "${ent}": a give is {} or { plan: '<plan>' }`);
            if (given.plan != null) {
                const plan: Plan = policy?.plans.get(given.plan);
                if (policy != null && plan?.entitlements.get(ent) == null) return self.error(`Rule "${target.name}" gives "${ent}" from plan "${given.plan}", which doesn't define it`);
            } else if (!self.any_plan_has(policy, ent)) {
                return self.error(`Rule "${target.name}" gives "${ent}", which no plan defines (rules can't invent entitlements)`);
            }
            if (given.expires_on != null) return self.error(`Rule "${target.name}" gives "${ent}" with expires_on: a rule has no dates (whoever assigns it decides when)`);
        }
        true
    }


    #[static]
    /**
     * Validate a rule's takes: entitlement -> {}, for entitlements a plan defines.
     */
    fn valid_rule_taken(target: Rule, target_val: obj) -> bool {
        const policy = self.get_policy(target);
        for (const pair in target_val.fields()) {
            const ent = pair[0];
            if (typeof pair[1] != 'obj') return self.error(`Rule "${target.name}" takes "${ent}": a take is {}`);
            if (!self.any_plan_has(policy, ent)) return self.error(`Rule "${target.name}" takes "${ent}", which no plan defines`);
            if (pair[1].expires_on != null) return self.error(`Rule "${target.name}" takes "${ent}" with expires_on: a rule has no dates (whoever assigns it decides when)`);
        }
        true
    }


    #[static]
    /**
     * Validate a rule's limit overrides: entitlement -> Limit, for entitlements a plan defines.
     */
    fn valid_rule_overrides(target: Rule, target_val: obj) -> bool {
        const policy = self.get_policy(target);
        for (const pair in target_val.fields()) {
            const ent = pair[0];
            const limit: Limit = pair[1];
            if (!self.any_plan_has(policy, ent)) return self.error(`Rule "${target.name}" overrides the limit of "${ent}", which no plan defines`);
            if (!<Limit>.schemafy(limit)) return self.error_message != '' ? false : self.error(`Rule "${target.name}" has an invalid limit for "${ent}"`);
            if (limit.override_expires_on != null) return self.error(`Rule "${target.name}" limit for "${ent}" has override_expires_on: a rule has no dates (whoever assigns it decides when)`);
        }
        true
    }


    #[static]
    /**
     * Validate a rule's caps: name -> Cap, in a credit the policy knows (or rune).
     */
    fn valid_rule_caps(target: Rule, target_val: obj) -> bool {
        const policy = self.get_policy(target);
        for (const pair in target_val.fields()) {
            const name = pair[0];
            const cap: Cap = pair[1];
            if (!<Cap>.schemafy(cap)) return self.error_message != '' ? false : self.error(`Rule "${target.name}" has an invalid cap "${name}"`);
            if (policy != null && cap.credit != 'rune' && policy.credit(cap.credit) == null && ?policy.exchange.get_pair(cap.credit) == null) {
                return self.error(`Rule "${target.name}" cap "${name}" is in "${cap.credit}", which isn't a credit or exchange pair in this policy`);
            }
            if (cap.expires_on != null) return self.error(`Rule "${target.name}" cap "${name}" has expires_on: a rule has no dates (whoever assigns it decides when)`);
        }
        true
    }


    #[static]
    /**
     * Validate credit tiers.
     */
    fn valid_tiers(target: obj, field: str, target_val: list) -> bool {
        const model = target.pricing_model ?? 'flat';
        if (model == 'flat') return true; // tiers can be null here

        if (target_val == null || target_val.empty()) return <LimitrValidation>.error(`A '${model}' credit pricing model requires a list of pricing tiers ('tiers' field)`);
        for (const val in target_val) if (typeof val != 'obj') return <LimitrValidation>.error("Each value within a credit's 'tiers' list must be a PriceTier object");

        const sorted = self.quicksort_tiers(target_val);
        while (sorted.back().up_to == null && sorted.len() - 2 >= 0 && sorted[sorted.len() - 2].up_to == null) {
            const p = sorted.pop_back();
            if (typeof p == 'obj') drop(p);
        }
        target.insert(field, sorted);
        if (sorted.back().up_to != null) return <LimitrValidation>.error(`A '${model}' credit pricing model requires the last tier in 'tiers' to be up_to null (infinity)`);
        for (const tier: PriceTier in sorted) if (!<PriceTier>.schemafy(tier)) return false;
        true
    }


    #[static]
    /**
     * Sort tiers.
     */
    fn quicksort_tiers(tiers: list) -> list {
        if (tiers.len() <= 1) return tiers;
        
        const pivot = tiers[tiers.len() / 2];
        const left = [];
        const mid = [];
        const right = [];
        
        for (const tier in tiers) {
            const tier_up_to = tier.up_to;
            const pivot_up_to = pivot.up_to;
            if (tier_up_to == pivot_up_to) {
                mid.push_back(tier);
            } else if (tier_up_to == null) {
                right.push_back(tier); // null = infinity, always last
            } else if (pivot_up_to == null || tier_up_to < pivot_up_to) {
                left.push_back(tier);
            } else {
                right.push_back(tier);
            }
        }
        
        const sorted = self.quicksort_tiers(left);
        for (const t in mid) sorted.push_back(t);
        for (const t in self.quicksort_tiers(right)) sorted.push_back(t);
        sorted
    }
}
