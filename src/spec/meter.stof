#[type]
/**
 * A Limitr meter.
 */
Meter: {
    /// Credit ID.
    str! credit: '';

    /// This meter value started counting on this timestamp.
    ms started: null;

    /// Value of this meter (in credit's units).
    float value: 0;

    /// Provider overhead spent this period (in runes): the sum of each call's actual overhead.
    /// Null on meters from before 0.7.0 (readers fall back to value * the credit's overhead_cost).
    float overhead: null;

    /// Room held by in-flight calls (Limitr.reserve()): hold ID -> map of value, overhead, expires, basis, segment.
    /// Counts against limits and caps for every other call until settled, released, or expired. Never metered.
    map holds: null;

    /// This customer's usage estimates for the entitlement, by segment ('all' when none). See Estimate.
    obj estimates: null;

    /// Rate tracking ring buffer (max 3 entries, oldest first).
    /// Each entry: { ts: ms, delta: float }
    list! history: [];

    /// EWMA smoothed rate.
    float ewma_rate: null;


    /**
     * Room held by unexpired reservations, as (value, overhead).
     * `prune` drops expired holds (reads pass false so they never change the meter).
     */
    fn held(prune: bool = false) -> (float, float) {
        if (self.holds == null || self.holds.len() < 1) return (0, 0);
        const now = Time::now();
        let value = 0.0;
        let overhead = 0.0;
        const expired = [];
        for (const pair in self.holds) {
            const hold: map = pair[1];
            const expires = hold.get('expires');
            if (expires != null && expires <= now) {
                expired.push_back(pair[0]);
                continue;
            }
            const held = hold.get('value') ?? 0;
            if (held <= 0) continue; // only usage is held
            value += held;
            overhead += hold.get('overhead') ?? 0;
        }
        if (prune) for (const id in expired) self.holds.remove(id);
        (value, overhead)
    }


    /**
     * Push a delta into the history ring buffer.
     */
    fn push_history(delta: float, alpha: float = 0.2) {
        if (self.history.len() >= 3) {
            drop(self.history.pop_front()); // remove from array and doc
        }
        self.history.push_back(new { ts: Time::now(), delta });
        const r = self.rate();
        self.ewma_rate = self.ewma_rate == null ? r : (alpha * r) + ((1 - alpha) * self.ewma_rate);
    }


    /**
     * Discrete derivative: consumption per ms.
     * Returns 0 if fewer than 2 entries.
     */
    fn rate() -> float {
        const len = self.history.len();
        if (len < 2) return 0;
        const a = self.history[len - 2];
        const b = self.history[len - 1];
        const dt = (b.ts - a.ts).remove_units();
        dt <= 0 ? 0 : b.delta / dt
    }


    /**
     * Rate of change between the two most recent intervals.
     * Returns 0 if fewer than 3 entries.
     */
    fn acceleration() -> float {
        if (self.history.len() < 3) return 0;
        const a = self.history[0];
        const b = self.history[1];
        const c = self.history[2];
        const dt1 = (b.ts - a.ts).remove_units();
        const dt2 = (c.ts - b.ts).remove_units();
        if (dt1 <= 0 || dt2 <= 0) return 0;
        (b.delta / dt2) - (a.delta / dt1)
    }


    /**
     * Estimated ms until this meter reaches a given limit at current rate.
     * Returns null if rate is zero or negative.
     */
    fn projected_exhaustion(limit: float, smoothed: bool = false) -> ms {
        const r = smoothed && self.ewma_rate != null ? self.ewma_rate : self.rate();
        if (r <= 0) return null;
        const rem = limit - self.value;
        if (rem <= 0) return null;
        (rem / r).remove_units()
    }


    /**
     * Governor tokens available right now, without changing any state.
     * Uninitialized governor state (fresh meter) means a full bucket.
     * Used by check() so it agrees with allow() without consuming or refilling.
     */
    fn governor_available(capacity: float, refill_rate: float) -> float {
        if (self.governor_tokens == null || self.governor_last_refill == null) return capacity;
        const elapsed = (Time::now() - self.governor_last_refill).remove_units();
        if (elapsed <= 0 || refill_rate == null) return min(capacity, self.governor_tokens);
        min(capacity, self.governor_tokens + (elapsed * refill_rate))
    }


    /**
     * Refill governor tokens based on elapsed time since last refill.
     * No-op if governor fields not present on this meter.
     */
    fn refill_governor(capacity: float, refill_rate: float) {
        if (self.governor_last_refill == null) return;
        const now = Time::now();
        const elapsed = (now - self.governor_last_refill).remove_units();
        if (elapsed <= 0) return;
        self.governor_tokens = min(
            capacity,
            (self.governor_tokens ?? 0) + (elapsed * refill_rate)
        );
        self.governor_last_refill = now;
    }
}
