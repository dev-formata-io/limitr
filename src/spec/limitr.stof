#[type]
/**
 * A Limitr object.
 */
Limitr: {
    /// Credits.
    obj credits: {};

    /// Available plan definitions by ID.
    obj plans: {};

    /// Subjects by ID.
    obj subjects: {};

    /// Alternative subject ID mappings.
    obj alt_subject_ids: {};


    #[no-export]
    /**
     * Static API.
     * <Limitr>.api.get();
     */
    api: {
        /// Get the top-level policy.
        /// Named root.policy.
        /// Or, any Limitr object on the root or obj with #[limitr].
        fn get() -> Limitr {
            const top = root.policy;
            if ((typeof top) == 'obj') return top;

            for (const pair in root.fields()) {
                if ((typeof pair[1]) == 'obj') {
                    if (pair[1].instance_of('Limitr') || root.attributes(pair[0]).contains('limitr')) {
                        return pair[1];
                    }
                }
            }
            null
        }

        
        /*****************************************************************************
         * Plans.
         *****************************************************************************/
        
        /// Plan from ID (subject ID or plan ID).
        fn plan(id: str!) -> Plan {
            ?self.get().plan(id)
        }

        /// Delete a plan by plan ID.
        /// Be careful, as subjects that have this plan will no longer work as expected.
        fn delete_plan(id: str!) -> bool {
            ?self.get().delete_plan(id)
        }

        /// Set/create a plan with a name & internal Stof.
        fn set_plan(id: str!, internal_stof: str!) -> Plan {
            ?self.get().set_plan(id, internal_stof)
        }


        /*****************************************************************************
         * Entitlements.
         *****************************************************************************/
        
        /// Get a plan entitlement from a subject or plan ID.
        fn entitlement(id: str!, entitlement: str!) -> Entitlement {
            ?self.get().entitlement(id, entitlement)
        }

        /// Get the limit value for an entitlement.
        fn limit(id: str!, entitlement: str!) -> float {
            ?self.get().limit(id, entitlement)
        }

        /// Get the remaining balance value for a subject ID (limit - current (metered) value).
        fn balance(id: str!, entitlement: str!) -> float {
            ?self.get().balance(id, entitlement)
        }

        /// Get the current value of a mtered entitlement for a subject ID.
        fn value(id: str!, entitlement: str!) -> float {
            ?self.get().value(id, entitlement)
        }

        /// Get the standard increment "cost" of an "increment" operation.
        fn cost(id: str!, entitlement: str!) -> float {
            ?self.get().cost(id, entitlement)
        }

        /// Change the value of a metered entitlement by a stardard increment.
        fn increment(id: str!, entitlement: str!) -> bool {
            ?self.get().increment(id, entitlement)
        }

        /// Change the vlaue of a metered entitlement by removing a standard increment.
        fn deincrement(id: str!, entitlement: str!) -> bool {
            ?self.get().deincrement(id, entitlement)
        }

        /// Change the value of an entitlement meter for a subject.
        fn meter(id: str!, entitlement: str!, value: float = 0) -> bool {
            ?self.get().meter(id, entitlement, value)
        }

        /// Perform an entitlement check for a subject by ID.
        fn check(id: str!, entitlement: str!, value: float = 0) -> bool {
            ?self.get().check(id, entitlement, value)
        }


        /*****************************************************************************
         * Credits.
         *****************************************************************************/
        
        /// Get a credit by ID/type.
        fn credit(id: str!) -> Credit {
            ?self.get().credit(id)
        }

        /// Get a credit type for a specific entitlement (limited/metered).
        /// ID can be a plan ID or a subject ID.
        fn credit_for(id: str!, entitlement: str!) -> Credit {
            ?self.get().credit_for(id, entitlement)
        }


        /*****************************************************************************
         * Subjects.
         *****************************************************************************/
        
        /// Get a subject by ID.
        fn subject(id: str!) -> Subject {
            ?self.get().subject(id)
        }

        /// Change a subject's plan ID.
        fn set_subject_plan(id: str!, plan: str!) -> bool {
            ?self.get().set_subject_plan(id, plan)
        }

        /// Create a new subject.
        fn create_subject(id: str!, plan: str!, type: str! = 'user', label: str! = 'User', org?: str, alts?: list) -> Subject {
            ?self.get().create_subject(id, plan, type, label, org, alts)
        }

        /// Set/create a subject with an id & internal Stof.
        fn set_subject(id: str!, internal_stof: str!) -> Subject {
            ?self.get().set_subject(id, internal_stof)
        }

        /// Delete a subject.
        fn delete_subject(id: str!) -> bool {
            ?self.get().delete_subject(id)
        }

        /// Set an alternative subject ID (must be unique).
        fn set_alt_subject_id(id: str!, alt: str!) -> bool {
            ?self.get().set_alt_subject_id(id, alt)
        }

        /// Delete an alternative subject ID.
        fn delete_alt_subject_id(alt: str!) -> bool {
            ?self.get().delete_alt_subject_id(alt)
        }
    }


    /*****************************************************************************
     * Plans.
     *****************************************************************************/
    
    /**
     * Get a plan by ID (either a plan ID or a subject ID).
     */
    fn plan(id: str!) -> Plan {
        self.plans.get(id) ?? self.plan_for(id)
    }


    /**
     * Get a plan by subject ID.
     */
    fn plan_for(subject_id: str!) -> Plan {
        const subject = self.subject(subject_id);
        if (subject != null) {
            let pn = self.plans.get(subject.plan);
            if (pn == null && subject.org != null) pn = self.plan_for(subject.org);
            return pn;
        }
        null
    }


    /**
     * Delete a plan by plan ID.
     * Be careful, as subjects that have this plan will no longer work as expected.
     */
    fn delete_plan(id: str!) -> bool {
        const plan = self.plans.get(id);
        if (plan != null) {
            await <Event>.send('plan-removed', plan);
        }
        self.plans.remove(id, shallow = false)
    }


    /**
     * Set/create a plan with a name & internal Stof.
     */
    fn set_plan(id: str!, internal_stof: str!) -> Plan {
        self.delete_plan(id);
        const plan = new {} on self.plans;
        try parse(internal_stof, plan, 'stof');
        catch {
            drop(plan);
            return null;
        }
        self.plans.insert(id, plan);
        await <Event>.send('plan-set', plan as Plan);
        plan
    }


    /*****************************************************************************
     * Entitlements.
     *****************************************************************************/
    
    /**
     * Get a plan entitlement from either a subject ID or plan ID.
     */
    fn entitlement(id: str!, entitlement: str!) -> Entitlement {
        const pn: Plan = self.plan(id);
        if (pn != null) {
            return pn.entitlements.get(entitlement);
        }
        null
    }


    /**
     * Get the limit value for an entitlement.
     * Returns a value in the units of the meter (credit) (not always the same as defined limit units).
     * Ex. limit.value = 2GB, but credit.stof_units = 'MB', limit(..) => MB
     */
    fn limit(id: str!, entitlement: str!) -> float {
        const ent = self.entitlement(id, entitlement);
        if (ent != null && ent.limit != null && ent.limit.mode != 'observe') {
            const credit = self.credit(ent.limit.credit);
            const stof_units = credit != null ? credit.stof_units : 'float';
            return ent.limit.value.to_units(stof_units);
        }
        null
    }


    /**
     * Get the remaining entitlement balance value for a subject ID (limit - current (metered) value).
     * Returns a value in the units of the meter (not always the same as defined limit units).
     */
    fn balance(id: str!, entitlement: str!) -> float {
        const subject = self.subject(id);
        if (subject != null) {
            const ent = self.entitlement(id, entitlement);
            if (ent != null && ent.limit != null && ent.limit.mode != 'observe') {
                const credit = self.credit(ent.limit.credit);
                const stof_units = credit != null ? credit.stof_units : 'float';

                const meter: Meter = subject.meters.get(entitlement);
                if (meter != null) return (ent.limit.value - meter.value).to_units(stof_units);
                return ent.limit.value.to_units(stof_units);
            }
        }
        null
    }


    /**
     * Get the current value of a metered entitlement for a subject ID.
     * Returns null if the entitlement doesn't exist.
     */
    fn value(id: str!, entitlement: str!) -> float {
        const subject = self.subject(id);
        if (subject != null) {
            const meter: Meter = subject.meters.get(entitlement);
            if (meter != null) {
                return meter.value;
            } else if (self.entitlement(id, entitlement) != null) {
                return 0;
            }
        }
        null
    }


    /**
     * Get the standard increment "cost" of an "increment" operation for an entitlement.
     * Will return null if the entitlement doesn't exist.
     */
    fn cost(id: str!, entitlement: str!) -> float {
        const ent = self.entitlement(id, entitlement);
        if (ent != null && ent.limit != null) return ent.limit.increment;
        null
    }


    /**
     * Change the value of a metered entitlement by a standard increment (defined in the Limit).
     */
    fn increment(id: str!, entitlement: str!) -> bool {
        const ent = self.entitlement(id, entitlement);
        if (ent != null && ent.limit != null) {
            return self.meter(id, entitlement, ent.limit.increment);
        }
        false
    }


    /**
     * Change the value of a metered entitlement by removing a standard increment (defined in the limit).
     */
    fn deincrement(id: str!, enforcement: str!) -> bool {
        const ent = self.entitlement(id, entitlement);
        if (ent != null && ent.limit != null) {
            return self.meter(id, entitlement, ent.limit.increment * -1);
        }
        false
    }


    /**
     * Change the value of an entitlement meter for a subject.
     * Be default, any limit enforcements will take effect.
     * Returns true if the subject has access with the requested value.
     *
     * This may be the only function you need to use in your codebase.
     */
    fn meter(id: str!, entitlement: str!, value: float = 0) -> bool {
        const subject = self.subject(id);
        if (subject != null) {
            const plan = self.plan_for(id);
            if (plan != null) {
                const ent: Entitlement = plan.entitlements.get(entitlement);
                if (ent != null) {
                    let existing_meter: Meter = subject.meters.get(entitlement);
                    let new_value: float = existing_meter != null ? existing_meter.value + value : value;

                    // check if the new value should be reset!
                    if (existing_meter != null && existing_meter.reset != null && ent.limit != null && ent.limit.resets && Time.now() > existing_meter.reset) {
                        const now = Time.now();
                        while (now > existing_meter.reset) existing_meter.reset += ent.limit.reset_inc;
                        new_value = value;
                    }

                    let res = ent.check(new_value); // ok if new_value has different, but compatable units here...

                    // create/change meter if there is a limit defined
                    // if not a valid value and mode is "soft", emit overage and allow
                    if (ent.limit != null && (res || ent.limit.mode == 'soft')) {
                        if (existing_meter == null) existing_meter = new Meter { } on subject.meters;
                        const credit = self.credit(ent.limit.credit);
                        const stof_units = credit != null ? credit.stof_units : 'float';
                        new_value = ?new_value.to_units(stof_units) ?? new_value;

                        const old_value = existing_meter.value;
                        const changed = new_value != old_value;
                        existing_meter.credit = ent.limit.credit;
                        existing_meter.value = new_value;

                        if (existing_meter.reset == null && ent.limit.resets) {
                            existing_meter.reset = Time.now() + ent.limit.reset_inc;
                        }

                        subject.meters.insert(entitlement, existing_meter);
                        
                        if (changed) {
                            const event_value = new {
                                meter: new {
                                    old: old_value,
                                    value: existing_meter.value,
                                },
                                subject,
                                entitlement,
                                plan,
                                credit,
                                balance: ent.limit.value - existing_meter.value,
                            };
                            await <Event>.send('meter-changed', event_value);
                            if (!res) await <Event>.send('meter-overage', event_value);
                            drop(event_value);
                        }

                        res = true; // meter was changed!
                    } else if (ent.limit != null && !res) {
                        const event_value = new {
                            subject,
                            entitlement,
                            plan,
                            credit,
                            invalid_value: new_value,
                        };
                        await <Event>.send('meter-limit', event_value);
                        drop(event_value);
                    }

                    return res;
                }
            }
        }
        false
    }


    /**
     * Perform an entitlement check for a subject by ID.
     * By default, any limit enforcements will not take effect.
     */
    fn check(id: str!, entitlement: str!, value: float = 0) -> bool {
        const subject = self.subject(id);
        if (subject != null) {
            const plan = self.plan_for(id);
            if (plan != null) {
                const ent: Entitlement = plan.entitlements.get(entitlement);
                if (ent != null) {
                    const existing_meter: Meter = subject.meters.get(entitlement);
                    let new_value: float = existing_meter != null ? existing_meter.value + value : value;

                    // check if the new value should be reset!
                    if (existing_meter != null && existing_meter.reset != null && ent.limit != null && ent.limit.resets && Time.now() > existing_meter.reset) {
                        new_value = value;
                    }

                    let res = ent.check(new_value);
                    if (!res && ent.limit != null && ent.limit.mode == 'soft') res = true;
                    return res;
                }
            }
        }
        false
    }


    /*****************************************************************************
     * Credits.
     *****************************************************************************/
    
    /**
     * Get a global credit type.
     */
    fn credit(id: str!) -> Credit {
        self.credits.get(id)
    }


    /**
     * Get a credit type for a specific entitlement (that has a limit).
     * ID can be a plan ID or a subject ID.
     */
    fn credit_for(id: str!, entitlement: str!) -> Credit {
        const ent = self.entitlement(id, entitlement);
        if (ent != null && ent.limit != null) {
            return self.credit(ent.limit.credit);
        }
        null
    }


    /*****************************************************************************
     * Subjects.
     *****************************************************************************/
    
    /**
     * Get a global subject by ID.
     */
    fn subject(id: str!) -> Subject {
        const sub = self.subjects.get(id);
        if (sub == null) {
            const alt = self.alt_subject_ids.get(id);
            if (alt != null) return self.subject(alt);
        }
        sub
    }


    /**
     * Change a subject's plan ID.
     */
    fn set_subject_plan(id: str!, plan: str!) -> bool {
        const sub = self.subject(id);
        const pn = self.plans.get(plan); // dont use self.plan(plan) because plan cannot be a subject ID here
        if (pn != null && sub.plan != plan) {
            sub.plan = plan;
            await <Event>.send('subject-set', sub);
            return true;
        }
        false
    }


    /**
     * Create a subject with an ID and plan ID.
     */
    fn create_subject(id: str!, plan: str!, type: str! = 'user', label: str! = 'User', org?: str, alts?: list) -> Subject {
        const pn = self.plan(plan);
        if (pn != null) {

            // check for existing subject to update
            const existing: Subject = self.subjects.get(id);
            if (existing != null) {
                existing.type = type;
                existing.label = label;
                existing.plan = plan;
                existing.org = org ?? existing.org;
                await <Event>.send('subject-set', existing);
                return existing;
            }

            const subject = new Subject {
                id,
                plan,
                type,
                label,
                org,
            } on self.subjects;
            self.subjects.insert(id, subject);

            // init alternative ids
            if (alts != null) for (const alt in alts) self.set_alt_subject_id(id, alt);

            await <Event>.send('subject-set', subject);
            return subject;
        }
        null
    }


    /**
     * Set/create a subject with an id & internal Stof.
     */
    fn set_subject(id: str!, internal_stof: str!) -> Subject {
        self.delete_subject(id);
        const sub = new {} on self.subjects;
        try parse(internal_stof, sub, 'stof');
        catch {
            drop(sub);
            return null;
        }

        self.subjects.insert(id, sub as Subject);
        for (const alt in sub.alt_ids ?? []) self.set_alt_subject_id(id, alt);
        await <Event>.send('subject-set', subject);
        sub
    }


    /**
     * Delete a subject.
     */
    fn delete_subject(id: str!) -> bool {
        const subject = self.subject(id);
        if (subject != null) {
            await <Event>.send('subject-removed', subject);
            for (const alt in subject.alt_ids) self.delete_alt_subject_id(alt);
            return self.subjects.remove(subject.id);
        }
        false
    }


    /**
     * Set an alternative subject ID (must be unique).
     */
    fn set_alt_subject_id(subject_id: str!, alt_id: str!) -> bool {
        const subject = self.subject(subject_id);
        if (subject != null) {
            subject.alt_ids.remove_all(alt_id);
            subject.alt_ids.push_back(alt_id);
            self.alt_subject_ids.insert(alt_id, subject_id);
            await <Event>.send('subject-set', subject);
            return true;
        }
        false
    }


    /**
     * Delete an alternative subject ID.
     */
    fn delete_alt_subject_id(subject_id: str!) -> bool {
        const subject = self.subject(subject_id);
        const res = self.alt_subject_ids.remove(subject_id);
        if (subject != null) {
            subject.alt_ids.remove_all(subject_id);
            await <Event>.send('subject-set', subject);
        }
        res
    }
}
