#[type]
/**
 * A Limitr policy: the rules (credits, plans, entitlements) and the state (customers and their meters)
 * in one object, which always lives at root.policy. Public functions come first, grouped by area; the
 * Internal section at the end holds their helpers.
 */
Limitr: {
    /// Limitr version.
    ver version: 0.7.0;

    /// Exchange rates.
    Exchange exchange: {};

    /// Notification contracts.
    Notifications notifications: {};

    /// Credits.
    obj credits: {};

    /// Available plan definitions by ID.
    obj plans: {};

    /// Customers by ID.
    obj customers: {};

    /// Alternative customer ID mappings.
    obj alt_customer_ids: {};

    /// Capabilities.
    obj capabilities: {};

    /// Policy-wide usage estimates (see estimate()): estimates.<entitlement>.<segment> -> Estimate.
    /// An entitlement's estimate_basis and estimate_segment say what each call is measured by.
    /// Learned from settle() and observe(); Cloud can seed or replace them with numbers pooled across engines.
    /// Each segment keeps its own estimate (here and on every customer's meter), so keep segments few:
    /// a model or a feature, never a user or request ID.
    obj estimates: {};

    /// A customer's own estimate is used once it has this many samples (before that, the policy-wide one).
    int estimate_min_samples: 5;

    /// How long a reservation holds room before it expires (a call that never settles can't hold room forever).
    ms hold_ttl: 10min;


    /*****************************************************************************
     * The policy
     * root.policy is the policy. Call its functions directly: root.policy.allow(...).
     *****************************************************************************/


    #[static]
    /**
     * The policy: the Limitr at root.policy, the one place a policy lives.
     * A policy parsed from JSON, YAML, or TOML has no type yet - this gives it one (the return type
     * casts it). SDKs call it once after loading or replacing a policy, then call the policy's
     * functions directly (Ex. root.policy.allow(...)).
     */
    fn load() -> Limitr {
        root.policy
    }


    /**
     * Is this a valid policy?
     */
    fn valid() -> bool {
        ?<LimitrValidation>.error('');
        for (const pair in self.credits.fields()) {
            const credit: Credit = pair[1];
            if (!<Credit>.schemafy(credit)) return false;
        }
        for (const pair in self.plans.fields()) {
            const plan: Plan = pair[1];
            plan.name = pair[0];
            if (!<Plan>.schemafy(plan)) return false;
        }
        if (!<Exchange>.schemafy(self.exchange)) return false;
        for (const pair in self.exchange.fields()) {
            const key = pair[0];
            const val = pair[1];
            if (typeof val == 'obj' && key != 'rune') {
                val as ExchangePair;
                if (!<ExchangePair>.schemafy(val)) return false;
                if (self.exchange.to_runes(1, val.currency) == null) return <LimitrValidation>.error(`Credit "${key}" exchange "${val.currency}" currency does not map to Limitr runes (broken conversions)`);
            }
        }
        true
    }


    /*****************************************************************************
     * Metering
     * Decide and record usage. allow() is the engine; the others are variations of it.
     *****************************************************************************/


    /**
     * Allow an entitlement for a customer to change by "value"?
     * A basic entitlement boolean check if value is 0 or a limit does not exist for an entitlement.
     *
     * `cap` is an optional call-scoped spend ceiling - either a Cap object
     * or a bare map of credit -> ceiling (e.g. map(('ai_credits', 2), ('usd', 5))).
     * It is evaluated identically to, and in addition to, any standing caps
     * already on the customer (customer.caps) - ALL applicable caps (standing
     * and call-scoped) must have room for this call to be allowed; caps only
     * restrict, they never grant extra room beyond the plan Limit.
     *
     * Provider overhead: each call's overhead (runes) is recorded on the meter for the period. It is
     * `overhead` when the host passes the actual cost (Ex. from the provider's response), otherwise the
     * credit's overhead(units, context) cost function, with the event data as context.
     */
    fn allow(id: str!, entitlement: str!, value: float | str = 0, event: bool | str | obj = true, cap: Cap | map = null, overhead?: float, force: bool = false) -> bool {
        if (typeof value == 'str') value = value as float; // takes units into consideration too

        // event data: an obj, or a Stof/JSON string parsed here (and dropped when allow() returns)
        const ctx = self.resolve_context(event);
        using parsed_event = ctx[1] ? ctx[0] : null;
        const event_data = ctx[0];
        if (typeof event == 'str') event = event.len() > 0;
        else if (typeof event == 'obj') event = true;

        // this call's temporary objects (events, call-scoped caps), all dropped when allow() returns
        using scratch = new {};

        const pair = self.customer_entitlement(id, entitlement);
        if (pair != null) {
            const customer = pair[0];
            const ent = pair[1];
            const limit = self.customer_entitlement_limit(customer, entitlement, ent);

            // get the credit & existing meter & cast value to credit units
            let existing_meter: Meter = customer.meters.get(entitlement);
            let credit_name = limit != null ? limit.credit : (existing_meter != null ? existing_meter.credit : null);
            const credit = credit_name != null ? self.credit(credit_name) : null;
            const stof_units = credit != null ? (credit.stof_units ?? 'float') : 'float';
            value = value.to_units(stof_units);

            // Provider overhead for this call (runes): the host's actual cost, else the credit's cost function.
            // Caps work per unit (a grant can cover part of a call), so they get this call's effective rate.
            const call_overhead: float = self.call_overhead(value, credit, event_data, overhead);
            const credit_overhead: float = value != 0 ? call_overhead / value.remove_units() : (credit != null ? (credit.overhead_cost ?? 0) : 0);
            let new_value: float = existing_meter != null ? existing_meter.value + value : value;
            const limit_value = limit != null ? (limit.value as float).to_units(stof_units) : 0.0;

            // get customer plan
            const pl = self.plan_for(customer.id);
            const plan = pl != null ? pl.name : null;

            // events report the value before this call (pre-reset on a reset)
            const prior_value: float = existing_meter ? existing_meter.value : 0;

            // should the meter be reset?
            let existing_meter_reset = false;
            const now = Time::now();
            if (existing_meter != null && existing_meter.started != null && limit != null && limit.resets) {
                const period_start = limit.current_period_start(existing_meter.started, now);
                const should_reset = period_start != null && period_start != existing_meter.started;
                if (should_reset) {
                    existing_meter.started = period_start;
                    new_value = value;
                    existing_meter_reset = true;
                    // the new period starts from zero now, even if this call is denied below
                    // (otherwise the next call would add to last period's usage)
                    existing_meter.value = 0;
                    existing_meter.overhead = 0;
                    while (existing_meter.history.len() > 0) drop(existing_meter.history.pop_front());
                    existing_meter.governor_tokens = null;
                    existing_meter.governor_last_refill = null;
                    existing_meter.ewma_rate = null;
                }
            }

            // is the new value below a defined minimum?
            if (limit != null && limit.minimum != null) {
                const min_val = (limit.minimum as float).to_units(stof_units);
                if (new_value < min_val) {
                    new_value = min_val;
                }
            }

            // Calculate overage from new and existing values (okay to do here now that new_value is locked in)
            // After a period reset, the period starts from zero - the old value is only kept for events
            const meter_value: float = existing_meter && !existing_meter_reset ? existing_meter.value : 0;

            // Overhead already spent this period (meters from before 0.7.0: the fixed-rate equivalent)
            const overhead_base: float = existing_meter && !existing_meter_reset
                ? (existing_meter.overhead ?? (meter_value * (credit?.overhead_cost ?? 0)).remove_units())
                : 0;
            const overhead_total: float = overhead_base + call_overhead;

            // Room held by in-flight calls (reserve()) counts for the limit and cap checks below, so
            // concurrent calls can't overspend together. Holds are never metered or billed themselves.
            // The gate_* values are this call plus the held room (equal to the call's own when nothing is held).
            let held_value: float = 0;
            let held_overhead: float = 0;
            if (existing_meter != null && value > 0) {
                const held = existing_meter.held(true);
                held_value = held[0];
                held_overhead = held[1];
            }
            const gate_value: float = value + held_value;
            const gate_new: float = new_value + held_value;
            const gate_overage: float = gate_new > meter_value ? gate_new - max(meter_value, limit_value) : gate_new - limit_value;
            const gate_rate: float = held_value != 0 && gate_value != 0 ? (call_overhead + held_overhead) / gate_value.remove_units() : credit_overhead;
            let overage = new_value > meter_value ? new_value - max(meter_value, limit_value) : new_value - limit_value;

            // Where this call starts on the credit's tier curve (billable units = past the limit)
            const position = (meter_value - limit_value).remove_units();
            const billable = max(0, position);

            // What the call is worth at list price (runes, events' meter.price_diff): the billable units it adds
            // past the limit, priced from where the customer already is on the credit's tiers (the revenue margin
            // breakdowns count). Before grants, so a grant-covered call still shows its worth. Null when the credit
            // has no price. Only events carry it, so a call without events skips the pricing.
            const billable_diff = max(0, (new_value - limit_value).remove_units()) - billable;
            const call_price: float = event && credit_name != null ? self.price_units(credit_name, billable_diff, billable, credit) : null;

            // Cap gate: resolve any call-scoped ephemeral caps and check ALL
            // applicable caps (standing + ephemeral) BEFORE any mutation -
            // governor tokens, meters, and grants are all untouched at this
            // point, so a cap denial here is a clean no-op deny.
            // Caps on this call: the caller's own caps + shared caps up its refs chain + call-scoped caps.
            // (Not the meter owner's: a scoped entitlement moves the meter, not whose caps apply.)
            const caller: Customer = self.customer(id);
            const ephemeral_caps = cap == null ? [] : customer.caps_from_arg(cap, scratch);
            const cap_extras = self.shared_caps_for(caller);
            for (const ec in ephemeral_caps) cap_extras.push_back(ec);
            let cap_grant_applied = 0.0;
            let cap_overage = 0.0;
            // `force` records usage that already happened (Ex. settle()): caps, grants coverage, and the
            // governor can't stop it, and it is metered past a hard limit like a soft one.
            if (!force && value > 0 && credit_name != null) {
                const denied: Cap = caller.denying_cap(self, entitlement, credit_name, gate_rate, gate_value, gate_overage, cap_extras, stof_units, true, position);
                if (denied != null) {
                    if (event) await self.send_cap_limit(denied, caller, entitlement, new {
                        value: meter_value, limit: limit_value, diff: value,
                        overhead: overhead_base, overhead_diff: call_overhead,
                        price_diff: call_price,
                    } on scratch, scratch, plan, credit, event_data);
                    return false;
                }
            }
            if (!force && limit != null && limit.grants_apply) {
                const remaining = customer.remaining_grant_credit(self, limit.credit, billable);
                if (remaining != null) {
                    const diff = max(0, Num::round(gate_value - remaining, 9)); // at 1e-9: float residue isn't uncovered usage
                    const diff_overage = max(0, Num::round(gate_overage - remaining, 9));
                    // uncovered units are the tail of the call (grants cover from the first overage unit)
                    const diff_position = position + (gate_value - diff);
                    const diff_overage_position = billable + max(0, max(0, gate_overage) - diff_overage);
                    if (diff > 0) { // will be overage even in the case of fully used grants
                        const denied: Cap = caller.denying_cap(self, entitlement, credit_name, gate_rate, diff, diff_overage, cap_extras, stof_units, false, diff_position, diff_overage_position);
                        if (denied != null) {
                            if (event) await self.send_cap_limit(denied, caller, entitlement, new {
                        value: meter_value, limit: limit_value, diff: value,
                        overhead: overhead_base, overhead_diff: call_overhead,
                        price_diff: call_price,
                    } on scratch, scratch, plan, credit, event_data);
                            return false;
                        }
                    }
                }
            }

            // Governor gate: check rate ceiling before hard limit
            if (!force && limit != null && limit.mode == 'hard' && limit.governor_enabled && limit.governor_capacity != null) {
                if (existing_meter == null) existing_meter = new Meter { started: Time::now() } on customer.meters;
                customer.meters.insert(entitlement, existing_meter);

                // Lazy-init governor runtime state & refill
                if (existing_meter.governor_tokens == null) {
                    existing_meter.governor_tokens = limit.governor_capacity as float;
                    existing_meter.governor_last_refill = Time::now();
                }
                existing_meter.refill_governor(limit.governor_capacity as float, limit.governor_refill_rate);

                if (value > 0 && Num::round(value, 9) > Num::round(existing_meter.governor_tokens, 9)) {
                    // Governor deny — fire new event, record history, return false
                    existing_meter.push_history(value, limit.ewma_alpha ?? 0.2);
                    if (event) {
                        const event_value = new {
                            meter: new { value: meter_value, limit: limit_value, overhead: overhead_base },
                            customer,
                            entitlement,
                            plan,
                            credit,
                            event_data,
                            governor: new {
                                tokens: existing_meter.governor_tokens,
                                capacity: limit.governor_capacity as float,
                                requested: value,
                            },
                        } on scratch;
                        const notes: Notifications = self.notifications;
                        self.round_event(event_value);
                        await notes.handle_event('meter-governed', event_value);
                        await <Event>.send('meter-governed', event_value);
                    }
                    return false;
                }

                // Consume tokens
                if (value > 0) existing_meter.governor_tokens -= value;
            }

            // check to see if the new value is valid (bounded by limit). The call's own fit decides its
            // overage; room held by in-flight calls only decides whether it may run.
            const own_valid = limit != null ? limit.check(new_value, meter_value) : true;
            let gate_valid = held_value != 0 && limit != null ? limit.check(gate_new, meter_value + held_value) : own_valid;
            if (!gate_valid && own_valid && limit.grants_apply) {
                // the call fits on its own, but held room pushes past the limit: grants can cover the held part
                const remaining = customer.remaining_grant_credit(self, limit.credit, billable);
                gate_valid = remaining != null && Num::round(remaining, 9) >= Num::round(gate_overage, 9);
            }
            let valid = own_valid && gate_valid;
            
            if (limit != null && (valid || limit.mode == 'soft' || force)) {
                if (existing_meter == null) existing_meter = new Meter { started: Time::now() } on customer.meters;
                const old_value = prior_value; // events report the value before this call (pre-reset on a reset)
                const changed = new_value != old_value || call_overhead != 0; // overhead alone (Ex. a failed call that still cost) is a change
                existing_meter.credit = limit.credit;
                existing_meter.value = new_value;
                existing_meter.overhead = overhead_total;
                existing_meter.push_history(value, limit.ewma_alpha ?? 0.2);
                customer.meters.insert(entitlement, existing_meter);
                
                if (changed) {
                    const event_value = new {
                        meter: new {
                            old: old_value,
                            value: new_value,
                            limit: limit_value,
                            diff: value,
                            overhead: overhead_total,
                            overhead_diff: call_overhead,
                            price_diff: call_price,
                        },
                        customer,
                        entitlement,
                        plan,
                        credit,
                        remaining: limit_value - new_value,
                        event_data,
                    } on scratch;
                    let sent_overage = false;
                    if (!own_valid) {
                        // contemplate credit grants for this customer before sending overage amount
                        // grants will modify event_value.overage for appropriate aggregation in the correct units
                        event_value.overage = overage;
                        cap_overage += overage; // before grants applied to overage of course
                        if (!limit.grants_apply || customer.apply_overage_grants(self, pl, limit.credit, event_value, stof_units, billable)) {
                            // intercept here with voucher mode to protect your costs if using a voucher with max spend
                            // if customer operating with a voucher and the voucher cannot cover the additional overage, return false!
                            if (!customer.ensure_voucher(limit.credit, event_value, self.exchange, billable) && !force) {
                                // if meter was reset, this goes to 0 (meter_value), not to the old value
                                existing_meter.value = meter_value;
                                existing_meter.overhead = overhead_base;
                                return false;
                            }

                            // What to bill (runes): the overage grants didn't cover, priced from where their coverage
                            // ended. With no grant applied, that is exactly the call's billable worth (price_diff).
                            const covered = event_value.grant_value_applied ?? 0;
                            event_value.overage_price = call_price == null || covered <= 0 ? call_price
                                : self.price_units(credit_name, max(0, event_value.overage), billable + covered, credit);
                            sent_overage = true;

                            if (event) {
                                // Internal notifications first for any matching
                                const notes: Notifications = self.notifications;
                                self.round_event(event_value);
                                await notes.handle_event('meter-overage', event_value);
                                await <Event>.send('meter-overage', event_value);
                            }
                        }

                        // capture grant_value_applied for ignore_grant caps
                        if (event_value.grant_value_applied) {
                            cap_grant_applied += event_value.grant_value_applied;
                        }
                    }
                    if (existing_meter_reset && event) {
                        const notes: Notifications = self.notifications;
                        self.round_event(event_value);
                        await notes.handle_event('meter-reset', event_value);
                        await <Event>.send('meter-reset', event_value);
                    }
                    if (!sent_overage && event) {
                        // Internal notifications first for any matching
                        const notes: Notifications = self.notifications;
                        self.round_event(event_value);
                        await notes.handle_event('meter-changed', event_value);
                        await <Event>.send('meter-changed', event_value);
                    }
                }

                valid = true; // meter was changed!
            } else if (limit != null && !valid) {
                let event_value = new {
                    meter: new {
                        value: prior_value,
                        limit: limit_value,
                        invalid: new_value,
                        diff: value,
                        overhead: overhead_base,
                        overhead_diff: call_overhead,
                        price_diff: call_price,
                    },
                    customer,
                    entitlement,
                    plan,
                    credit,
                    invalid_value: new_value,
                    overage,
                    event_data,
                } on scratch;
                
                if (overage > 0 && limit.grants_apply) {
                    const remaining = customer.remaining_grant_credit(self, limit.credit, billable);
                    if (remaining != null && Num::round(remaining, 9) >= Num::round(gate_overage, 9)) {
                        cap_overage += overage; // for spend caps that are overage only
                        if (!customer.apply_overage_grants(self, pl, limit.credit, event_value, stof_units, billable)) {
                            valid = true; // we're now valid
                            
                            const grant_value_applied = event_value.grant_value_applied;
                            overage = event_value.overage;
                            drop(event_value);
                            event_value = new {
                                meter: new {
                                    old: prior_value,
                                    value: new_value,
                                    limit: limit_value,
                                    diff: value,
                                    overhead: overhead_total,
                                    overhead_diff: call_overhead,
                                    price_diff: call_price,
                                },
                                customer,
                                entitlement,
                                plan,
                                credit,
                                remaining: limit_value - new_value,
                                grant_value_applied,
                                overage,
                                event_data,
                            } on scratch;

                            if (existing_meter == null) existing_meter = new Meter { started: Time::now() } on customer.meters;
                            existing_meter.credit = limit.credit;
                            existing_meter.value = new_value;
                            existing_meter.overhead = overhead_total;
                            existing_meter.push_history(value, limit.ewma_alpha ?? 0.2);
                            customer.meters.insert(entitlement, existing_meter);
                        }

                        // capture grant_value_applied for ignore_grant caps
                        if (event_value.grant_value_applied) {
                            cap_grant_applied += event_value.grant_value_applied;
                        }
                    }
                }

                if (event) {
                    if (existing_meter_reset) {
                        const notes: Notifications = self.notifications;
                        self.round_event(event_value);
                        await notes.handle_event('meter-reset', event_value);
                        await <Event>.send('meter-reset', event_value);
                    }
                    if (valid) {
                        // Internal notifications first for any matching
                        const notes: Notifications = self.notifications;
                        self.round_event(event_value);
                        await notes.handle_event('meter-changed', event_value);
                        await <Event>.send('meter-changed', event_value);
                    } else {
                        // Internal notifications first for any matching
                        const notes: Notifications = self.notifications;
                        self.round_event(event_value);
                        await notes.handle_event('meter-limit', event_value);
                        await <Event>.send('meter-limit', event_value);
                    }
                }
            }

            // Cap commit: only now that the entitlement-side outcome is final
            // do we actually advance cap meter_values. A call that the cap
            // gate above already allowed but that failed for an unrelated
            // reason (hard limit with no grant coverage, voucher exhausted,
            // governor deny) must not consume cap room for a call that
            // never went through.
            if (valid && credit_name != null) {
                const changed_caps = [];
                // overhead with no units (Ex. a failed call that still cost) only moves overhead caps
                const overhead_only = value == 0 && call_overhead != 0 ? call_overhead : null;
                const crossings = caller.check_and_apply_caps(self, entitlement, credit_name, credit_overhead, value, cap_overage, cap_grant_applied, cap_extras, stof_units, position, changed_caps, force, overhead_only);
                if (crossings != null && event) {
                    for (const crossed: Cap in crossings) {
                        const threshold_event = new {
                            customer: self.cap_holder(crossed) ?? caller, // the customer whose cap crossed
                            caller,
                            entitlement,
                            cap: crossed,
                        } on scratch;
                        const notes: Notifications = self.notifications;
                        self.round_event(threshold_event);
                        await notes.handle_event('cap-threshold-crossed', threshold_event);
                        await <Event>.send_tmp('cap-threshold-crossed', threshold_event);
                    }
                }

                // Sync: the meter event carries the meter owner; any other customer whose cap
                // moved on this call (the caller's personal caps on a scoped entitlement, shared
                // caps up the chain) gets one customer-set.
                if (event && changed_caps.any()) {
                    const synced = set();
                    for (const moved: Cap in changed_caps) {
                        const holder = self.cap_holder(moved);
                        if (holder == null || holder == customer || synced.contains(holder.id)) continue;
                        synced.insert(holder.id);
                        await <Event>.send('customer-set', holder);
                    }
                }
            }
            return valid;
        }
        false
    }


    /**
     * If one were to call "allow" for this entitlement and value, would it be valid?
     * Does not change meters for this customer, nor any cap meter_values.
     *
     * `cap` is an optional call-scoped spend ceiling, evaluated identically
     * to allow() - see allow()'s docs for the Cap | map shorthand.
     * `context` (the event data you'd pass to allow(), as an obj or a Stof string) and `overhead`
     * (the call's actual cost in runes) price the call for overhead caps, the same way allow() does.
     */
    fn check(id: str!, entitlement: str!, value: float | str = 0, cap: Cap | map = null, context: obj | str = null, overhead?: float) -> bool {
        if (typeof value == 'str') value = value as float; // takes units into consideration too

        // context: an obj, or a Stof/JSON string parsed here (and dropped when check() returns)
        const ctx = self.resolve_context(context);
        using parsed_context = ctx[1] ? ctx[0] : null;
        context = ctx[0];

        // this call's temporary objects (call-scoped caps), dropped when check() returns
        using scratch = new {};

        const pair = self.customer_entitlement(id, entitlement);
        if (pair != null) {
            const customer = pair[0];
            const ent = pair[1];
            const limit = self.customer_entitlement_limit(customer, entitlement, ent);

            // get the credit & existing meter & cast value to credit units
            let existing_meter: Meter = customer.meters.get(entitlement);
            let credit_name = limit != null ? limit.credit : (existing_meter != null ? existing_meter.credit : null);
            const credit = credit_name != null ? self.credit(credit_name) : null;
            const stof_units = credit != null ? (credit.stof_units ?? 'float') : 'float';
            value = value.to_units(stof_units);

            // This call's overhead (runes) and its effective per-unit rate, same as allow()
            const call_overhead: float = self.call_overhead(value, credit, context, overhead);
            const credit_overhead: float = value != 0 ? call_overhead / value.remove_units() : (credit != null ? (credit.overhead_cost ?? 0) : 0);
            let new_value: float = existing_meter != null ? existing_meter.value + value : value;

            // should the meter be reset? (allow() would reset it - evaluate against a fresh period)
            const reset_pending = self.meter_reset_pending(limit, existing_meter);
            if (reset_pending) new_value = value;

            // is the new value below a defined minimum?
            if (limit != null && limit.minimum != null) {
                const min_val = (limit.minimum as float).to_units(stof_units);
                if (new_value < min_val) {
                    new_value = min_val;
                }
            }

            // Calculate overage from new and existing values (okay to do here now that new_value is locked in)
            const limit_value = limit != null ? (limit.value as float).to_units(stof_units) : 0.0;
            const meter_value: float = existing_meter && !reset_pending ? existing_meter.value : 0;
            let overage = new_value > meter_value ? new_value - max(meter_value, limit_value) : new_value - limit_value;

            // Where this call starts on the credit's tier curve (billable units = past the limit)
            const position = (meter_value - limit_value).remove_units();
            const billable = max(0, position);

            // Room held by in-flight calls (reserve()) counts, same as allow() (read-only: expired holds stay)
            let held_value: float = 0;
            let held_overhead: float = 0;
            if (existing_meter != null && value > 0) {
                const held = existing_meter.held();
                held_value = held[0];
                held_overhead = held[1];
            }
            const gate_value: float = value + held_value;
            const gate_new: float = new_value + held_value;
            const gate_overage: float = gate_new > meter_value ? gate_new - max(meter_value, limit_value) : gate_new - limit_value;
            const gate_rate: float = held_value != 0 && gate_value != 0 ? (call_overhead + held_overhead) / gate_value.remove_units() : credit_overhead;

            // Cap gate: resolve any call-scoped ephemeral caps and check ALL
            // applicable caps (standing + ephemeral) BEFORE any mutation -
            // governor tokens, meters, and grants are all untouched at this
            // point, so a cap denial here is a clean no-op deny.
            const caller: Customer = self.customer(id);
            const ephemeral_caps = cap == null ? [] : customer.caps_from_arg(cap, scratch);
            const cap_extras = self.shared_caps_for(caller);
            for (const ec in ephemeral_caps) cap_extras.push_back(ec);
            if (value > 0 && credit_name != null && !caller.check_caps(self, entitlement, credit_name, gate_rate, gate_value, gate_overage, cap_extras, stof_units, true, position)) {
                return false;
            }
            if (limit != null && limit.grants_apply) {
                const remaining = customer.remaining_grant_credit(self, limit.credit, billable);
                if (remaining != null) {
                    const diff = max(0, Num::round(gate_value - remaining, 9)); // at 1e-9: float residue isn't uncovered usage
                    const diff_overage = max(0, Num::round(gate_overage - remaining, 9));
                    const diff_position = position + (gate_value - diff);
                    const diff_overage_position = billable + max(0, max(0, gate_overage) - diff_overage);
                    if (diff > 0 && !caller.check_caps(self, entitlement, credit_name, gate_rate, diff, diff_overage, cap_extras, stof_units, false, diff_position, diff_overage_position)) { // will be overage even in the case of fully used grants
                        return false;
                    }
                }
            }

            // Governor gate: same rate ceiling allow() applies, evaluated without consuming or refilling.
            // A pending period reset clears governor state in allow(), so that's a full bucket here.
            if (value > 0 && limit != null && limit.mode == 'hard' && limit.governor_enabled && limit.governor_capacity != null) {
                const capacity = limit.governor_capacity as float;
                const available = existing_meter == null || reset_pending ? capacity : existing_meter.governor_available(capacity, limit.governor_refill_rate);
                if (Num::round(value, 9) > Num::round(available, 9)) {
                    return false;
                }
            }

            // check to see if the new value is valid (bounded by limit)
            let valid = limit != null ? (held_value != 0 ? limit.check(gate_new, meter_value + held_value) : limit.check(new_value, meter_value)) : true;
            if (valid || (limit != null && limit.mode != 'hard')) {
                return true;
            }

            // if we have a hard limit, lets check against credit grants to see if we're good
            if (limit != null && limit.mode == 'hard' && limit.grants_apply && gate_overage > 0) {
                const remaining = customer.remaining_grant_credit(self, limit.credit, billable);
                if (remaining != null && Num::round(remaining, 9) >= Num::round(gate_overage, 9)) {
                    return true;
                }
            }
        }
        false
    }


    /**
     * Change the value of a metered entitlement by a standard increment (defined in the Limit).
     */
    fn increment(id: str!, entitlement: str!, event: bool | str | obj = true, cap: Cap | map = null) -> bool {
        const cost = self.cost(id, entitlement);
        cost != null ? self.allow(id, entitlement, cost, event, cap) : false
    }


    /**
     * Change the value of a metered entitlement by removing a standard increment (defined in the limit).
     */
    fn decrement(id: str!, entitlement: str!, event: bool | str | obj = true, cap: Cap | map = null) -> bool {
        const cost = self.cost(id, entitlement);
        cost != null ? self.allow(id, entitlement, cost * -1, event, cap) : false
    }


    /**
     * Check if changing the value of a metered entitlement by a standard increment would be allowed (defined in the Limit).
     */
    fn check_increment(id: str!, entitlement: str!, cap: Cap | map = null) -> bool {
        const cost = self.cost(id, entitlement);
        cost != null ? self.check(id, entitlement, cost, cap) : false
    }


    /**
     * Check if changing the value of a metered entitlement by a negative standard increment would be allowed (defined in the Limit).
     */
    fn check_decrement(id: str!, entitlement: str!, cap: Cap | map = null) -> bool {
        const cost = self.cost(id, entitlement);
        cost != null ? self.check(id, entitlement, cost * -1, cap) : false
    }


    /*****************************************************************************
     * Reservations & estimates
     * Hold room for calls whose usage is only known afterwards, and predict them.
     *****************************************************************************/


    /**
     * Hold room for a call before it runs (Ex. before an LLM request), so concurrent calls can't overspend
     * together. Returns a hold ID, or null if the call wouldn't be allowed right now (the same check as
     * check(), counting every other hold). When the call finishes, settle() it with the actual usage, or
     * release() it if the call never happens. A hold that is never settled expires after `ttl` (default:
     * the policy's hold_ttl). Holds are never metered or billed.
     *
     * `value` is the amount to hold. Leave it null to hold the predicted amount: estimate() for this
     * customer and call at `quantile`; with nothing learned yet, the entitlement's standard increment.
     * `context` is the call's event data: it prices the hold for overhead caps, same as allow() (a
     * predicted hold uses the predicted overhead), and supplies the entitlement's estimate_basis and
     * estimate_segment (`basis` and `segment` arguments win). Both stay on the hold, so settle() learns
     * from the call.
     *
     * A hold counts on its own meter: this customer's (or scope owner's) limit for the entitlement, and the
     * caps checked on calls to it. Caps that span other entitlements or customers don't see it from there.
     */
    fn reserve(id: str!, entitlement: str!, value: float | str = null, context: obj | str = null, basis?: float, segment?: str, ttl?: ms, quantile: float = 0.9, overhead?: float) -> str {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair == null) return null;
        const customer = pair[0];
        const limit = self.customer_entitlement_limit(customer, entitlement, pair[1]);
        if (limit == null) return null; // nothing to hold room against
        const credit = self.credit(limit.credit);
        const stof_units = credit != null ? (credit.stof_units ?? 'float') : 'float';

        const ctx = self.resolve_context(context);
        using parsed_context = ctx[1] ? ctx[0] : null;
        const inputs = pair[1].estimate_inputs(ctx[0], basis, segment, value == null);

        let hold_overhead = overhead;
        if (value == null) {
            const prediction = inputs[2] && inputs[0] == null ? null : self.estimate(id, entitlement, inputs[0], inputs[1], quantile);
            if (prediction != null) {
                value = prediction.get('value');
                if (hold_overhead == null) hold_overhead = prediction.get('overhead');
            } else {
                value = self.cost(id, entitlement) ?? 0;
            }
        }
        if (typeof value == 'str') value = value as float;
        value = value.to_units(stof_units);
        if (value <= 0) return null; // only usage is held (a negative hold would add room)

        if (hold_overhead == null) hold_overhead = self.call_overhead(value, credit, ctx[0]);
        if (!self.check(id, entitlement, value, null, ctx[0], hold_overhead)) return null;

        const meter = customer.ensure_meter(entitlement, limit.credit);
        if (meter.holds == null) meter.holds = map();
        else meter.held(true); // drop expired holds (reads never do)
        const hold_id = `hold_${nanoid(16)}`;
        meter.holds.insert(hold_id, map(
            ('value', value),
            ('overhead', hold_overhead),
            ('expires', Time::now() + (ttl ?? self.hold_ttl ?? 10min)),
            ('basis', inputs[0]),
            ('segment', inputs[1])
        ));
        hold_id
    }


    /**
     * Finish a reserved call: drop its hold and record the actual usage with allow(). Usage that already
     * happened is recorded even past a hard limit or a cap (allow's `force`), so the meter matches what
     * really ran. Then learns from the call (observe()) with the hold's basis and segment.
     * `event` and `overhead` are the same as allow() (`event` is also the cost function's context).
     * An unknown or expired hold still records the usage, and learns from `event` (or `basis` and `segment`,
     * which also override the hold's). Returns allow()'s result.
     */
    fn settle(id: str!, entitlement: str!, hold_id: str, value: float | str = 0, event: bool | str | obj = true, overhead?: float, basis?: float, segment?: str) -> bool {
        let hold_basis = basis;
        let hold_segment = segment;
        const meter: Meter = self.meter_obj(id, entitlement);
        if (meter != null && meter.holds != null && hold_id != null) {
            const hold: map = meter.holds.remove(hold_id);
            if (hold != null) {
                hold_basis = hold_basis ?? hold.get('basis');
                hold_segment = hold_segment ?? hold.get('segment');
            }
        }

        const ctx = self.resolve_context(event);
        using parsed_event = ctx[1] ? ctx[0] : null;
        const recorded = self.allow(id, entitlement, value, ctx[0] ?? event, null, overhead, true);
        if (recorded) self.observe(id, entitlement, value, overhead, hold_basis, hold_segment, ctx[0]);
        recorded
    }


    /**
     * Drop a hold without recording anything (the call never happened). False if there was no such hold.
     */
    fn release(id: str!, entitlement: str!, hold_id: str!) -> bool {
        const meter: Meter = self.meter_obj(id, entitlement);
        if (meter == null || meter.holds == null) return false;
        meter.holds.remove(hold_id) != null
    }


    /**
     * Room currently held by unexpired reservations for this customer and entitlement (credit units).
     */
    fn held(id: str!, entitlement: str!) -> float {
        const meter: Meter = self.meter_obj(id, entitlement);
        if (meter == null) return 0;
        Num::round(meter.held()[0], 9)
    }


    /**
     * Predict one call before it runs: map of 'value' (credit units), 'overhead' (runes), 'samples',
     * 'source' ('local' or 'cloud'), and 'scope' ('customer' or 'policy'). Null when nothing has been learned yet.
     *
     * Uses this customer's own estimate once it has estimate_min_samples observations, otherwise the
     * policy-wide one. `quantile` picks how cautious it is (0.5 = a typical call, 0.9 = 9 in 10 calls use
     * this or less). `context` is the call's event data: when the entitlement declares estimate_basis (Ex.
     * 'input'), the prediction scales by that field (required), and estimate_segment (Ex. 'model') picks the
     * segment. `basis` and `segment` arguments win over the context.
     */
    fn estimate(id: str!, entitlement: str!, basis?: float, segment?: str, quantile: float = 0.9, context: obj | str = null) -> map {
        const ent = self.entitlement(id, entitlement);
        if (ent == null) return null;
        const ctx = self.resolve_context(context);
        using parsed_context = ctx[1] ? ctx[0] : null;
        const inputs = ent.estimate_inputs(ctx[0], basis, segment);
        if (inputs[2] && inputs[0] == null) return null; // per basis, and the call has none

        const meter: Meter = self.meter_obj(id, entitlement);
        const own = meter?.estimate(inputs[1]);
        if (own != null && own.samples >= (self.estimate_min_samples ?? 5)) {
            const prediction = own.predict(inputs[0], quantile);
            if (prediction != null) {
                prediction.insert('scope', 'customer');
                return prediction;
            }
        }
        const prediction = self.policy_estimate(entitlement, inputs[1])?.predict(inputs[0], quantile);
        if (prediction != null) prediction.insert('scope', 'policy');
        prediction
    }


    /**
     * Record one call's usage for estimates (settle() does this for you). Updates this customer's estimate
     * and the policy-wide one for the entitlement and segment. `overhead` defaults to the credit's cost
     * function with `context` (the call's event data), which also supplies the entitlement's estimate_basis
     * and estimate_segment fields. `basis` and `segment` arguments win over the context.
     * False when nothing was recorded (Ex. a per-basis entitlement and no basis).
     */
    fn observe(id: str!, entitlement: str!, value: float | str, overhead?: float, basis?: float, segment?: str, context: obj | str = null) -> bool {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair == null) return false;
        const customer = pair[0];
        const limit = self.customer_entitlement_limit(customer, entitlement, pair[1]);
        const credit = limit != null ? self.credit(limit.credit) : null;
        const stof_units = credit != null ? (credit.stof_units ?? 'float') : 'float';
        if (typeof value == 'str') value = value as float;
        value = value.to_units(stof_units);

        const ctx = self.resolve_context(context);
        using parsed_context = ctx[1] ? ctx[0] : null;
        const inputs = pair[1].estimate_inputs(ctx[0], basis, segment);
        if (inputs[2] && inputs[0] == null) return false; // per basis, and the call has none (logged)
        const cost = overhead ?? self.call_overhead(value, credit, ctx[0]);

        const policy_wide = self.policy_estimate(entitlement, inputs[1], true);
        const recorded = policy_wide.observe(value, cost, inputs[0], inputs[2]);
        const own = customer.ensure_meter(entitlement, limit?.credit).estimate(inputs[1], true);
        own.observe(value, cost, inputs[0], inputs[2]) || recorded
    }


    /*****************************************************************************
     * Reads
     * Usage, limits, and balances for the current period. Reads never meter anything.
     *****************************************************************************/


    /**
     * Get the current value of a metered entitlement for a customer ID.
     * Returns null if the entitlement doesn't exist.
     */
    fn value(id: str!, entitlement: str!, percent: bool = false, grants: bool = true) -> float {
        if (percent) return 100 - self.remaining(id, entitlement, true, grants);
        const pair = self.customer_entitlement(id, entitlement);
        if (pair != null) {
            const customer = pair[0];
            const meter: Meter = customer.meters.get(entitlement);
            const limit = self.customer_entitlement_limit(customer, entitlement, pair[1]);
            return Num::round(self.period_value(limit, meter), 9); // outgoing read: 1e-9
        }
        null
    }


    /**
     * Get the remaining entitlement balance value for a customer ID (limit - current (metered) value).
     * Returns a value in the units of the meter (not always the same as defined limit units).
     */
    fn remaining(id: str!, entitlement: str!, percent: bool = false, grants: bool = true) -> float {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair != null) {
            const customer = pair[0];
            const limit = self.customer_entitlement_limit(customer, entitlement, pair[1]);
            if (limit != null && limit.mode != 'observe') {
                const credit = self.credit(limit.credit);
                const stof_units = credit != null ? credit.stof_units : 'float';

                const meter: Meter = customer.meters.get(entitlement);
                let mval = self.period_value(limit, meter);
                let lval = (limit.value as float).to_units(stof_units);

                if (grants) {
                    const remaining = customer.remaining_grant_credit(self, limit.credit, max(0, (mval - lval).remove_units()));
                    if (remaining != null && remaining > 0) lval = max(mval, lval) + remaining;
                }

                let res = lval - mval;
                if (percent) {
                    res = lval != 0 ? (max(0, res) / lval * 100).remove_units() : 0;
                }
                return Num::round(res, 9); // outgoing read: 1e-9 (storage keeps full precision)
            }
        }
        null
    }


    /**
     * Get the limit value for an entitlement.
     * Returns a value in the units of the meter (credit) (not always the same as defined limit units).
     * Ex. limit.value = 2GB, but credit.stof_units = 'MB', limit(..) => MB
     *
     * If grants are included and id is a customer, return limit + current converted grants
     */
    fn limit(id: str!, entitlement: str!, grants: bool = true) -> float {
        const pair = self.customer_entitlement(id, entitlement);
        let limit;
        if (pair != null) {
            limit = self.customer_entitlement_limit(pair[0], entitlement, pair[1]);
        } else {
            const ent = self.entitlement(id, entitlement);
            limit = ent != null ? ent.limit : null;
        }
        if (limit != null && limit.mode != 'observe') {
            const credit = self.credit(limit.credit);
            const stof_units = credit != null ? credit.stof_units : 'float';
            const lim = limit.value as float; // can be a str w units
            let val = lim.to_units(stof_units);

            if (grants && pair != null) {
                const customer = pair[0];
                const meter: Meter = customer.meters.get(entitlement);
                const billable = max(0, (self.period_value(limit, meter) - val).remove_units());
                const remaining = customer.remaining_grant_credit(self, limit.credit, billable);
                if (remaining != null) val += remaining;
            }
            return Num::round(val, 9); // outgoing read: 1e-9 (storage keeps full precision)
        }
        null
    }


    /**
     * Get the immediately available allowance for a customer entitlement.
     * When a governor is configured, this is the minimum of the current governor
     * token balance and the remaining period balance — i.e., how much can actually
     * be consumed right now before either the governor or the hard limit fires.
     * Falls back to remaining() if no governor is configured.
     *
     * Use this to pre-size operations before submitting them — e.g. max video
     * duration, max token budget, max compute seconds — so the operation is
     * sized to what will actually be allowed rather than discovering the limit
     * mid-execution.
     */
    fn allowance(id: str!, entitlement: str!, grants: bool = true) -> float {
        const period_remaining = self.remaining(id, entitlement, grants = grants);
        if (period_remaining == null) return null;

        const pair = self.customer_entitlement(id, entitlement);
        if (pair != null) {
            const limit = self.customer_entitlement_limit(pair[0], entitlement, pair[1]);
            if (limit != null && limit.governor_enabled && limit.governor_capacity != null) {
                const meter: Meter = pair[0].meters.get(entitlement);
                if (meter != null && meter.governor_tokens != null && !self.meter_reset_pending(limit, meter)) {
                    const available = meter.governor_available(limit.governor_capacity as float, limit.governor_refill_rate);
                    return Num::round(min(available, period_remaining), 9);
                }
            }
        }
        period_remaining
    }


    /**
     * Get the standard increment "cost" of an "increment" operation for an entitlement.
     * Will return null if the entitlement doesn't exist.
     */
    fn cost(id: str!, entitlement: str!) -> float {
        const pair = self.customer_entitlement(id, entitlement);
        let limit;
        if (pair != null) {
            limit = self.customer_entitlement_limit(pair[0], entitlement, pair[1]);
        } else {
            const ent = self.entitlement(id, entitlement);
            limit = ent != null ? ent.limit : null;
        }
        limit != null ? (limit.increment ?? 1) : null
    }


    /**
     * Entitlement resets on this timestamp for the following customer ID.
     */
    fn resets(id: str!, entitlement: str!) -> ms {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair != null) {
            const customer = pair[0];
            const ent = pair[1];
            const limit = self.customer_entitlement_limit(customer, entitlement, ent);
            if (limit != null && limit.resets) {
                const now = Time::now();
                if (limit.reset_sch != null) {
                    return self.next_period_start(now, limit.reset_sch);
                }
                const inc = limit.reset_increment();
                if (inc != null) {
                    // read-only: compute the current period, never move the meter (allow() resets it)
                    const existing_meter: Meter = customer.meters.get(entitlement);
                    if (existing_meter != null && existing_meter.started != null) {
                        return limit.current_period_start(existing_meter.started, now) + inc;
                    }
                    return now + inc;
                }
            }
        }
        null
    }


    /**
     * Current instantaneous consumption rate for a customer entitlement.
     * Returns consumption per ms derived from the last two ring buffer entries.
     * Returns 0 if no meter exists or fewer than two allow() calls have been made.
     */
    fn rate(id: str!, entitlement: str!) -> float {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair == null) return 0;
        const meter: Meter = pair[0].meters.get(entitlement);
        if (meter == null) return 0;
        const limit = self.customer_entitlement_limit(pair[0], entitlement, pair[1]);
        if (self.meter_reset_pending(limit, meter)) return 0; // new period - no consumption history yet
        meter.rate()
    }


    /**
     * Rate of change between the two most recent consumption intervals.
     * Positive means consumption is accelerating, negative means decelerating.
     * Returns 0 if no meter exists or fewer than three allow() calls have been made.
     */
    fn acceleration(id: str!, entitlement: str!) -> float {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair == null) return 0;
        const meter: Meter = pair[0].meters.get(entitlement);
        if (meter == null) return 0;
        const limit = self.customer_entitlement_limit(pair[0], entitlement, pair[1]);
        if (self.meter_reset_pending(limit, meter)) return 0; // new period - no consumption history yet
        meter.acceleration()
    }


    /**
     * Estimated time until a customer exhausts their entitlement at the current rate of consumption.
     * Returns a future ms timestamp, or null if there is no consumption history,
     * the rate is zero, or no meter exists yet.
     * Uses the current rate from the meter's ring buffer — meaningful after at least
     * two allow() calls have been made.
     */
    fn projected_exhaustion(id: str!, entitlement: str!, smoothed: bool = false, grants: bool = true) -> ms {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair == null) return null;
        const customer = pair[0];
        const meter: Meter = customer.meters.get(entitlement);
        if (meter == null) return null;
        const limit = self.customer_entitlement_limit(customer, entitlement, pair[1]);
        if (limit == null) return null;
        if (self.meter_reset_pending(limit, meter)) return null; // new period - no consumption history yet
        const credit = self.credit(limit.credit);
        const stof_units = credit != null ? credit.stof_units : 'float';
        let limit_val = (limit.value as float).to_units(stof_units);
        if (grants) {
            const remaining = customer.remaining_grant_credit(self, limit.credit, max(0, (meter.value - limit_val).remove_units()));
            if (remaining != null && remaining > 0) limit_val = max(meter.value, limit_val) + remaining;
        }
        meter.projected_exhaustion(limit_val, smoothed)
    }


    /**
     * Credit remaining for this customer through grants.
     */
    fn credit_remaining(customer_id: str!, credit: str!) -> float {
        const customer = self.customer(customer_id);
        const remaining = customer != null ? customer.remaining_grant_credit(self, credit) : null;
        remaining != null ? Num::round(remaining, 9) : null // outgoing read: 1e-9
    }


    /**
     * Customer meter object.
     * Resolved to the correct customer given the entitlement scope.
     */
    fn meter_obj(id: str!, entitlement: str!) -> Meter {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair != null) {
            const customer = pair[0];
            return customer.meters.get(entitlement);
        }
        null
    }


    /**
     * Get the customer's limit object.
     * Could be overridden, hence the helper.
     */
    fn limit_obj(id: str!, entitlement: str!) -> Limit {
        const pair = self.customer_entitlement(id, entitlement);
        let limit;
        if (pair != null) {
            limit = self.customer_entitlement_limit(pair[0], entitlement, pair[1]);
        } else {
            const ent = self.entitlement(id, entitlement);
            limit = ent != null ? ent.limit : null;
        }
        limit
    }


    /**
     * Get a plan entitlement from either a customer ID or plan ID.
     */
    fn entitlement(id: str!, entitlement: str!) -> Entitlement {
        const pn: Plan = self.plan(id);
        if (pn != null) {
            return pn.entitlements.get(entitlement);
        }
        null
    }


    /*****************************************************************************
     * Customers
     *****************************************************************************/


    /**
     * Get a global customer by ID.
     */
    fn customer(id: str!) -> Customer {
        const sub = self.customers.get(id);
        if (sub == null) {
            const alt = self.alt_customer_ids.get(id);
            if (alt != null) return self.customer(alt);
        }
        sub
    }


    /**
     * Create a customer with an ID and plan ID.
     */
    fn create_customer(id: str!, plan: str! = '', type: str! = 'user', label: str! = 'User', refs?: list, alts?: list, metadata?: str | obj) -> Customer {
        let pn = self.plan(plan, default = false);
        if (pn == null && refs != null) {
            for (const ref in refs) {
                pn = self.plan_for(ref, default = false);
                if (pn != null) {
                    plan = '';
                    break;
                }
            }
        }
        if (pn == null) {
            pn = self.default_plan();
            if (pn != null) plan = pn.name;
        }
        if (pn != null) {
            let meta: obj = null;
            if (metadata != null) {
                if (typeof metadata == 'str') {
                    meta = new {};
                    try {
                        parse(metadata, meta, 'stof');
                    } catch {
                        drop(meta);
                        meta = null;
                    }
                } else {
                    meta = metadata;
                }
            }

            // check for existing customer to update
            const existing: Customer = self.customer(id);
            if (existing != null) {
                existing.type = type;
                existing.label = label;
                existing.plan = plan;
                existing.refs = refs ?? [];
                if (meta != null) {
                    existing.metadata = meta;
                    meta.move(existing);
                }
                await <Event>.send('customer-set', existing);
                return existing;
            }

            const customer = new Customer {
                id,
                plan,
                type,
                label,
                refs: refs ?? [],
            } on self.customers;
            if (meta != null) {
                customer.metadata = meta;
                meta.move(customer);
            }
            self.customers.insert(id, customer);

            // init all plan entitlement meters for this new customer
            // all plan meters are a synced starting point
            const now = Time::now();
            for (const pair in pn.entitlements.fields()) {
                const name = pair[0];
                const ent = pair[1];
                if (typeof ent == 'obj' && ent.limit != null) {
                    ent as Entitlement;
                    const met = new Meter {
                        credit: ent.limit.credit,
                        started: now,
                    } on customer.meters;
                    customer.meters.insert(name, met);
                }
            }

            // init alternative ids
            if (alts != null) for (const alt in alts) self.set_alt_customer_id(id, alt, false);

            self.ensure_included_topups(id, false);
            await <Event>.send('customer-set', customer);
            return customer;
        }
        null
    }


    /**
     * Set/create a customer with an id & internal Stof.
     */
    fn set_customer(stof: str!, event: bool = true) -> Customer {
        const sub = new {} on self.customers;
        try {
            parse(stof, sub, 'stof');
        } catch {
            drop(sub);
            return null;
        }
        const id = sub.id ?? nanoid();
        sub.id = id;
        self.customers.remove(id, shallow = false);
        self.customers.insert(id, sub as Customer);
        for (const alt in sub.alt_ids ?? []) self.set_alt_customer_id(id, alt, false);
        if (event) await <Event>.send('customer-set', sub);
        sub
    }


    /**
     * Delete a customer.
     */
    fn delete_customer(id: str!) -> bool {
        const customer = self.customer(id);
        if (customer != null) {
            await <Event>.send('customer-removed', customer);
            for (const alt in customer.alt_ids) self.delete_alt_customer_id(alt, false);
            return self.customers.remove(customer.id);
        }
        false
    }


    /**
     * Change a customer's plan ID.
     * Will initialize any meters for the new plan, optionally overwritting previous usage.
     */
    fn set_customer_plan(id: str!, plan: str!, overwrite_meters: bool = false) -> bool {
        const sub = self.customer(id);
        const prev = self.plan_for(id);
        const pn: Plan = self.plans.get(plan); // dont use self.plan(plan) because plan cannot be a customer ID here
        if (pn != null && sub != null && prev != pn) {
            sub.plan = plan;
            pn.name = plan;

            // init all plan entitlement meters for this new plan
            // all plan meters are a synced starting point
            let now = Time::now();

            // if not overwritting existing meters, try getting the first meter started on the current plan to set as "now" for new meters
            // this will mean that the meters will be relatively synced, depending on the new entitlement resets (might be immediately expired which is okay)
            if (!overwrite_meters && prev != null) {
                for (const pair in sub.meters.fields()) {
                    const entitlement = pair[0];
                    const met: Meter = pair[1];
                    // prev plan must include the entitlement to prevent ancient syncs
                    if (prev.entitlements.get(entitlement) != null && met.started < now) {
                        now = met.started;
                    }
                }
            }

            for (const pair in pn.entitlements.fields()) {
                const name = pair[0];
                const ent = pair[1];
                if (typeof ent == 'obj' && ent.limit != null) {
                    ent as Entitlement;
                    const existing = sub.meters.get(name);
                    if (overwrite_meters || existing == null) {
                        if (existing != null) drop(existing); // replaced below (it would stay in the document otherwise)
                        const met = new Meter {
                            credit: ent.limit.credit,
                            started: now,
                        } on sub.meters;
                        sub.meters.insert(name, met);
                    }
                }
            }

            await <Event>.send('customer-set', sub);
            await <Event>.send_tmp('customer-plan-changed', new {
                previous_plan: prev != null ? prev.name : null,
                new_plan: plan,
                customer: sub,
            });
            return true;
        }
        false
    }


    /**
     * Get a customer's metadata object.
     */
    fn customer_metadata(id: str!) -> obj {
        const customer = self.customer(id);
        customer != null ? customer.metadata : null
    }


    /**
     * Get the customer refs for this customer ID.
     */
    fn customer_refs(id: str!) -> list {
        const sub = self.customer(id);
        sub != null ? sub.refs : null
    }


    /**
     * Set customer refs for this customer ID.
     */
    fn set_customer_refs(id: str!, refs: list!) -> bool {
        const sub = self.customer(id);
        if (sub != null) sub.refs = refs;
        sub != null
    }


    /**
     * Set an alternative customer ID (must be unique).
     */
    fn set_alt_customer_id(customer_id: str!, alt_id: str!, event: bool = true) -> bool {
        const customer = self.customer(customer_id);
        if (customer != null) {
            customer.alt_ids.remove_all(alt_id);
            customer.alt_ids.push_back(alt_id);
            self.alt_customer_ids.insert(alt_id, customer_id);
            if (event) await <Event>.send('customer-set', customer);
            return true;
        }
        false
    }


    /**
     * Delete an alternative customer ID.
     */
    fn delete_alt_customer_id(customer_id: str!, event: bool = true) -> bool {
        const customer = self.customer(customer_id);
        const res = self.alt_customer_ids.remove(customer_id);
        if (customer != null) {
            customer.alt_ids.remove_all(customer_id);
            if (event) await <Event>.send('customer-set', customer);
        }
        res
    }


    /**
     * Create a customer limit override.
     * Overrides are specific to customers, and they override the default
     * entitlement limit for that customer.
     *
     * If the customer already has an override for this entitlement, it will be replaced.
     */
    fn create_customer_override(customer_id: str!, entitlement: str!,
        expires?: ms, credit?: str, mode?: str, value?: float | str, increment?: float | str, resets?: bool, reset_inc?: ms, reset_sch?: str) -> Limit {
        
        // Get the customer and entitlement
        const ent = self.entitlement(customer_id, entitlement);
        const customer = self.customer(customer_id);
        if (customer == null || ent == null) return null;

        // get the entitlement limit (potentially overridden for a customer)
        // use these values for defaults if set
        let existing_limit = ent.limit;
        const override: Limit = customer.overrides.get(entitlement);
        if (override != null) existing_limit = override;

        // Create the limit
        if (reset_inc != null && reset_sch != null) return null; // mutually exclusive
        const limit = new Limit {
            credit: credit ?? existing_limit.credit ?? '',
            mode: mode ?? existing_limit.mode ?? 'hard',
            value: value ?? existing_limit.value ?? 0,
            increment: increment ?? existing_limit.increment ?? 0,
            resets: resets ?? existing_limit.resets ?? false,
            reset_inc: reset_inc ?? existing_limit.reset_inc,
            reset_sch: reset_sch ?? existing_limit.reset_sch,
            override_expires_on: expires ?? existing_limit.override_expires_on,
        };

        // Make sure a credit exists for this override (need to know what we're tracking)
        if (limit.credit == '' || self.credit(limit.credit) == null) {
            drop(limit);
            return null;
        }

        // Set the override on the customer and return
        customer.set_override(entitlement, limit);
        await <Event>.send('customer-set', customer);
        return limit;
    }


    /**
     * Remove a customer override (limit).
     */
    fn remove_customer_override(customer_id: str!, entitlement: str!) -> bool {
        const customer = self.customer(customer_id);
        if (customer != null) {
            const removed = customer.overrides.remove(entitlement, shallow = false);
            if (removed) await <Event>.send('customer-set', customer);
            return removed;
        }
        false
    }


    /**
     * Apply a plan topup to a customer.
     * Creates a credit grant with a topup/one-time-purchase if found.
     */
    fn apply_customer_topup(customer_id: str!, topup: str!) -> bool {
        const customer = self.customer(customer_id);
        const plan = self.plan_for(customer_id);
        if (plan != null && customer != null) {
            const top: Topup = plan.topups.get(topup);
            if (top != null) {
                const cred = self.credit(top.credit);
                if (cred != null) {
                    const units = cred.stof_units ?? 'float';
                    const grant = top.create_grant(units, customer.grants);
                    grant.topup = topup;
                    customer.grants.insert(grant.id, grant);

                    // Just the customer-topup-granted event, no customer-set here
                    await <Event>.send_tmp('customer-topup-granted', new {
                        customer,
                        topup_name: topup,
                        plan_name: plan.name,
                        topup: top,
                    });
                    return true;
                }
            }
        }
        false
    }


    /**
     * Ensure this customer has the included plan topups created as grants.
     * Call this for customers that should have included topup grants (maybe not all customers).
     * If not created here (recommended when using included grants), they will be lazily created when overage occurs.
     */
    fn ensure_included_topups(customer_id: str!, event: bool = true) {
        const customer = self.customer(customer_id);
        const plan = self.plan_for(customer_id);
        if (customer != null && plan != null && customer.update_topup_plan_grants(self, plan)) {
            if (event) await <Event>.send('customer-set', customer);
        }
    }


    /**
     * Ensure this customer is charged for one plan "subscription" credit quantity.
     * Call this for customers that should be accountable for a plan base subscripton price.
     * Not called automatically anywhere!
     *
     * Note: must create a credit and assign as the "subscription" entitlement on this plan.
     * Best practice is to call this just for the customers that are accountable for plan pricing (e.g. org).
     * Ex. pro plan with a monthly price of $200/mo.
     */
    fn ensure_plan_subscription(customer_id: str!) -> bool {
        const customer = self.customer(customer_id);
        if (customer != null) {
            // do not contemplate refs here... plan must be actually ON this customer
            // this is because not all customers will be accountable for a base plan price
            let pn = self.plans.get(customer.plan);
            if (pn != null) {
                const meter = customer.meters.get(pn.subscription);
                if (meter != null && meter.value < 1 && meter.started != null) {
                    if (pn.trial_period == null || (Time::now() - meter.started) >= (pn.trial_period as float)) {
                        return self.increment(customer_id, pn.subscription);
                    }
                }
            }
        }
        false
    }


    /*****************************************************************************
     * Spend caps
     *****************************************************************************/


    /**
     * Add a standing spend cap to a customer.
     *
     * `credit` defaults to 'rune' (Limitr's USD-pegged base currency) -
     * leaving it at the default gives you a USD-wide umbrella cap that
     * applies to spend on ANY entitlement with a path to rune, which
     * covers the common "cap this customer/pipeline at $N total" case
     * with no other configuration needed.
     *
     * If you instead name a specific, non-rune credit (e.g. 'ai_credits'),
     * `exchangeable` is inferred to be false unless you say otherwise -
     * naming a specific credit almost always means "watch THIS credit
     * only", not "watch everything that happens to convert into it".
     * Pass exchangeable explicitly to override either inference (e.g. an
     * 'ai_credits' cap you DO want other convertible credits to count
     * against too).
     *
     * `ignore_grants` (default false) controls whether this cap counts
     * spend that grants already covered for free. Leave it false for a
     * cap on raw consumption/overage regardless of grant coverage. Set
     * it true for a cap on what the customer actually ends up owing
     * beyond their free credits - e.g. "this customer gets 50 free
     * ai_credits/month, but their out-of-pocket spend should never
     * exceed $2" - the cap only starts accumulating once the grant runs
     * out, not from the first call.
     *
     * `id` lets you choose a stable, human-meaningful key (e.g.
     * 'pipeline-run-42') so the cap can be found again later for
     * reset_customer_cap/remove_customer_cap. If omitted, an id is
     * generated and returned to you via the created Cap's `id` field -
     * capture it from the return value if you didn't supply your own.
     *
     * Returns the created Cap (now owned by customer.caps), or null if
     * a cap with this id already exists on this customer (use
     * reset_customer_cap or remove_customer_cap first) or the credit
     * given doesn't resolve to a known credit/'rune'.
     */
    fn add_customer_cap(customer_id: str!, value: float | str!, id: str = '', credit: str! = 'rune',
        exchangeable?: bool, ignore_grants: bool = false, overage_only: bool = false, observe_only: bool = false, overhead_cost: bool = false, follow_decrements: bool = false, scope?: list, resets: bool = false, reset_inc?: ms, reset_sch?: str, expires_on?: ms,
        events: bool = true, hard_trailing: bool = false, shared: bool = false, shared_with?: list) -> Cap {
        const customer = self.customer(customer_id);
        if (customer == null) return null;
        if (credit != 'rune' && self.credit(credit) == null && ?self.exchange.get_pair(credit) == null) return null; // unknown credit, can't cap it

        id = id.len() > 0 ? id : nanoid();
        if (customer.caps.get(id) != null) return null; // id collision - caller should reset/remove first

        // Infer exchangeable when not explicitly given:
        // - 'rune' (the umbrella/default case) -> true, or the cap would never match anything
        // - a specific named credit -> false, since naming one credit usually means "just this one"
        if (exchangeable == null) {
            exchangeable = credit == 'rune' || self.credit(credit) == null;
        }

        // An exchangeable cap in a stairstep-priced credit can't be measured: converting other
        // spend into stairstep units is unbounded past the top band. (Exact-credit is fine.)
        if (exchangeable) {
            const resolved = self.exchange.resolve(credit);
            const priced: Credit = resolved != null ? resolved[1] : null;
            if (priced != null && priced.pricing_model == 'stairstep') return null;
        }
        if (reset_inc != null && reset_sch != null) return null; // mutually exclusive, mirrors Limit/Grant validation

        const cap = new Cap {
            id,
            credit,
            value,
            exchangeable,
            ignore_grants,
            overage_only,
            observe_only,
            overhead_cost,
            follow_decrements,
            hard_trailing,
            shared,
            shared_with: shared_with ?? null,
            scope: scope ?? null,
            created_on: Time::now(),
            started: Time::now(),
            resets,
            reset_inc: reset_inc,
            reset_sch: reset_sch,
            expires_on: expires_on,
        } on customer.caps;
        customer.caps.insert(id, cap);

        if (events) {
            await <Event>.send_tmp('customer-cap-added', new { customer, cap });
            await <Event>.send('customer-set', customer);
        }
        cap
    }


    /**
     * Returns the customer spend Cap (now owned by customer.caps), or null if not present.
     */
    fn customer_cap(customer_id: str!, id: str!) -> Cap {
        const customer = self.customer(customer_id);
        customer == null ? null : customer.caps.get(id)
    }


    /**
     * Reset a customer's spend cap back to zero consumption (meter_value),
     * without removing the cap itself or changing its ceiling/value,
     * credit, scope, or schedule. Also restarts its reset-period clock
     * (`started`/`last_reset`) from now, the same as a natural period
     * rollover would.
     *
     * Use this for the "reset, don't remove" case - e.g. a recurring
     * per-customer cap you want to manually zero out early, distinct
     * from removing it (remove_customer_cap) when it's no longer needed
     * at all.
     *
     * Returns false if no cap with this id exists on this customer.
     */
    fn reset_customer_cap(customer_id: str!, id: str!, events: bool = true) -> bool {
        const customer = self.customer(customer_id);
        if (customer == null) return false;

        const cap: Cap = customer.caps.get(id);
        if (cap == null) return false;

        cap.meter_value = 0;
        cap.started = Time::now();
        cap.last_reset = cap.reset_sch != null ? Time::now() : null;

        if (events) {
            await <Event>.send_tmp('customer-cap-reset', new { customer, cap });
            await <Event>.send('customer-set', customer);
        }
        true
    }


    /**
     * Remove a standing spend cap from a customer entirely - it no
     * longer applies to any future calls. Distinct from reset_customer_cap,
     * which zeroes consumption but keeps the cap (and its ceiling) active.
     *
     * This is the natural call to make at the end of a cap's intended
     * scope - e.g. removing a pipeline-scoped USD cap once the pipeline
     * run that needed it has finished.
     *
     * Returns false if no cap with this id exists on this customer.
     */
    fn remove_customer_cap(customer_id: str!, id: str!, events: bool = true) -> bool {
        const customer = self.customer(customer_id);
        if (customer == null) return false;

        const removed = customer.caps.remove(id, shallow = false);
        if (removed && events) {
            await <Event>.send_tmp('customer-cap-removed', new { customer, id });
            await <Event>.send('customer-set', customer);
        }
        removed
    }


    /*****************************************************************************
     * Plans & credits
     *****************************************************************************/


    /**
     * Get a plan by ID (either a plan ID or a customer ID).
     */
    fn plan(id: str!, default: bool = true) -> Plan {
        let pn = self.plans.get(id);
        if (pn != null) {
            pn.name = id;
            return pn;
        }
        pn = self.plan_for(id, false);
        if (pn == null && default) pn = self.default_plan();
        pn
    }


    /**
     * Get a plan by customer ID.
     */
    fn plan_for(customer_id: str!, default: bool = true) -> Plan {
        const customer = self.customer(customer_id);
        if (customer != null) {
            let pn = self.plans.get(customer.plan);
            if (pn != null) pn.name = customer.plan;

            if (pn == null && customer.refs.any()) {
                for (const ref in customer.refs) {
                    pn = self.plan_for(ref, false);
                    if (pn != null) break;
                }
            }
            if (pn == null && default) pn = self.default_plan();
            return pn;
        }
        null
    }


    /**
     * Get the (first) default plan in this policy.
     */
    fn default_plan() -> Plan {
        for (const pair in self.plans.fields()) {
            const plan: Plan = pair[1];
            if (plan.default) {
                plan.name = pair[0];
                return plan;
            }
        }
        null
    }


    /**
     * Set/create a plan with a name & internal Stof.
     */
    fn set_plan(id: str!, internal_stof: str!) -> Plan {
        self.delete_plan(id);
        const plan = new {} on self.plans;
        try {
            parse(internal_stof, plan, 'stof');
        } catch {
            drop(plan);
            return null;
        }
        plan.name = id;
        self.plans.insert(id, plan);
        await <Event>.send('plan-set', plan as Plan);
        plan
    }


    /**
     * Delete a plan by plan ID.
     * Be careful, as customers that have this plan will no longer work as expected.
     */
    fn delete_plan(id: str!) -> bool {
        const plan = self.plans.get(id);
        if (plan != null) {
            await <Event>.send('plan-removed', plan);
        }
        self.plans.remove(id, shallow = false)
    }


    /**
     * Plan period.
     */
    fn plan_period(id: str!) -> str {
        const plan = self.plan(id);
        plan != null ? plan.period : null
    }


    /**
     * Plan trial period in ms (optional).
     * Accepts a plan ID or customer ID. Unitless trial_period values are treated as ms.
     */
    fn plan_trial_period(id: str!) -> ms {
        const plan = self.plan(id);
        plan != null && plan.trial_period != null ? (plan.trial_period as float) : null
    }


    /**
     * Plan subscription entitlement.
     * This is the entitlement to update for a base plan price (typically only once).
     */
    fn plan_sub_entitlement_name(id: str!) -> str {
        const plan = self.plan(id);
        plan != null ? plan.subscription : null
    }


    /**
     * Get a global credit type.
     */
    fn credit(id: str!) -> Credit {
        self.credits.get(id)
    }


    /**
     * Get a credit type for a specific entitlement (that has a limit).
     * ID can be a plan ID or a customer ID.
     */
    fn credit_for(id: str!, entitlement: str!) -> Credit {
        const pair = self.customer_entitlement(id, entitlement);
        if (pair != null) {
            const limit = self.customer_entitlement_limit(pair[0], entitlement, pair[1]);
            if (limit != null) return self.credit(limit.credit);
        }
        null
    }


    /**
     * Exchange some of one credit for another (if possible).
     */
    fn credit_exchange(in_currency: str!, out_currency: str!, value: float! = 1) -> float {
        self.exchange.exchange(value, in_currency, out_currency)
    }


    /*****************************************************************************
     * Margins
     *****************************************************************************/


    /**
     * Get a customer's local & current snapshot margin (((revenue - cost)/revenue) * 100).
     * Meant to be a quick & rough "are we making money on this customer right now?" check.
     * Uses the current period of each meter (like value()/remaining()); does not take
     * grants/topups into consideration. Cost is the overhead actually recorded this period.
     */
    fn customer_local_margin_breakdown(customer_id: str!) -> map {
        const customer = self.customer(customer_id);
        const plan = self.plan_for(customer_id);
        if (customer == null || plan == null) return null;

        let cost: float = 0;
        let revenue: float = 0;
        const entitlements_map: map = map();
        for (const pair in plan.entitlements.fields()) {
            const name = pair[0];
            const ent: Entitlement = pair[1];
            const meter: Meter = customer.meters.get(name);
            const limit = self.customer_entitlement_limit(customer, name, ent); // might be overridden

            if (limit != null && meter != null) {
                const credit = self.credit(limit.credit);
                if (credit != null) {
                    const current = self.period_value(limit, meter); // current period, read-only
                    const limit_value = (limit.value as float).to_units(credit.stof_units);

                    const ent_cost = self.period_overhead(limit, meter, credit); // recorded actual overhead this period
                    cost += ent_cost;
                    let ent_rev = 0;
                    if (current > limit_value) {
                        const overage = (current - limit_value).remove_units();
                        ent_rev = credit.price_of(overage) ?? 0; // billable units, from the first tier
                    }
                    
                    revenue += ent_rev;
                    entitlements_map.insert(name, map(
                        ('cost', ent_cost),
                        ('revenue', ent_rev),
                        ('margin', ent_rev > 0 ? (((ent_rev - ent_cost)/ent_rev) * 100).round(2) : null)
                    ));
                }
            }
        }

        return {
            'revenue': revenue,
            'cost': cost,
            'margin': revenue > 0 ? (((revenue - cost)/revenue) * 100).round(2) : -100,
            'entitlements': entitlements_map,
        };
    }


    /**
     * Get a local & current snapshot margin (((revenue - cost)/revenue) * 100).
     * Meant to be a quick & rough "are we making money with this setup?" check.
     * Does not take time (resets) nor grants/topups into consideration.
     * If scaled, will put meter values and limits in terms of the plan period.
     * Cost uses each credit's overhead() cost function; a map entry can pass 'overhead' (runes, for that
     * meter value) or 'context' (an obj for the cost function) instead.
     */
    fn local_margin_breakdown(plan_id: str!, entitlements: map!, scaled: bool = true) -> map {
        const plan = self.plan(plan_id);
        if (plan == null) return null;

        let cost: float = 0;
        let revenue: float = 0;
        let plan_period: ms = plan.period_time();

        const entitlements_map: map = map();
        ^entitlement_loop for (const pair in entitlements) {
            const name = pair[0];
            const ent = pair[1];
            let meter_value: float = 0;
            let credit_name: str = null;
            let limit_value: float = 0;

            let ent_overhead: float = null;
            let ent_context: obj = null;

            let set_ent_limit_val = false;
            let ent_type = typeof ent;
            if (ent_type == 'map') {
                meter_value = ent.get('meter');
                credit_name = ent.get('credit');
                limit_value = ent.get('limit');
                ent_overhead = ent.get('overhead');
                const ctx = ent.get('context');
                if (typeof ctx == 'obj') ent_context = ctx;
                set_ent_limit_val = limit_value == null;
                limit_value = limit_value ?? 0;
            } else if (ent_type == 'float' || ent_type == 'int' || ent_type == 'str') {
                meter_value = ent;
                set_ent_limit_val = true;
            } else {
                // Not a valid entitlement value
                continue ^entitlement_loop;
            }
            
            let adjusted_meter_period = null;
            if (credit_name == null || scaled) {
                const e: Entitlement = plan.entitlements.get(name);
                if (e != null && e.limit != null) {
                    if (credit_name == null) credit_name = e.limit.credit;
                    if (set_ent_limit_val) {
                        limit_value = e.limit.value as float;
                    }
                    // Scale the limit_value to the plan period, not the individual meter period.
                    // Skipped for calendar schedules (reset_sch) since there is no fixed ms duration to divide by.
                    const inc = e.limit.reset_increment();
                    if (scaled && inc != null && inc != plan_period) {
                        limit_value *= (plan_period/inc).remove_units();
                        adjusted_meter_period = inc;
                    }
                }
            }

            if (meter_value != null && credit_name != null) {
                const credit = self.credit(credit_name);
                if (credit != null) {
                    let current = (meter_value as float).to_units(credit.stof_units);
                    if (adjusted_meter_period != null) {
                        current *= (plan_period/adjusted_meter_period).remove_units();
                    }

                    // explicit overhead (runes) for the modeled usage, else the credit's cost function (optional context)
                    let ent_cost: float = ent_overhead;
                    if (ent_cost == null) ent_cost = self.call_overhead(current, credit, ent_context);
                    else if (adjusted_meter_period != null) ent_cost *= (plan_period/adjusted_meter_period).remove_units();
                    cost += ent_cost;
                    let ent_rev = 0;
                    if (current > limit_value) {
                        const overage = (current - limit_value).remove_units();
                        ent_rev = credit.price_of(overage) ?? 0; // billable units, from the first tier
                    }
                    
                    revenue += ent_rev;
                    entitlements_map.insert(name, map(
                        ('cost', ent_cost),
                        ('revenue', ent_rev),
                        ('margin', ent_rev > 0 ? (((ent_rev - ent_cost)/ent_rev) * 100).round(2) : null)
                    ));
                }
            }
        }
        
        return {
            'revenue': revenue,
            'cost': cost,
            'margin': revenue > 0 ? (((revenue - cost)/revenue) * 100).round(2) : -100,
            'entitlements': entitlements_map,
        };
    }


    /*****************************************************************************
     * Notifications & capabilities
     *****************************************************************************/


    /**
     * Set a policy notification observer (overwrites existing if any).
     */
    fn set_notification(name: str!, note: Notification!) {
        const old = self.notifications.get(name);
        if (old != null) drop(old);
        note.move(self.notifications);
        self.notifications.insert(name, note);
    }


    /**
     * Set many imported notifications at once.
     * Goes through fields and sets all objects as notification observers in this self.
     */
    fn set_notifications(contents: unknown, format: str = 'stof') {
        using tmp = new {};
        try {
            parse(contents, tmp, format);
            for (const field in tmp.fields()) {
                const note = field[1];
                if (typeof note == 'obj') {
                    self.set_notification(field[0], note as Notification);
                }
            }
        } catch {
            // Nada..
        }
    }


    /**
     * Get a policy capability by name.
     */
    fn capability(name: str!) -> Capability {
        let cp = self.capabilities.get(name);
        if (cp != null) {
            cp.name = name;
            return cp;
        }
        null
    }


    /**
     * Set a policy capability (overwrites existing if any).
     */
    fn set_capability(cap: Capability!) {
        const old = self.capability(cap.name);
        if (old != null) drop(old);
        cap.move(self.capabilities);
        self.capabilities.insert(cap.name, cap);
    }


    /**
     * Set many imported capabilities at once.
     * Goes through fields and sets all objects as capabilities in this self.
     */
    fn set_capabilities(contents: unknown, format: str = 'stof') {
        using tmp = new {};
        try {
            parse(contents, tmp, format);
            for (const field in tmp.fields()) {
                const cap = field[1];
                if (typeof cap == 'obj') {
                    // name, cast, & move to the correct location in doc
                    if (cap.name == null || cap.name.len() < 1) cap.name = field[0];
                    self.set_capability(cap as Capability);
                }
            }
        } catch {
            // Nada..
        }
    }


    /**
     * Run capability.
     * Args is map<string, unknown>.
     */
    fn run_capability(name: str!, args: map = map(), customer_id?: str) -> unknown {
        const cp = self.capability(name);
        if (cp != null) {
            if (customer_id != null) {
                const pn = self.plan_for(customer_id);
                const plan = pn == null ? null : pn.name;
                if (!cp.access(plan, customer_id)) return null;
            }

            drop(cp.input);
            cp.input = new {} on cp;
            for (const pair in args) {
                cp.input.insert(pair[0], copy(pair[1]));
            }
            drop(cp.output);
            cp.output = new {} on cp;
            cp.run();
            return cp.get_result();
        }
        null
    }


    /**
     * Claude tool definitions for this policy's capabilities, as JSON ({ "tools": [...] }).
     * With a customer ID, only the capabilities that customer can use.
     */
    fn claude_tools(customer_id?: str) -> str {
        using arena = new {};
        const pn = customer_id == null ? null : self.plan_for(customer_id);
        const plan = pn == null ? null : pn.name;
        const tools = [];
        for (const pair in self.capabilities.fields()) {
            const cp: Capability = pair[1];
            if (customer_id == null || cp.access(plan, customer_id)) tools.push_back(cp.claude_tool(arena));
        }
        arena.tools = tools;
        stringify('json', arena)
    }


    /**
     * Run a Claude tool_use block (JSON) against the matching capability and return the tool_result as JSON.
     * Null if no capability matches, or the customer can't use it.
     */
    fn claude_tool_use(tool_use_json: str!, customer_id?: str) -> str {
        using arena = new {};
        parse(tool_use_json, arena, 'json');
        const cp = arena.name != null ? self.capability(arena.name) : null;
        if (cp == null) return null;
        if (customer_id != null) {
            const pn = self.plan_for(customer_id);
            if (!cp.access(pn == null ? null : pn.name, customer_id)) return null;
        }
        if (!cp.claude_tool_use(arena)) return null;
        cp.run();
        stringify('json', cp.claude_tool_result(arena, arena))
    }


    /*****************************************************************************
     * Sync
     * Used by SDKs and Limitr Cloud to update a running policy and its customers.
     *****************************************************************************/


    /**
     * Get self BSTF.
     */
    fn policy_bstf() -> blob {
        blobify('bstf', self)
    }


    /**
     * Generate a diff JSON string with a different self BSTF.
     * This self is treated as the "schema" for this operation, and will not be modified.
     */
    fn difference_bstf(bstf: blob, symmetric: bool = false) -> str {
        let out = '{}';
        try {
            using other = new {};
            parse(bstf, other, 'bstf');
            self.diff(other, symmetric);
            out = stringify('json', other);
        } catch {
            out = '{ "error": "could not process BSTF for self diff" }';
        }
        out
    }


    /**
     * Replace the current active self internals in this document with a new one.
     */
    fn update_policy_internals(updated: unknown!, format: str! = 'json') {
        using p = new {}; // what's left of it after moving the parts in is dropped on return
        try {
            parse(updated, p, format);
            if (typeof p.policy.plans == 'obj') {
                self.remove('plans', shallow = false);
                self.plans = p.policy.plans;
                p.policy.plans.move(self);
            }
            if (typeof p.policy.credits == 'obj') {
                self.remove('credits', shallow = false);
                self.credits = p.policy.credits;
                p.policy.credits.move(self);
            }
            if (typeof p.policy.notifications == 'obj') {
                for (const pair in p.policy.notifications.fields()) {
                    self.set_notification(pair[0], pair[1]);
                }
            }
            if (typeof p.policy.exchange == 'obj') {
                self.exchange.grant_strategy = p.policy.exchange.grant_strategy ?? 'expires_first';
                for (const pair in p.policy.exchange.fields()) {
                    const name = pair[0];
                    const val = pair[1];
                    if (typeof val == 'obj') {
                        self.exchange.remove(name, shallow = false);
                        self.exchange.insert(name, val);
                        val.move(self.exchange);
                    }
                }
            }
            if (typeof p.limitr_cloud == 'obj') {
                root.remove('limitr_cloud', shallow = false);
                root.limitr_cloud = p.limitr_cloud;
                p.limitr_cloud.move(root);
            }
            if (typeof p.policy.capabilities == 'obj') {
                for (const pair in p.policy.capabilities.fields()) {
                    const name = pair[0];
                    const cap: Capability = pair[1];
                    if (cap.name == null || cap.name.len() < 1) cap.name = name;
                    self.set_capability(cap);
                }
            }
            if (typeof p.policy.customers == 'obj') {
                for (const pair in p.policy.customers.fields()) {
                    const id = pair[0];
                    const existing = self.customers.get(id);
                    if (existing == null) {
                        const c = pair[1];
                        self.customers.insert(id, c);
                        c.move(self.customers);
                        for (const alt in c.alt_ids) self.alt_customer_ids.insert(alt, id);
                    }
                }
            }

            await <Event>.send('internal-self-updated');
        } catch {
            // Nada...
        }
    }


    /**
     * Replace a customer internals within this Limitr self.
     */
    fn update_customer_internals(customer: str!, format: str! = 'json') {
        const c = new {} on self.customers;
        try {
            parse(customer, c, format);
            const id = c.id ?? nanoid();
            c.id = id;
            self.customers.remove(id, shallow = false);
            self.customers.insert(id, c as Customer);
            for (const alt in c.alt_ids ?? []) self.set_alt_customer_id(id, alt, false);
            if (c.metadata != null && c.metadata.limitr_voucher != null && c.metadata.limitr_voucher_expires != null) {
                if (c.metadata.limitr_voucher_expires <= Time::now() || (c.metadata.limitr_voucher_runes != null && c.metadata.limitr_voucher_runes <= 0)) {
                    const vchr = c.metadata.limitr_voucher;
                    for (const pair in self.capabilities.fields()) {
                        const cap: Capability = pair[1];
                        if (cap.voucher == vchr || (cap.customers != null && cap.customers.len() == 1 && cap.customers.contains(vchr))) {
                            self.capabilities.remove(pair[0], shallow = false);
                        } else if (cap.customers != null) {
                            cap.customers.remove_all(vchr);
                        }
                    }
                }
            }
            await <Event>.send('internal-customer-updated', c);
        } catch {
            drop(c);
        }
    }


    /**
     * Set customer invoices data within this self.
     */
    fn update_customer_invoices(content: str!, format: str! = 'json') {
        const i = new {} on self;
        try {
            parse(content, i, format);
            const id = i.id ?? nanoid();
            i.id = id;
            if (self.invoices == null) self.invoices = new {} on self;
            self.invoices.remove(id, shallow = false);
            i.move(self.invoices);
            self.invoices.insert(id, i);
            await <Event>.send('internal-customer-invoices-updated', i);
        } catch {
            drop(i);
        }
    }


    /*****************************************************************************
     * Internal
     * Helpers for the functions above. Not part of the public API: they may change in any release.
     *****************************************************************************/


    // Resolving a call --------------------------------------------------------


    /**
     * Customer entitlement pair.
     */
    fn customer_entitlement(customer_id: str!, entitlement: str!) -> (Customer, Entitlement) {
        let customer = self.customer(customer_id);
        if (customer != null) {
            const ent = self.entitlement(customer_id, entitlement);
            if (ent != null) {
                // Entitlement scope: the nearest customer of that type through the refs chain.
                // No such customer -> no entitlement (never metered on the caller instead).
                if (ent.scope != null && ent.scope != customer.type) {
                    let scoped = null;
                    for (const candidate in self.ref_customers(customer)) {
                        if (candidate.type == ent.scope) {
                            scoped = candidate;
                            break;
                        }
                    }
                    if (scoped == null) return null;
                    customer = scoped;
                }
                return (customer, ent);
            }
        }
        null
    }


    /**
     * Customer entitlement limit.
     */
    fn customer_entitlement_limit(customer?: Customer, entitlement?: str, ent?: Entitlement) -> Limit {
        if (customer == null || entitlement == null || ent == null) return null;
        let limit = ent.limit;
        const override: Limit = customer.overrides.get(entitlement);
        if (override != null) {
            if (override.override_expires_on != null && Time::now() >= override.override_expires_on) {
                customer.overrides.remove(entitlement, shallow = false);
            } else {
                limit = override;
            }
        }
        limit
    }


    /**
     * Customers reachable through `customer`'s refs, transitively and nearest first
     * (breadth-first). Each customer appears once; cycles and repeats are skipped;
     * `customer` itself is never included.
     */
    fn ref_customers(customer: Customer!) -> list {
        const out = [];
        const seen = set(customer.id);
        const queue = [customer];
        while (queue.any()) {
            const current = queue.pop_front();
            for (const ref in current.refs) {
                const found = self.customer(ref);
                if (found != null && !seen.contains(found.id)) {
                    seen.insert(found.id);
                    out.push_back(found);
                    queue.push_back(found);
                }
            }
        }
        out
    }


    /**
     * Shared caps that apply to a call made by `caller`: every current `shared` cap on the
     * customers reachable through its refs, filtered by `shared_with` (caller type).
     * Expired shared caps are removed from their holder.
     */
    fn shared_caps_for(caller: Customer!) -> list {
        const out = [];
        for (const holder in self.ref_customers(caller)) {
            for (const pair in holder.caps.fields()) {
                const cap: Cap = pair[1];
                if (!cap.shared) continue;
                if (cap.shared_with != null && cap.shared_with.any() && !cap.shared_with.contains(caller.type)) continue;
                if (!cap.ensure_current()) {
                    holder.caps.remove(pair[0], shallow = false);
                    continue;
                }
                out.push_back(cap);
            }
        }
        out
    }


    /**
     * The customer holding a stored cap (null for ephemeral/unattached caps).
     */
    fn cap_holder(cap: Cap!) -> Customer {
        const caps_obj = cap.parent();
        const holder = caps_obj != null ? caps_obj.parent() : null;
        holder != null && holder.instance_of('Customer') ? holder : null
    }


    // Periods -----------------------------------------------------------------


    /**
     * Is a period reset pending for this meter (the next allow() will start a new period)?
     * Read-only.
     */
    fn meter_reset_pending(limit?: Limit, meter?: Meter) -> bool {
        limit != null && meter != null && meter.started != null && limit.reset_pending(meter.started, Time::now())
    }


    /**
     * Meter value for the current period - 0 when a period reset is pending.
     * Read-only: reads see the new period without having to wait for an allow().
     */
    fn period_value(limit?: Limit, meter?: Meter) -> float {
        if (meter == null) return 0;
        self.meter_reset_pending(limit, meter) ? 0 : meter.value
    }


    /**
     * Provider overhead spent on a meter in the current period (runes) - 0 when a period reset is pending.
     * Meters from before 0.7.0 have no record, so they fall back to value * the credit's fixed rate.
     */
    fn period_overhead(limit?: Limit, meter?: Meter, credit?: Credit) -> float {
        if (meter == null || self.meter_reset_pending(limit, meter)) return 0;
        if (meter.overhead != null) return meter.overhead;
        credit != null ? (meter.value * (credit.overhead_cost ?? 0)).remove_units() : 0
    }


    /**
     * Compute the next calendar period boundary after now for a given schedule.
     * Uses Time::add_months or Time::add_days to step into the next period,
     * then calls Time::start_of_period to find its start.
     */
    fn next_period_start(now: ms, reset_sch: str) -> ms {
        let next_ts = now;
        if (reset_sch.starts_with('weekly')) next_ts = Time::add_days(now, 7);
        else if (reset_sch.starts_with('yearly')) next_ts = Time::add_months(now, 12);
        else if (reset_sch.starts_with('quarterly')) next_ts = Time::add_months(now, 3);
        else next_ts = Time::add_months(now, 1);
        // Note: for nth_weekday schedules, returns null if the Nth occurrence
        // doesn't exist in the target month (e.g. 5th Tuesday in a short month).
        // Callers should handle null gracefully.
        Time::start_of_period(next_ts, reset_sch)
    }


    // Pricing & events --------------------------------------------------------


    /**
     * Provider overhead (runes) for one call of `units` of a credit.
     * The host's actual cost (`overhead`) wins; otherwise the credit's overhead() cost function with the
     * call's context (event data). If that function throws or returns a non-number, the fixed rate is used.
     */
    fn call_overhead(units: float, credit?: Credit, context?: obj, overhead?: float) -> float {
        if (overhead != null) return (overhead as float).remove_units();
        if (credit == null || units == 0) return 0;
        try {
            const cost = credit.overhead(units, context);
            if (cost != null) return (cost as float).remove_units();
        } catch (e: str) {
            err(`Limitr: overhead() for credit '${Obj::name(credit)}' failed, using overhead_cost: ${e}`);
        }
        (units * (credit.overhead_cost ?? 0)).remove_units()
    }


    /**
     * Runes for `units` of a credit from billable position `position` (Exchange.to_runes). A priced credit
     * with no exchange pair of its own prices itself, which is what the exchange would resolve to anyway.
     * Null when it has no price.
     */
    fn price_units(credit_name: str!, units: float, position: float = 0, credit?: Credit) -> float {
        if (credit != null && credit.priced() && self.exchange.get_pair(credit_name) == null) return credit.price_of(units, position);
        self.exchange.to_runes(units, credit_name, position)
    }


    /**
     * Round an outgoing event's numbers to 1e-9 (top level, plus its `meter` and `governor`
     * objects). Storage keeps full precision so sub-nano amounts still accumulate; this only
     * keeps drift like 0.30000000000000004 out of notifications, host handlers, and Cloud.
     */
    fn round_event(event: obj) {
        for (const target in [event, event.meter, event.governor]) {
            if (typeof target != 'obj') continue;
            for (const pair in target.fields()) {
                if (typeof pair[1] == 'float') target.insert(pair[0], Num::round(pair[1], 9));
            }
        }
    }


    /**
     * Send a cap-limit event: `cap` denied a call before anything changed. `customer` is the customer
     * holding the cap (the caller for call-scoped caps), `caller` the customer the call was made as.
     */
    fn send_cap_limit(cap: Cap!, caller: Customer!, entitlement: str!, meter: obj!, arena: obj!, plan?: str, credit?: Credit, event_data?: obj) {
        const event_value = new {
            customer: self.cap_holder(cap) ?? caller,
            caller,
            entitlement,
            plan,
            credit,
            cap,
            meter,
            event_data,
        } on arena;
        const notes: Notifications = self.notifications;
        self.round_event(event_value);
        await notes.handle_event('cap-limit', event_value);
        await <Event>.send('cap-limit', event_value);
    }


    /**
     * Resolve a context (event data) argument: an obj, a Stof/JSON string, or anything else (null).
     * Returns (obj, created) - drop the obj when created is true.
     */
    fn resolve_context(context: obj | str | bool = null) -> (obj, bool) {
        if (typeof context == 'obj') return (context, false);
        if (typeof context == 'str' && context.len() > 0) {
            const ctx = new {};
            try {
                parse(context, ctx, 'stof');
                return (ctx, true);
            } catch {
                drop(ctx);
            }
        }
        (null, false)
    }


    // Estimates ---------------------------------------------------------------


    /**
     * The policy-wide estimate for an entitlement and segment (created when `create`).
     */
    fn policy_estimate(entitlement: str!, segment?: str, create: bool = false) -> Estimate {
        const key = <Estimate>.key(segment);
        if (self.estimates == null) {
            if (!create) return null;
            self.estimates = new {};
        }
        let bucket = self.estimates.get(entitlement);
        if (bucket == null) {
            if (!create) return null;
            bucket = new {} on self.estimates;
            self.estimates.insert(entitlement, bucket);
        }
        let est: Estimate = bucket.get(key);
        if (est == null && create) {
            est = new Estimate {} on bucket;
            bucket.insert(key, est);
        }
        est
    }
}
