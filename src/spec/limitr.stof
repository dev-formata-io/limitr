#[type]
/**
 * A Limitr object.
 */
Limitr: {
    /// Limitr version.
    ver version: 0.5.38;

    /// Exchange rates.
    Exchange exchange: {};

    /// Credits.
    obj credits: {};

    /// Available plan definitions by ID.
    obj plans: {};

    /// Customers by ID.
    obj customers: {};

    /// Alternative customer ID mappings.
    obj alt_customer_ids: {};

    /// Capabilities.
    obj capabilities: {};


    #[no-export]
    #[type_ignore]
    /**
     * Static API.
     * <Limitr>.api.get();
     */
    api: {
        /// Get the top-level policy.
        /// Named root.policy.
        /// Or, any Limitr object on the root or obj with #[limitr].
        fn get() -> Limitr {
            const top = root.policy;
            if ((typeof top) == 'obj') return top;

            for (const pair in root.fields()) {
                if ((typeof pair[1]) == 'obj') {
                    if (pair[1].instance_of('Limitr') || root.attributes(pair[0]).contains('limitr')) {
                        return pair[1];
                    }
                }
            }
            null
        }


        /// Is the top-level policy valid?
        fn valid() -> bool {
            ?self.get().valid() ?? false
        }


        /// Set customer invoices data within this policy.
        fn update_customer_invoices(content: str!, format: str! = 'json') {
            const policy = self.get();
            if (policy == null) return;
            const i = new {} on policy;
            try {
                parse(content, i, format);
                const id = i.id ?? nanoid();
                i.id = id;
                if (policy.invoices == null) policy.invoices = new {} on policy;
                policy.invoices.remove(id, shallow = false);
                i.move(policy.invoices);
                policy.invoices.insert(id, i);
                await <Event>.send('internal-customer-invoices-updated', i);
            } catch {
                drop(i);
            }
        }


        /// Replace a customer internals within this Limitr policy.
        fn update_customer_internals(customer: str!, format: str! = 'json') {
            const policy = self.get();
            if (policy == null) return;
            const c = new {} on policy.customers;
            try {
                parse(customer, c, format);
                const id = c.id ?? nanoid();
                c.id = id;
                policy.customers.remove(id, shallow = false);
                policy.customers.insert(id, c as Customer);
                for (const alt in c.alt_ids ?? []) policy.set_alt_customer_id(id, alt, false);
                if (c.metadata != null && c.metadata.limitr_voucher != null && c.metadata.limitr_voucher_expires != null) {
                    if (c.metadata.limitr_voucher_expires <= Time.now() || (c.metadata.limitr_voucher_runes != null && c.metadata.limitr_voucher_runes <= 0)) {
                        const vchr = c.metadata.limitr_voucher;
                        for (const pair in policy.capabilities.fields()) {
                            const cap: Capability = pair[1];
                            if (cap.voucher == vchr || (cap.customers != null && cap.customers.len() == 1 && cap.customers.contains(vchr))) {
                                policy.capabilities.remove(pair[0], shallow = false);
                            } else if (cap.customers != null) {
                                cap.customers.remove_all(vchr);
                            }
                        }
                    }
                }
                await <Event>.send('internal-customer-updated', c);
            } catch {
                drop(c);
            }
        }


        /// Replace the current active policy internals in this document with a new one.
        /// Used to refresh this Limitr policies plans & credits (not customers).
        fn update_policy_internals(updated: str!, format: str! = 'json') {
            const policy = self.get();
            if (policy == null) return;
            const p = new {};
            try {
                parse(updated, p, format);
                if ((typeof p.policy.plans) == 'obj') {
                    policy.remove('plans', shallow = false);
                    policy.plans = p.policy.plans;
                    p.policy.plans.move(policy);
                }
                if ((typeof p.policy.credits) == 'obj') {
                    policy.remove('credits', shallow = false);
                    policy.credits = p.policy.credits;
                    p.policy.credits.move(policy);
                }
                await <Event>.send('internal-policy-updated');
            } catch {
                // Nada...
            }
            drop(p);
        }


        /// Get policy BSTF.
        fn policy_bstf() -> blob {
            const policy = self.get();
            blobify('bstf', policy)
        }


        /// Generate a diff JSON string with a different policy BSTF.
        /// This policy is treated as the "schema" for this operation, and will not be modified.
        fn difference_bstf(bstf: blob, symmetric: bool = false) -> str {
            const policy = self.get();
            if (policy == null) return '{ "error": "no policy found" }';
            let out = '{}';
            try {
                let other = new {};
                parse(bstf, other, 'bstf');
                policy.diff(other, symmetric);
                out = stringify('json', other);
                drop(other);
            } catch {
                out = '{ "error": "could not process BSTF for policy diff" }';
            }
            out
        }


        /*****************************************************************************
         * Capabilities.
         *****************************************************************************/
        
        /// Capability by name.
        fn capability(name: str!) -> Capability {
            ?self.get().capability(name)
        }

        /// Set many imported capabilities at once.
        /// Goes through fields and sets all objects as capabilities in this policy.
        fn set_capabilities(contents: unknown, format: str = 'stof') {
            const tmp = new {};
            const policy = ?self.get();
            if (policy == null) return;
            try {
                parse(contents, tmp, format);
                for (const field in tmp.fields()) {
                    const cap = field[1];
                    if ((typeof cap) == 'obj') {
                        // name, cast, & move to the correct location in doc
                        if (cap.name == null || cap.name.len() < 1) cap.name = field[0];
                        policy.set_capability(cap as Capability);
                    }
                }
            } catch {
                // Nada..
            }
            drop(tmp);
        }

        /// Run a capability.
        fn run_capability(name: str!, args: map = map(), customer_id?: str) -> unknown {
            ?self.get().run_capability(name, args, customer_id)
        }

        /// Claude tools JSON.
        /// Array is placed in "tools" field.
        fn claude_tools(customer_id?: str) -> str {
            const policy = self.get();
            if (policy == null) return null;
            const arena = new {};
            arena.tools = policy.claude_tools(arena, customer_id);
            const res = stringify('json', arena);
            drop(arena);
            res
        }

        /// Claude tool use.
        /// Runs the appropriate capability if found and returns a tool result JSON.
        fn claude_tool_use(tool_use_json: str!, customer_id?: str) -> str {
            const policy = self.get();
            if (policy == null) return null;
            const arena = new {};
            parse(tool_use_json, arena, 'json');
            let res = policy.claude_tool_use(arena, arena, customer_id);
            if (res != null) res = stringify('json', res);
            drop(arena);
            res
        }

        
        /*****************************************************************************
         * Plans.
         *****************************************************************************/
        
        /// Plan from ID (customer ID or plan ID).
        fn plan(id: str!, default: bool = true) -> Plan {
            ?self.get().plan(id, default)
        }

        /// Get the default plan if any.
        fn default_plan() -> Plan {
            ?self.get().default_plan()
        }

        /// Get a plan price (if any).
        fn plan_price(id: str!) -> Price {
            ?self.get().plan_price(id)
        }

        /// Get a plan price ID.
        fn plan_price_id(id: str!) -> str {
            ?self.get().plan_price_id(id)
        }

        /// Get a plan amount.
        fn plan_amount(id: str!) -> float {
            ?self.get().plan_amount(id)
        }

        /// Get a plan price label.
        fn plan_price_label(id: str!) -> str {
            ?self.get().plan_price_label(id)
        }

        /// Delete a plan by plan ID.
        /// Be careful, as customers that have this plan will no longer work as expected.
        fn delete_plan(id: str!) -> bool {
            ?self.get().delete_plan(id)
        }

        /// Set/create a plan with a name & internal Stof.
        fn set_plan(id: str!, internal_stof: str!) -> Plan {
            ?self.get().set_plan(id, internal_stof)
        }


        /*****************************************************************************
         * Entitlements.
         *****************************************************************************/
        
        /// Get a plan entitlement from a customer or plan ID.
        fn entitlement(id: str!, entitlement: str!) -> Entitlement {
            ?self.get().entitlement(id, entitlement)
        }

        /// Get the limit value for an entitlement.
        fn limit(id: str!, entitlement: str!) -> float {
            ?self.get().limit(id, entitlement)
        }

        /// Get the remaining balance value for a customer ID (limit - current (metered) value).
        fn remaining(id: str!, entitlement: str!) -> float {
            ?self.get().remaining(id, entitlement)
        }

        /// Get the current value of a metered entitlement for a customer ID.
        fn value(id: str!, entitlement: str!) -> float {
            ?self.get().value(id, entitlement)
        }

        /// Get the standard increment "cost" of an "increment" operation.
        fn cost(id: str!, entitlement: str!) -> float {
            ?self.get().cost(id, entitlement)
        }

        /// Change the value of a metered entitlement by a standard increment.
        fn increment(id: str!, entitlement: str!) -> bool {
            ?self.get().increment(id, entitlement)
        }

        /// Change the value of a metered entitlement by removing a standard increment.
        fn decrement(id: str!, entitlement: str!) -> bool {
            ?self.get().decrement(id, entitlement)
        }

        /// Allow this entitlement to change by "value"?
        /// A boolean entitlement check if value is 0 or a limit does not exist for the entitlement.
        /// Changes a meter for this customer if true.
        fn allow(id: str!, entitlement: str!, value: float = 0) -> bool {
            ?self.get().allow(id, entitlement, value)
        }

        /// Check if changing the value of a metered entitlement by a standard increment would be allowed.
        fn check_increment(id: str!, entitlement: str!) -> bool {
            ?self.get().check_increment(id, entitlement)
        }

        /// Check if changing the value of a metered entitlement by removing a standard increment would be allowed.
        fn check_decrement(id: str!, entitlement: str!) -> bool {
            ?self.get().check_decrement(id, entitlement)
        }

        /// Would "allow" be true if called with this "value"?
        fn check(id: str!, entitlement: str!, value: float = 0) -> bool {
            ?self.get().check(id, entitlement, value)
        }


        /*****************************************************************************
         * Credits.
         *****************************************************************************/
        
        /// Get a credit by ID/type.
        fn credit(id: str!) -> Credit {
            ?self.get().credit(id)
        }

        /// Get a credit type for a specific entitlement (limited/metered).
        /// ID can be a plan ID or a customer ID.
        fn credit_for(id: str!, entitlement: str!) -> Credit {
            ?self.get().credit_for(id, entitlement)
        }


        /*****************************************************************************
         * Customers.
         *****************************************************************************/
        
        /// Get a customer by ID.
        fn customer(id: str!) -> Customer {
            ?self.get().customer(id)
        }

        /// Get a customer's metadata object.
        fn customer_metadata(id: str!) -> obj {
            ?self.get().customer_metadata(id)
        }

        /// Get the customer refs for the customer ID.
        fn customer_refs(id: str!) -> list {
            ?self.get().customer_refs(id)
        }

        /// Change a customer's plan ID.
        fn set_customer_plan(id: str!, plan: str!, overwrite_meters: bool = true) -> bool {
            ?self.get().set_customer_plan(id, plan, overwrite_meters)
        }

        /// Create a new customer.
        fn create_customer(id: str!, plan: str! = '', type: str! = 'user', label: str! = 'User', refs?: list, alts?: list, metadata?: str | obj) -> Customer {
            ?self.get().create_customer(id, plan, type, label, refs, alts, metadata)
        }

        /// Set/create a customer with an id & internal Stof.
        fn set_customer(stof: str!, event: bool = true) -> Customer {
            ?self.get().set_customer(stof, event)
        }

        /// Delete a customer.
        fn delete_customer(id: str!) -> bool {
            ?self.get().delete_customer(id)
        }

        /// Set an alternative customer ID (must be unique).
        fn set_alt_customer_id(id: str!, alt: str!, event: bool = true) -> bool {
            ?self.get().set_alt_customer_id(id, alt, event)
        }

        /// Delete an alternative customer ID.
        fn delete_alt_customer_id(alt: str!, event: bool = true) -> bool {
            ?self.get().delete_alt_customer_id(alt, event)
        }

        /// Create a new customer override (limit).
        fn create_customer_override(id: str!, entitlement: str!, expires?: ms, credit?: str, mode?: str, value?: float | str, increment?: float | str, resets?: bool, reset_inc?: ms) -> Limit {
            ?self.get().create_customer_override(id, entitlement, expires, credit, mode, value, increment, resets, reset_inc)
        }

        /// Remove a customer override (limit).
        fn remove_customer_override(id: str!, entitlement: str!) -> bool {
            ?self.get().remove_customer_override(id, entitlement)
        }

        /// Apply a plan topup to a customer.
        fn apply_customer_topup(customer_id: str!, topup: str!) -> bool {
            ?self.get().apply_customer_topup(customer_id, topup)
        }

        /// Create a customer credit grant.
        fn create_customer_credit_grant(customer_id: str!, credit: str!, value: float | str, resets: bool = false, reset_inc?: ms, expires_on?: ms, event: bool = true) -> bool {
            ?self.get().create_customer_credit_grant(customer_id, credit, value, resets, reset_inc, expires_on, event)
        }
    }


    /**
     * Is this a valid policy?
     */
    fn valid() -> bool {
        ?<LimitrValidation>.error('');
        for (const pair in self.credits.fields()) {
            const credit: Credit = pair[1];
            if (!<Credit>.schemafy(credit)) return false;
        }
        for (const pair in self.plans.fields()) {
            const plan: Plan = pair[1];
            plan.name = pair[0];
            if (!<Plan>.schemafy(plan)) return false;
        }
        if (!<Exchange>.schemafy(self.exchange)) return false;
        for (const pair in self.exchange.fields()) {
            const key = pair[0];
            const val = pair[1];
            if ((typeof val) == 'obj' && key != 'rune') {
                val as ExchangePair;
                if (!<ExchangePair>.schemafy(val)) return false;
                if (self.credit(key) == null) return <LimitrValidation>.error(`A credit named "${key}" does not exist in this policy for use in credit exchange`);
                if (val.currency != 'rune' && self.credit(val.currency) == null) return <LimitrValidation>.error(`A credit named "${val.currency}" does not exist in this policy for use in credit exchange`);
                if (self.exchange.to_runes(1, val.currency) == null) return <LimitrValidation>.error(`Credit "${key}" exchange "${val.currency}" currency does not map to Limitr runes (broken conversions)`);
            }
        }
        true
    }


    /*****************************************************************************
     * Plans.
     *****************************************************************************/
    
    /**
     * Get a plan by ID (either a plan ID or a customer ID).
     */
    fn plan(id: str!, default: bool = true) -> Plan {
        let pn = self.plans.get(id);
        if (pn != null) {
            pn.name = id;
            return pn;
        }
        pn = self.plan_for(id, false);
        if (pn == null && default) pn = self.default_plan();
        pn
    }


    /**
     * Get a plan by customer ID.
     */
    fn plan_for(customer_id: str!, default: bool = true) -> Plan {
        const customer = self.customer(customer_id);
        if (customer != null) {
            let pn = self.plans.get(customer.plan);
            if (pn != null) pn.name = customer.plan;

            if (pn == null && customer.refs.any()) {
                for (const ref in customer.refs) {
                    pn = self.plan_for(ref, false);
                    if (pn != null) break;
                }
            }
            if (pn == null && default) pn = self.default_plan();
            return pn;
        }
        null
    }


    /**
     * Get the (first) default plan in this policy.
     */
    fn default_plan() -> Plan {
        for (const pair in self.plans.fields()) {
            const plan: Plan = pair[1];
            if (plan.default) {
                plan.name = pair[0];
                return plan;
            }
        }
        null
    }


    /**
     * Get a plan price (if any) by plan ID or by customer ID.
     */
    fn plan_price(id: str!) -> Price {
        const plan = self.plan(id);
        plan != null ? plan.price : null
    }


    /**
     * Get a plan price ID.
     */
    fn plan_price_id(id: str!) -> str {
        const price = self.plan_price(id);
        price != null ? price.id : null
    }


    /**
     * Get a plan amount.
     */
    fn plan_amount(id: str!) -> float {
        const price = self.plan_price(id);
        price != null ? price.amount : null
    }


    /**
     * Get a plan price label.
     */
    fn plan_price_label(id: str!) -> str {
        const price = self.plan_price(id);
        price != null ? price.label() : null
    }


    /**
     * Delete a plan by plan ID.
     * Be careful, as customers that have this plan will no longer work as expected.
     */
    fn delete_plan(id: str!) -> bool {
        const plan = self.plans.get(id);
        if (plan != null) {
            await <Event>.send('plan-removed', plan);
        }
        self.plans.remove(id, shallow = false)
    }


    /**
     * Set/create a plan with a name & internal Stof.
     */
    fn set_plan(id: str!, internal_stof: str!) -> Plan {
        self.delete_plan(id);
        const plan = new {} on self.plans;
        try {
            parse(internal_stof, plan, 'stof');
        } catch {
            drop(plan);
            return null;
        }
        plan.name = id;
        self.plans.insert(id, plan);
        await <Event>.send('plan-set', plan as Plan);
        plan
    }


    /*****************************************************************************
     * Capabilities.
     *****************************************************************************/
    
    /**
     * Get a policy capability by name.
     */
    fn capability(name: str!) -> Capability {
        let cp = self.capabilities.get(name);
        if (cp != null) {
            cp.name = name;
            return cp;
        }
        null
    }


    /**
     * Set a policy capability (overwrites existing if any).
     */
    fn set_capability(cap: Capability!) {
        const old = self.capability(cap.name);
        if (old != null) drop(old);
        cap.move(self.capabilities);
        self.capabilities.insert(cap.name, cap);
    }


    /**
     * Run capability.
     * Args is map<string, unknown>.
     */
    fn run_capability(name: str!, args: map = map(), customer_id?: str) -> unknown {
        const cp = self.capability(name);
        if (cp != null) {
            if (customer_id != null) {
                const pn = self.plan_for(customer_id);
                const plan = pn == null ? null : pn.name;
                if (!cp.access(plan, customer_id)) return null;
            }

            drop(cp.input);
            cp.input = new {} on cp;
            for (const pair in args) {
                cp.input.insert(pair[0], copy(pair[1]));
            }
            drop(cp.output);
            cp.output = new {} on cp;
            cp.run();
            return cp.get_result();
        }
        null
    }


    /**
     * Claude tools for capabilities.
     * Forced arena pattern for good stof practice.
     */
    fn claude_tools(arena: obj!, customer_id?: str) -> list {
        const tools = [];
        const pn = customer_id == null ? null : self.plan_for(customer_id);
        const plan = pn == null ? null : pn.name;
        for (const pair in self.capabilities.fields()) {
            const cp: Capability = pair[1];
            if (customer_id != null) {
                if (cp.access(plan, customer_id)) {
                    tools.push_back(cp.claude_tool(arena));
                }
            } else {
                tools.push_back(cp.claude_tool(arena));
            }
        }
        tools
    }


    /**
     * Claude tool use.
     * Runs the appropriate capability if found and returns a tool result or null.
     */
    fn claude_tool_use(tool_use: obj!, arena: obj!, customer_id?: str) -> obj {
        const name = tool_use.name;
        if (name == null) return null;
        const cp = self.capability(name);
        if (cp != null) {
            if (customer_id != null) {
                const pn = self.plan_for(customer_id);
                const plan = pn == null ? null : pn.name;
                if (!cp.access(plan, customer_id)) return null;
            }
            if (cp.claude_tool_use(tool_use)) {
                cp.run();
                return cp.claude_tool_result(tool_use, arena);
            }
        }
        null
    }


    /*****************************************************************************
     * Entitlements.
     *****************************************************************************/
    
    /**
     * Get a plan entitlement from either a customer ID or plan ID.
     */
    fn entitlement(id: str!, entitlement: str!) -> Entitlement {
        const pn: Plan = self.plan(id);
        if (pn != null) {
            return pn.entitlements.get(entitlement);
        }
        null
    }


    /**
     * Get the limit value for an entitlement.
     * Returns a value in the units of the meter (credit) (not always the same as defined limit units).
     * Ex. limit.value = 2GB, but credit.stof_units = 'MB', limit(..) => MB
     */
    fn limit(id: str!, entitlement: str!) -> float {
        const ent = self.entitlement(id, entitlement);

        // get the entitlement limit (potentially overridden for a customer)
        const customer = self.customer(id);
        let limit = ent != null ? ent.limit : null;
        if (customer != null) {
            const override: Limit = customer.overrides.get(entitlement);
            if (override != null) {
                if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                    // Nada..
                } else {
                    limit = override;
                }
            }
        }

        if (ent != null && limit != null && limit.mode != 'observe') {
            const credit = self.credit(limit.credit);
            const stof_units = credit != null ? credit.stof_units : 'float';
            const lim = limit.value as float; // can be a str w units
            return lim.to_units(stof_units);
        }
        null
    }


    /**
     * Get the remaining entitlement balance value for a customer ID (limit - current (metered) value).
     * Returns a value in the units of the meter (not always the same as defined limit units).
     */
    fn remaining(id: str!, entitlement: str!) -> float {
        let customer = self.customer(id);
        if (customer != null) {
            const ent = self.entitlement(id, entitlement);

            // get the entitlement limit (potentially overridden for a customer)
            let limit = ent != null ? ent.limit : null;
            const override: Limit = customer.overrides.get(entitlement);
            if (override != null) {
                if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                    // Nada..
                } else {
                    limit = override;
                }
            }

            if (ent != null && limit != null && limit.mode != 'observe') {
                // check entitlement scope for type of customer to use in refs (if different)
                if (ent.scope != null && ent.scope != customer.type) {
                    if (customer.refs.empty()) return null;
                    for (const ref in customer.refs) {
                        const tmp = self.customer(ref);
                        if (tmp != null && tmp.type == ent.scope) {
                            customer = tmp;
                            break;
                        }
                    }
                    if (customer == null) return null;
                }

                const credit = self.credit(limit.credit);
                const stof_units = credit != null ? credit.stof_units : 'float';

                const meter: Meter = customer.meters.get(entitlement);
                if (meter != null) return ((limit.value as float) - meter.value).to_units(stof_units);
                return (limit.value as float).to_units(stof_units);
            }
        }
        null
    }


    /**
     * Get the current value of a metered entitlement for a customer ID.
     * Returns null if the entitlement doesn't exist.
     */
    fn value(id: str!, entitlement: str!) -> float {
        let customer = self.customer(id);
        if (customer != null) {
            const ent = self.entitlement(id, entitlement);
            if (ent != null) {
                // check entitlement scope for type of customer to use in refs (if different)
                if (ent.scope != null && ent.scope != customer.type) {
                    if (customer.refs.empty()) return null;
                    for (const ref in customer.refs) {
                        const tmp = self.customer(ref);
                        if (tmp != null && tmp.type == ent.scope) {
                            customer = tmp;
                            break;
                        }
                    }
                    if (customer == null) return null;
                }

                const meter: Meter = customer.meters.get(entitlement);
                if (meter != null) {
                    return meter.value;
                } else if (self.entitlement(id, entitlement) != null) {
                    return 0;
                }
            }
        }
        null
    }


    /**
     * Get the standard increment "cost" of an "increment" operation for an entitlement.
     * Will return null if the entitlement doesn't exist.
     */
    fn cost(id: str!, entitlement: str!) -> float {
        const ent = self.entitlement(id, entitlement);

        // get the entitlement limit (potentially overridden for a customer)
        const customer = self.customer(id);
        let limit = ent != null ? ent.limit : null;
        if (customer != null) {
            const override: Limit = customer.overrides.get(entitlement);
            if (override != null) {
                if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                    // Nada..
                } else {
                    limit = override;
                }
            }
        }

        if (ent != null && limit != null) return limit.increment;
        null
    }


    /**
     * Change the value of a metered entitlement by a standard increment (defined in the Limit).
     */
    fn increment(id: str!, entitlement: str!) -> bool {
        const ent = self.entitlement(id, entitlement);

        // get the entitlement limit (potentially overridden for a customer)
        const customer = self.customer(id);
        let limit = ent != null ? ent.limit : null;
        if (customer != null) {
            const override: Limit = customer.overrides.get(entitlement);
            if (override != null) {
                if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                    // Nada..
                } else {
                    limit = override;
                }
            }
        }

        if (ent != null && limit != null) {
            return self.allow(id, entitlement, limit.increment);
        }
        false
    }


    /**
     * Change the value of a metered entitlement by removing a standard increment (defined in the limit).
     */
    fn decrement(id: str!, entitlement: str!) -> bool {
        const ent = self.entitlement(id, entitlement);

        // get the entitlement limit (potentially overridden for a customer)
        const customer = self.customer(id);
        let limit = ent != null ? ent.limit : null;
        if (customer != null) {
            const override: Limit = customer.overrides.get(entitlement);
            if (override != null) {
                if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                    // Nada..
                } else {
                    limit = override;
                }
            }
        }

        if (ent != null && limit != null) {
            return self.allow(id, entitlement, limit.increment * -1);
        }
        false
    }


    /**
     * Allow an entitlement for a customer to change by "value"?
     * A basic entitlement boolean check if value is 0 or a limit does not exist for an entitlement.
     */
    fn allow(id: str!, entitlement: str!, value: float | str = 0) -> bool {
        if ((typeof value) == 'str') value = value as float; // takes units into consideration too
        let customer = self.customer(id);
        if (customer != null) {
            const plan = self.plan_for(id);
            if (plan != null) {
                const ent: Entitlement = plan.entitlements.get(entitlement);
                if (ent != null) {
                    // check entitlement scope for type of customer to use in refs (if different)
                    if (ent.scope != null && ent.scope != customer.type) {
                        if (customer.refs.empty()) return null;
                        for (const ref in customer.refs) {
                            const tmp = self.customer(ref);
                            if (tmp != null && tmp.type == ent.scope) {
                                customer = tmp;
                                break;
                            }
                        }
                        if (customer == null) return null;
                    }

                    let existing_meter: Meter = customer.meters.get(entitlement);
                    let new_value: float = existing_meter != null ? existing_meter.value + value : value;

                    // get the entitlement limit (potentially overridden for this customer)
                    let limit = ent.limit;
                    const override: Limit = customer.overrides.get(entitlement);
                    if (override != null) {
                        if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                            customer.overrides.remove(entitlement, shallow = false);
                        } else {
                            limit = override;
                        }
                    }

                    // check if the new value should be reset!
                    // account for old meter.reset timestamp first
                    if (existing_meter != null && existing_meter.started == null) {
                        if (existing_meter.reset != null && limit != null) existing_meter.started = existing_meter.reset - limit.reset_inc;
                        else existing_meter.started = Time.now(); // fallback
                    }
                    let existing_meter_reset = false;
                    if (existing_meter != null && limit != null && limit.resets && limit.reset_inc > 0 && (Time.now() - existing_meter.started) > limit.reset_inc) {
                        const now = Time.now();
                        while ((now - existing_meter.started) > limit.reset_inc) existing_meter.started += limit.reset_inc;
                        new_value = value;
                        existing_meter_reset = true;
                    }

                    // put new_value into the credit's units, casting if needed (in case no units were given)
                    const credit = limit != null ? self.credit(limit.credit) : null;
                    const stof_units = credit != null ? (credit.stof_units ?? 'float') : 'float';
                    new_value = ?new_value.to_units(stof_units) ?? new_value;

                    // is the new value below a defined minimum?
                    if (limit != null && limit.minimum != null) {
                        const min_val = (limit.minimum as float).to_units(stof_units);
                        if (new_value < min_val) {
                            new_value = min_val;
                        }
                    }

                    let res = ent.check(new_value, override);

                    // create/change meter if there is a limit defined
                    // if not a valid value and mode is "soft", emit overage and allow
                    if (limit != null && (res || limit.mode == 'soft')) {
                        if (existing_meter == null) existing_meter = new Meter { started: Time.now() } on customer.meters;
                        const old_value = existing_meter.value;
                        const changed = new_value != old_value;
                        existing_meter.credit = limit.credit;
                        existing_meter.value = new_value;
                        customer.meters.insert(entitlement, existing_meter);
                        
                        if (changed) {
                            const event_value = new {
                                meter: new {
                                    old: old_value,
                                    value: new_value,
                                },
                                customer,
                                entitlement,
                                plan,
                                credit,
                                remaining: (limit.value as float).to_units(stof_units) - new_value,
                            };
                            let sent_overage = false;
                            if (!res) {
                                // contemplate credit grants for this customer before sending overage amount
                                // grants will modify event_value.overage for appropriate aggregation in the correct units
                                event_value.overage = new_value > old_value ? new_value - old_value : new_value - (event_value.remaining + new_value);
                                if (customer.apply_overage_grants(limit.credit, event_value, stof_units, self.exchange)) {

                                    // intercept here with voucher mode to protect your costs if using a voucher with max spend
                                    // if customer operating with a voucher and the voucher cannot cover the additional overage, return false!
                                    if (!customer.ensure_voucher(limit.credit, event_value, self.exchange)) {
                                        existing_meter.value = old_value;
                                        drop(event_value);
                                        return false;
                                    }

                                    sent_overage = true;
                                    await <Event>.send('meter-overage', event_value);
                                }
                            }
                            if (existing_meter_reset) await <Event>.send('meter-reset', event_value);
                            if (!sent_overage) await <Event>.send('meter-changed', event_value);
                            drop(event_value);
                        }

                        res = true; // meter was changed!
                    } else if (limit != null && !res) {
                        const event_value = new {
                            customer,
                            entitlement,
                            plan,
                            credit,
                            invalid_value: new_value,
                        };
                        await <Event>.send('meter-limit', event_value);
                        drop(event_value);
                    }

                    return res;
                }
            }
        }
        false
    }


    /**
     * Check if changing the value of a metered entitlement by a standard increment would be allowed (defined in the Limit).
     */
    fn check_increment(id: str!, entitlement: str!) -> bool {
        const ent = self.entitlement(id, entitlement);

        // get the entitlement limit (potentially overridden for a customer)
        const customer = self.customer(id);
        let limit = ent != null ? ent.limit : null;
        if (customer != null) {
            const override: Limit = customer.overrides.get(entitlement);
            if (override != null) {
                if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                    // Nada..
                } else {
                    limit = override;
                }
            }
        }

        if (ent != null && limit != null) {
            return self.check(id, entitlement, limit.increment);
        }
        false
    }


    /**
     * Check if changing the value of a metered entitlement by a negative standard increment would be allowed (defined in the Limit).
     */
    fn check_decrement(id: str!, entitlement: str!) -> bool {
        const ent = self.entitlement(id, entitlement);

        // get the entitlement limit (potentially overridden for a customer)
        const customer = self.customer(id);
        let limit = ent != null ? ent.limit : null;
        if (customer != null) {
            const override: Limit = customer.overrides.get(entitlement);
            if (override != null) {
                if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                    // Nada..
                } else {
                    limit = override;
                }
            }
        }

        if (ent != null && limit != null) {
            return self.check(id, entitlement, limit.increment * -1);
        }
        false
    }


    /**
     * If one were to call "allow" for this entitlement and value, would it be valid?
     * Does not change meters for this customer.
     */
    fn check(id: str!, entitlement: str!, value: float | str = 0) -> bool {
        if ((typeof value) == 'str') value = value as float; // takes units into consideration too
        let customer = self.customer(id);
        if (customer != null) {
            const plan = self.plan_for(id);
            if (plan != null) {
                const ent: Entitlement = plan.entitlements.get(entitlement);
                if (ent != null) {
                    // check entitlement scope for type of customer to use in refs (if different)
                    if (ent.scope != null && ent.scope != customer.type) {
                        if (customer.refs.empty()) return null;
                        for (const ref in customer.refs) {
                            const tmp = self.customer(ref);
                            if (tmp != null && tmp.type == ent.scope) {
                                customer = tmp;
                                break;
                            }
                        }
                        if (customer == null) return null;
                    }

                    const existing_meter: Meter = customer.meters.get(entitlement);
                    let new_value: float = existing_meter != null ? existing_meter.value + value : value;

                    // get the entitlement limit (potentially overridden for this customer)
                    let limit = ent.limit;
                    const override: Limit = customer.overrides.get(entitlement);
                    if (override != null) {
                        if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                            customer.overrides.remove(entitlement, shallow = false);
                        } else {
                            limit = override;
                        }
                    }

                    // check if the new value should be reset!
                    // account for old meter.reset timestamp first
                    if (existing_meter != null && existing_meter.started == null) {
                        if (existing_meter.reset != null && limit != null) existing_meter.started = existing_meter.reset - limit.reset_inc;
                        else existing_meter.started = Time.now(); // fallback
                    }
                    if (existing_meter != null && limit != null && limit.resets && limit.reset_inc > 0 && (Time.now() - existing_meter.started) > limit.reset_inc) {
                        new_value = value;
                    }

                    // put new_value into the credit's units, casting if needed (in case no units were given)
                    const credit = limit != null ? self.credit(limit.credit) : null;
                    const stof_units = credit != null ? (credit.stof_units ?? 'float') : 'float';
                    new_value = ?new_value.to_units(stof_units) ?? new_value;

                    // is the new value below a defined minimum?
                    if (limit != null && limit.minimum != null) {
                        const min_val = (limit.minimum as float).to_units(stof_units);
                        if (new_value < min_val) {
                            new_value = min_val;
                        }
                    }

                    let res = ent.check(new_value, override);
                    if (!res && limit != null && limit.mode == 'soft') res = true;
                    return res;
                }
            }
        }
        false
    }


    /*****************************************************************************
     * Credits.
     *****************************************************************************/
    
    /**
     * Get a global credit type.
     */
    fn credit(id: str!) -> Credit {
        self.credits.get(id)
    }


    /**
     * Get a credit type for a specific entitlement (that has a limit).
     * ID can be a plan ID or a customer ID.
     */
    fn credit_for(id: str!, entitlement: str!) -> Credit {
        const ent = self.entitlement(id, entitlement);
        const customer = self.customer(id);

        // get the entitlement limit (potentially overridden for a customer)
        let limit = ent != null ? ent.limit : null;
        if (customer != null) {
            const override: Limit = customer.overrides.get(entitlement);
            if (override != null) {
                if (override.override_expires_on != null && Time.now() >= override.override_expires_on) {
                    // Nada..
                } else {
                    limit = override;
                }
            }
        }

        if (ent != null && limit != null) {
            return self.credit(limit.credit);
        }
        null
    }


    /*****************************************************************************
     * Customers.
     *****************************************************************************/
    
    /**
     * Get a global customer by ID.
     */
    fn customer(id: str!) -> Customer {
        const sub = self.customers.get(id);
        if (sub == null) {
            const alt = self.alt_customer_ids.get(id);
            if (alt != null) return self.customer(alt);
        }
        sub
    }


    /**
     * Get a customer's metadata object.
     */
    fn customer_metadata(id: str!) -> obj {
        const customer = self.customer(id);
        customer != null ? customer.metadata : null
    }


    /**
     * Get the customer refs for this customer ID.
     */
    fn customer_refs(id: str!) -> list {
        const sub = self.customer(id);
        sub != null ? sub.refs : null
    }


    /**
     * Change a customer's plan ID.
     * Will initialize any meters for the new plan, optionally overwritting previous usage.
     */
    fn set_customer_plan(id: str!, plan: str!, overwrite_meters: bool = true) -> bool {
        const sub = self.customer(id);
        const prev = self.plan_for(id);
        const pn: Plan = self.plans.get(plan); // dont use self.plan(plan) because plan cannot be a customer ID here
        if (pn != null && sub != null && prev != pn) {
            sub.plan = plan;
            pn.name = plan;

            // init all plan entitlement meters for this new plan
            // all plan meters are a synced starting point
            let now = Time.now();

            // if not overwritting existing meters, try getting the first meter started on the current plan to set as "now" for new meters
            // this will mean that the meters will be relatively synced, depending on the new entitlement resets (might be immediately expired which is okay)
            if (!overwrite_meters && prev != null) {
                for (const pair in sub.meters.fields()) {
                    const entitlement = pair[0];
                    const met: Meter = pair[1];
                    // prev plan must include the entitlement to prevent ancient syncs
                    if (prev.entitlements.get(entitlement) != null && met.started < now) {
                        now = met.started;
                    }
                }
            }

            for (const pair in pn.entitlements.fields()) {
                const name = pair[0];
                const ent = pair[1];
                if ((typeof ent) == 'obj' && ent.limit != null) {
                    ent as Entitlement;
                    if (overwrite_meters || sub.meters.get(name) == null) {
                        const met = new Meter {
                            credit: ent.limit.credit,
                            started: now,
                        } on sub.meters;
                        sub.meters.insert(name, met);
                    }
                }
            }

            await <Event>.send('customer-set', sub);
            await <Event>.send_tmp('customer-plan-changed', new {
                previous_plan: prev.id ?? 'default',
                new_plan: plan,
                customer: sub,
            });
            return true;
        }
        false
    }


    /**
     * Create a customer with an ID and plan ID.
     */
    fn create_customer(id: str!, plan: str! = '', type: str! = 'user', label: str! = 'User', refs?: list, alts?: list, metadata?: str | obj) -> Customer {
        let pn = self.plan(plan, default = false);
        if (pn == null && refs != null) {
            for (const ref in refs) {
                pn = self.plan_for(ref, default = false);
                if (pn != null) {
                    plan = '';
                    break;
                }
            }
        }
        if (pn == null) {
            pn = self.default_plan();
            if (pn != null) plan = pn.name;
        }
        if (pn != null) {
            let meta: obj = null;
            if (metadata != null) {
                if ((typeof metadata) == 'str') {
                    meta = new {};
                    try {
                        parse(metadata, meta, 'stof');
                    } catch {
                        drop(meta);
                        meta = null;
                    }
                } else {
                    meta = metadata;
                }
            }

            // check for existing customer to update
            const existing: Customer = self.customers.get(id);
            if (existing != null) {
                existing.type = type;
                existing.label = label;
                existing.plan = plan;
                existing.refs = refs ?? [];
                if (meta != null) {
                    existing.metadata = meta;
                    meta.move(existing);
                }
                await <Event>.send('customer-set', existing);
                return existing;
            }

            const customer = new Customer {
                id,
                plan,
                type,
                label,
                refs: refs ?? [],
            } on self.customers;
            if (meta != null) {
                customer.metadata = meta;
                meta.move(customer);
            }
            self.customers.insert(id, customer);

            // init all plan entitlement meters for this new customer
            // all plan meters are a synced starting point
            const now = Time.now();
            for (const pair in pn.entitlements.fields()) {
                const name = pair[0];
                const ent = pair[1];
                if ((typeof ent) == 'obj' && ent.limit != null) {
                    ent as Entitlement;
                    const met = new Meter {
                        credit: ent.limit.credit,
                        started: now,
                    } on customer.meters;
                    customer.meters.insert(name, met);
                }
            }

            // init alternative ids
            if (alts != null) for (const alt in alts) self.set_alt_customer_id(id, alt, false);

            await <Event>.send('customer-set', customer);
            return customer;
        }
        null
    }


    /**
     * Set/create a customer with an id & internal Stof.
     */
    fn set_customer(stof: str!, event: bool = true) -> Customer {
        const sub = new {} on self.customers;
        try {
            parse(stof, sub, 'stof');
        } catch {
            drop(sub);
            return null;
        }
        const id = sub.id ?? nanoid();
        sub.id = id;
        self.customers.remove(id, shallow = false);
        self.customers.insert(id, sub as Customer);
        for (const alt in sub.alt_ids ?? []) self.set_alt_customer_id(id, alt, false);
        if (event) await <Event>.send('customer-set', sub);
        sub
    }


    /**
     * Delete a customer.
     */
    fn delete_customer(id: str!) -> bool {
        const customer = self.customer(id);
        if (customer != null) {
            await <Event>.send('customer-removed', customer);
            for (const alt in customer.alt_ids) self.delete_alt_customer_id(alt, false);
            return self.customers.remove(customer.id);
        }
        false
    }


    /**
     * Set an alternative customer ID (must be unique).
     */
    fn set_alt_customer_id(customer_id: str!, alt_id: str!, event: bool = true) -> bool {
        const customer = self.customer(customer_id);
        if (customer != null) {
            customer.alt_ids.remove_all(alt_id);
            customer.alt_ids.push_back(alt_id);
            self.alt_customer_ids.insert(alt_id, customer_id);
            if (event) await <Event>.send('customer-set', customer);
            return true;
        }
        false
    }


    /**
     * Delete an alternative customer ID.
     */
    fn delete_alt_customer_id(customer_id: str!, event: bool = true) -> bool {
        const customer = self.customer(customer_id);
        const res = self.alt_customer_ids.remove(customer_id);
        if (customer != null) {
            customer.alt_ids.remove_all(customer_id);
            if (event) await <Event>.send('customer-set', customer);
        }
        res
    }


    /**
     * Create a customer limit override.
     * Overrides are specific to customers, and they override the default
     * entitlement limit for that customer.
     *
     * If the customer already has an override for this entitlement, it will be replaced.
     */
    fn create_customer_override(customer_id: str!, entitlement: str!,
        expires?: ms, credit?: str, mode?: str, value?: float | str, increment?: float | str, resets?: bool, reset_inc?: ms) -> Limit {
        
        // Get the customer and entitlement
        const ent = self.entitlement(customer_id, entitlement);
        const customer = self.customer(customer_id);
        if (customer == null || ent == null) return null;

        // get the entitlement limit (potentially overridden for a customer)
        // use these values for defaults if set
        let existing_limit = ent.limit;
        const override: Limit = customer.overrides.get(entitlement);
        if (override != null) existing_limit = override;

        // Create the limit
        const limit = new Limit {
            credit: credit ?? existing_limit.credit ?? '',
            mode: mode ?? existing_limit.mode ?? 'hard',
            value: value ?? existing_limit.value ?? 0,
            increment: increment ?? existing_limit.increment ?? 0,
            resets: resets ?? existing_limit.resets ?? false,
            reset_inc: reset_inc ?? existing_limit.reset_inc ?? 30days,
            override_expires_on: expires ?? existing_limit.override_expires_on,
        };

        // Make sure a credit exists for this override (need to know what we're tracking)
        if (limit.credit == '' || self.credit(limit.credit) == null) {
            drop(limit);
            return null;
        }

        // Set the override on the customer and return
        customer.set_override(entitlement, limit);
        await <Event>.send('customer-set', customer);
        return limit;
    }


    /**
     * Remove a customer override (limit).
     */
    fn remove_customer_override(customer_id: str!, entitlement: str!) -> bool {
        const customer = self.customer(customer_id);
        if (customer != null) {
            const removed = customer.overrides.remove(entitlement, shallow = false);
            if (removed) await <Event>.send('customer-set', customer);
            return removed;
        }
        false
    }


    /**
     * Apply a plan topup to a customer.
     * Creates a credit grant with a topup/one-time-purchase if found.
     */
    fn apply_customer_topup(customer_id: str!, topup: str!) -> bool {
        const customer = self.customer(customer_id);
        const plan = self.plan_for(customer_id);
        if (plan != null && customer != null) {
            const top: Topup = plan.topups.get(topup);
            if (top != null) {
                const expires_on = top.expires_after != null ? Time.now() + top.expires_after : null;
                const granted = self.create_customer_credit_grant(customer_id, top.credit, top.value, top.resets, top.reset_inc, expires_on, false);
                if (granted) {
                    // Just the customer-topup-granted event, no customer-set here
                    await <Event>.send_tmp('customer-topup-granted', new {
                        customer,
                        topup_name: topup,
                        plan_name: plan.name,
                        topup: top,
                    });
                }
                return granted;
            }
        }
        false
    }


    /**
     * Create a customer credit grant.
     * Grants are applied when overage would occur (soft entitlement limits).
     * Defaults to a one-time, fixed-value credit grant.
     *
     * Ex. a soft limit of 5k tokens + a grant of 2k tokens would result in the customer
     * getting overage events (meter-overage) after 7k tokens spent.
     */
    fn create_customer_credit_grant(customer_id: str!, credit: str!, value: float | str, resets: bool = false, reset_inc?: ms, expires_on?: ms, event: bool = true) -> bool {
        const customer = self.customer(customer_id);
        const cred = self.credit(credit);
        if (customer == null || cred == null) return false;

        const grant = new Grant {
            id: 'lgt_' + nanoid(14),
            credit,
            granted_on: Time.now(),
            starting_value: value,
            value: (value as float).to_units(cred.stof_units ?? 'float'),
            resets,
            reset_inc: reset_inc ?? 30days,
            expires_on,
        } on customer.grants;
        customer.grants.insert(grant.id, grant);
        if (event) await <Event>.send('customer-set', customer);
        true
    }
}
