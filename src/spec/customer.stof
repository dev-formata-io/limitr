#[type]
/**
 * A Limitr customer.
 * Could be a user, organization, etc.
 */
Customer: {
    /// How to identify this customer.
    /// For a user, this could be an email, etc.
    /// This Id is used for metering, etc.
    str! id: '';

    /// Plan ID for this customer.
    str! plan: '';

    /// Alternate IDs for this customer.
    /// Use Limitr API.
    list! alt_ids: [];

    /// Optional organization customer ID for this user.
    str org: null;

    /// An optional type of this customer.
    /// Ex. user, org, seat, etc.
    str! type: 'user';

    /// Human-facing label for this customer.
    str! label: 'User';

    /// Meters for this customer.
    /// These map to entitlements by name for a plan.
    /// Lazily populated.
    obj! meters: {};

    /// Override limits for this customer.
    /// Entitlement -> Limit.
    obj! overrides: {};


    /**
     * Set an override for this customer.
     * Moves the limit and removes old override if any.
     */
    fn set_override(entitlement: str!, limit: Limit!) {
        self.overrides.remove(entitlement, shallow = false);
        self.overrides.insert(entitlement, limit);
        limit.move(self.overrides);
    }
}
