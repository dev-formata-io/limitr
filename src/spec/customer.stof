#[type]
/**
 * A Limitr customer.
 * Could be a user, organization, etc.
 */
Customer: {
    /// Primary ID.
    str! id: '';

    /// Plan ID.
    str! plan: '';

    /// Alternate IDs.
    list! alt_ids: [];

    /// Optional references to other customers by IDs.
    list! refs: [];

    /// Type of customer (e.g. user, org, seat, etc).
    str! type: 'user';

    /// Human-facing label.
    str! label: 'User';

    /// Meters (lazy - map to entitlements by name).
    obj! meters: {};

    /// Override limits (entitlement -> Limit).
    obj! overrides: {};

    /// Credit grants.
    obj! grants: {};

    /// Spend caps.
    obj! caps: {};

    /// Optional metadata object.
    obj metadata: null;


    /**
     * Set an override.
     * Moves the limit and removes old override if any.
     */
    fn set_override(entitlement: str!, limit: Limit!) {
        self.overrides.remove(entitlement, shallow = false);
        self.overrides.insert(entitlement, limit);
        limit.move(self.overrides);
    }


    /**
     * Find the best grant on this customer for a given credit.
     * Removes expired & resets values.
     */
    fn best_grant(credit: str!, exchange: Exchange, stof_units: str!) -> Grant {
        const now = Time::now();
        let best = null;
        let best_exact = null;
        let best_exact_bench = null;
        const bench = exchange == null ? null : exchange.to_runes(1, credit); // does this credit take part in exchange?
        let best_bench = null;
        for (const pair in self.grants.fields()) {
            const id = pair[0];
            const grant: Grant = pair[1];
            
            // Is this grant expired? Otherwise roll it through any elapsed reset periods.
            if (!grant.ensure_current(stof_units, now)) {
                self.grants.remove(id, shallow = false);
            } else {
                // Empty grants can't cover anything (resetting grants refill above, next period)
                if (grant.value.remove_units() <= 0) continue;

                // Does this grant match this credit exactly?
                if (grant.credit == credit) {
                    if (exchange != null && bench != null) {
                        const strat = exchange.grant_strategy ?? 'expires_first';
                        if (strat == 'expires_first') {
                            const lbench = grant.expires_on;
                            if (best_exact_bench == null || (lbench != null && lbench < best_exact_bench)) {
                                best_exact = grant;
                                best_exact_bench = lbench;
                            }
                        } else if (strat == 'valuable_first') {
                            if (best_exact_bench == null || bench > best_exact_bench) {
                                best_exact = grant;
                                best_exact_bench = bench;
                            }
                        } else if (best_exact_bench == null || bench < best_exact_bench) {
                            // cheapest first
                            best_exact = grant;
                            best_exact_bench = bench;
                        }
                    } else {
                        return grant;
                    }
                } else if (bench != null && exchange != null) {
                    // What does the exchange look like?
                    const strat = exchange.grant_strategy ?? 'expires_first';
                    if (strat == 'expires_first') {
                        const lbench = grant.expires_on;
                        if (best_bench == null || (lbench != null && lbench < best_bench)) {
                            best = grant;
                            best_bench = lbench;
                        }
                    } else if (strat == 'valuable_first') {
                        const lbench = exchange.to_runes(1, grant.credit);
                        if (lbench != null && (best_bench == null || lbench > best_bench)) {
                            best = grant;
                            best_bench = lbench;
                        }
                    } else {
                        const lbench = exchange.to_runes(1, grant.credit);
                        if (lbench != null && (best_bench == null || lbench < best_bench)) {
                            best = grant;
                            best_bench = lbench;
                        }
                    }
                }
            }
        }
        best_exact ?? best
    }


    /**
     * Update topup grants with their respective topup definitions in the plan.
     * Topup grants adapt to the topup definition they are associated with.
     */
    fn update_topup_plan_grants(policy: Limitr, plan: Plan) -> bool {
        if (policy == null || plan == null) return false;

        let set_topup_names = set();
        for (const pair in self.grants.fields()) {
            const grant_id = pair[0];
            const grant: Grant = pair[1];
            const top: Topup = grant.topup != null ? plan.topups.get(grant.topup) : null;
            if (top != null) {
                if (top.included && top.included_scopes != null && !top.included_scopes.contains(self.type)) {
                    // was included by default with the plan, now no longer applies to this customer
                    self.grants.remove(grant_id, shallow = false);
                } else {
                    set_topup_names.insert(grant.topup);
                    grant.credit = top.credit;
                    grant.starting_value = top.value;
                    grant.resets = top.resets;
                    grant.reset_inc = top.reset_inc;
                    grant.reset_sch = top.reset_sch;
                    grant.expires_on = top.expires_after != null ? grant.created_on + top.expires_after : null;
                    grant.reset_mode = top.reset_mode;
                    grant.rollover_min = top.rollover_min;
                    grant.rollover_max = top.rollover_max;
                    grant.rollover_pct = top.rollover_pct;
                    grant.max_balance = top.max_balance;
                    grant.reset_catchup_cap = top.reset_catchup_cap;
                }
            } else if (grant.topup != null) {
                // this grant was defined via a topup, and the topup no longer exists, so remove the grant too
                self.grants.remove(grant_id, shallow = false);
            }
        }

        // Make sure all included plan topups are applied to this customer
        for (const pair in plan.topups.fields()) {
            const name = pair[0];
            const top: Topup = pair[1];
            if (top.included && !set_topup_names.contains(name) && (top.included_scopes == null || top.included_scopes.contains(self.type))) {
                const cred = policy.credit(top.credit);
                if (cred != null) {
                    set_topup_names.insert(name);
                    const units = cred.stof_units ?? 'float';
                    const grant = top.create_grant(units, self.grants);
                    grant.topup = name;
                    self.grants.insert(grant.id, grant);
                }
            }
        }

        set_topup_names.any()
    }


    /**
     * Get the remaining amount of a credit from this customer's grants.
     * `position` is the billable position (units past the included amount) the grants would
     * start covering from - it only matters for tier-priced credits. Grants in the same credit
     * count unit for unit; other grants are pooled in runes and converted from there.
     */
    fn remaining_grant_credit(policy: Limitr, credit: str!, position: float = 0) -> float {
        const exchange: Exchange = policy.exchange;
        if (exchange == null) return null;
        let exact: float = 0;
        let runes: float = 0;
        const now = Time::now();
        for (const field in self.grants.fields()) {
            const grant: Grant = field[1];

            // current period only: drop expired grants, apply pending resets (same as allow)
            const grant_credit = ?policy.credit(grant.credit);
            const grant_units = grant_credit != null ? (grant_credit.stof_units ?? 'float') : 'float';
            if (!grant.ensure_current(grant_units, now)) {
                self.grants.remove(field[0], shallow = false);
                continue;
            }

            if (grant.credit == credit) {
                exact += grant.value.remove_units();
            } else {
                const r = exchange.to_runes(grant.value.remove_units(), grant.credit);
                if (r != null) runes += r;
            }
        }
        let total: float = exact;
        if (runes > 0) {
            const converted = exchange.from_runes(runes, credit, max(0, position) + exact);
            if (converted != null) total += converted;
        }
        total
    }
    

    /**
     * Try using a grant on this customer before sending meter-overage.
     * Returns true if there is still overage to be applied to the customers account (grants were used up/not there).
     */
    fn apply_overage_grants(policy: Limitr, plan: Plan, credit: str!, event_value: obj!, stof_units: str!, position: float = 0) -> bool {
        const fields = self.grants.fields();
        if (fields.empty()) return true; // no grants present, send overage event

        let overage = event_value.overage;
        if (overage == null) return false; // no overage recorded, don't send event

        // Update topup grants with their respective topup definitions in the plan
        // Topup grants adapt to the topup definition they are associated with
        self.update_topup_plan_grants(policy, plan);

        // while overage, take from grants
        // pos tracks where on the credit's tier curve the next uncovered unit sits
        const exchange: Exchange = policy.exchange;
        let grant_value_applied = 0;
        let pos = max(0, position);
        let guard = fields.len() + 1; // every pass drains or covers with one grant - never spin
        while (Num::round(overage, 9) > 0 && guard > 0) { // at 1e-9: float residue isn't overage
            guard -= 1;
            const grant: Grant = self.best_grant(credit, exchange, stof_units);
            if (grant != null) {
                // get overage in terms of the grant itself
                // clamp at 0: consuming more never credits a grant back (e.g. a volume band reprice)
                let grant_overage = exchange != null ? exchange.exchange(overage, credit, grant.credit, pos) ?? overage : overage;
                grant_overage = max(0, grant_overage);
                if (Num::round(grant_overage, 9) < Num::round(grant.value, 9)) {
                    grant.value -= grant_overage;
                    grant_value_applied += overage; // in "credit"
                    pos += overage;
                    overage = 0;
                } else {
                    let credit_grant_value = exchange != null ? exchange.exchange(grant.value, grant.credit, credit, 0, pos) ?? grant.value : grant.value;
                    // a grant covers at most the overage (unbounded inverses, e.g. stairstep top band = inf)
                    credit_grant_value = min(overage, max(0, credit_grant_value));
                    overage -= credit_grant_value;
                    grant_value_applied += credit_grant_value;
                    pos += credit_grant_value;
                    grant.value = 0;

                    // if grant doesn't reset, then remove completely
                    if (!grant.resets) self.grants.remove(grant.id, shallow = false);
                }
            } else {
                break;
            }
        }
        event_value.grant_value_applied = grant_value_applied;
        event_value.overage = max(0, overage);
        Num::round(overage, 9) > 0
    }


    /**
     * Ensure voucher max spend (for local allow only - max spend hard enforced remotely for customers).
     * If self.metadata.limitr_voucher_runes < overage, prevent the allow to protect provider (your) costs!
     */
    fn ensure_voucher(credit: str!, event_value: obj!, exchange: Exchange, position: float = 0) -> bool {
        if (self.metadata.limitr_voucher != null && self.metadata.limitr_voucher_expires != null) {
            if (self.metadata.limitr_voucher_runes != null) {
                if (exchange == null) return false;

                // remaining overage starts after whatever grants covered (tier position)
                const overage = event_value.overage ?? 0;
                const overage_from = max(0, position) + (event_value.grant_value_applied ?? 0);
                let overage_runes = exchange.to_runes(overage, credit, overage_from);
                if (overage_runes == null) return false;
                overage_runes = max(0, overage_runes); // a volume band reprice never adds voucher balance

                const res = Time::now() < self.metadata.limitr_voucher_expires && Num::round(self.metadata.limitr_voucher_runes, 9) >= Num::round(overage_runes, 9); // at 1e-9
                if (res) self.metadata.limitr_voucher_runes -= overage_runes;
                return res;
            } else {
                return Time::now() < self.metadata.limitr_voucher_expires;
            }
        }
        true
    }


    /*****************************************************************************
     * Spend Cap Helpers.
     *****************************************************************************/
    
    /**
     * Standing caps that are current (expired ones are removed), followed by any
     * current ephemeral (`extra`) caps.
     */
    fn current_caps(extra: list = []) -> list {
        const out = [];
        for (const pair in self.caps.fields()) {
            const cap: Cap = pair[1];
            if (!cap.ensure_current()) {
                self.caps.remove(pair[0], shallow = false);
                continue;
            }
            out.push_back(cap);
        }
        for (const ext: Cap in extra) {
            if (ext.ensure_current()) out.push_back(ext);
        }
        out
    }


    /**
     * Convert `units` of entitlement_credit (starting at tier position `offset`) into
     * the cap's credit. Overhead caps convert the overhead cost (runes) instead.
     * Null if there is no exchange path (cap doesn't apply).
     */
    fn cap_convert(exchange: Exchange, cap: Cap!, entitlement_credit: str!, credit_overhead: float!, units: float!, offset: float = 0) -> float {
        if (exchange == null) return null;
        const converted = cap.overhead_cost
            ? exchange.exchange(units * credit_overhead, 'rune', cap.credit)
            : exchange.exchange(units, entitlement_credit, cap.credit, offset);
        // An unbounded conversion (into a stairstep credit past its top band) has no meaningful
        // amount - the cap doesn't apply, rather than jumping to the sentinel and blocking everything.
        // add_customer_cap rejects these caps up front; this covers caps loaded from Cloud/set_customer.
        if (converted != null && Num::abs(converted) >= <Credit>.UNBOUNDED_QUANTITY) return null;
        converted
    }


    /**
     * How much of `cap` a change consumes, in the cap's credit.
     * Null if the cap doesn't apply to this entitlement/credit.
     *
     * `position` is the signed billable position of the change's first unit
     * (meter - limit before the call; negative = inside the included amount).
     * `overage_position` is where the overage portion starts (defaults to max(0, position)).
     * `grant_applied` (units of entitlement_credit already covered by grants) is removed
     * for ignore_grants caps - grants cover overage from its first unit.
     */
    fn cap_consumption(policy: Limitr!, cap: Cap!, entitlement: str!, entitlement_credit: str!, credit_overhead: float!,
        value: float!, overage: float!, grant_applied: float = 0, position: float = 0, overage_position: float = null) -> float {
        if (!cap.applies_to(entitlement)) return null;
        if (!cap.exchangeable && entitlement_credit != cap.credit) return null;

        const exchange: Exchange = policy.exchange;
        const opos = overage_position ?? max(0, position);
        const ignore = cap.ignore_grants && grant_applied > 0;

        if (cap.overage_only) {
            const units = ignore ? max(0, overage - grant_applied) : overage;
            return self.cap_convert(exchange, cap, entitlement_credit, credit_overhead, units, ignore ? opos + grant_applied : opos);
        }

        let converted = self.cap_convert(exchange, cap, entitlement_credit, credit_overhead, value, position);
        if (converted != null && ignore) {
            const covered = self.cap_convert(exchange, cap, entitlement_credit, credit_overhead, grant_applied, opos);
            if (covered != null) converted = max(0, converted - covered);
        }
        converted
    }


    /**
     * Check whether a proposed change to an entitlement (denominated in
     * entitlement_credit) would be allowed under every standing cap on
     * this customer that applies to `entitlement` and has a valid Exchange
     * path to/from entitlement_credit.
     *
     * observe_only caps never cause a denial here - they're skipped for
     * the purposes of this check (their accumulation still happens in
     * check_and_apply_caps, just never their enforcement).
     *
     * Returns true if every applicable, enforcing cap has enough remaining
     * room. A cap with no Exchange path to entitlement_credit is skipped
     * (does not apply to this entitlement) rather than causing a failure.
     *
     * See cap_consumption for `position` / `overage_position`.
     */
    fn check_caps(policy: Limitr!, entitlement: str!, entitlement_credit: str!, credit_overhead: float!, value: float!, overage: float!, extra: list = [], stof_units: str = 'float', non_ignore_grants_only: bool = false, position: float = 0, overage_position: float = null) -> bool {
        for (const cap: Cap in self.current_caps(extra)) {
            if (non_ignore_grants_only && cap.ignore_grants) continue;
            if (cap.observe_only) continue; // never denies - accumulates only, see check_and_apply_caps

            const converted = self.cap_consumption(policy, cap, entitlement, entitlement_credit, credit_overhead, value, overage, 0, position, overage_position);
            if (converted == null) continue; // no exchange path - cap not applicable here

            const ceiling = (cap.value as float).to_units(stof_units);
            if (!cap.has_room(converted, ceiling)) return false;
        }
        true
    }


    /**
     * Like check_caps, but on success also commits: advances every
     * applicable standing cap's meter_value by the converted amount, and
     * lazily removes any caps that have expired. Call only after the
     * corresponding Limit/Grant checks have also passed - Cap is an
     * additional independent gate, not a replacement for either.
     *
     * `extra` is a list of ephemeral Caps (the call-arg / map-shorthand
     * case, expanded via caps_from_arg) - each is checked and incremented
     * identically to a stored cap, but the caller is responsible for
     * dropping them afterward; they are never inserted into self.caps.
     *
     * observe_only caps never deny - they still accumulate meter_value,
     * they just never fail the ceiling check below.
     *
     * Returns null (and applies nothing) if any non-observe_only applicable
     * cap would be exceeded - same all-or-nothing semantics as a single
     * allow() call. On success, returns a (possibly empty) list of caps
     * that just crossed their `value` threshold on THIS call (pre-commit
     * meter_value was below value, post-commit is at or above) - the
     * caller (Limitr.allow) uses this to fire a threshold-crossing event
     * per cap, exactly once per crossing rather than on every call past it.
     *
     * See cap_consumption for `position`. `changed` (optional) collects every cap whose
     * meter_value moved, so the caller can sync the customers holding them.
     */
    fn check_and_apply_caps(policy: Limitr!, entitlement: str!, entitlement_credit: str!, credit_overhead: float!, value: float!, overage: float!, grant_applied: float!, extra: list = [], stof_units: str = 'float', position: float = 0, changed: list = null) -> list {
        // Pass 1: roll forward resets, drop expired, and verify - mutate nothing yet.
        const applicable = [];
        for (const cap: Cap in self.current_caps(extra)) {
            const converted = self.cap_consumption(policy, cap, entitlement, entitlement_credit, credit_overhead, value, overage, grant_applied, position);
            if (converted == null) continue; // not applicable to this entitlement/credit pair

            // Negative amounts: a true decrement (fewer units - or, for overage_only, in-plan usage)
            // only moves follow_decrements caps. Consuming MORE units at a negative price (a volume
            // band reprice) is spend going down for real, so it always applies - the cap tracks the true total.
            const units = cap.overage_only ? overage : value;
            if (converted < 0 && units <= 0 && !cap.follow_decrements) continue;

            const ceiling = (cap.value as float).to_units(stof_units);
            if (!cap.has_room(converted, ceiling)) return null;
            applicable.push_back((cap, converted, ceiling));
        }

        // Pass 2: every applicable cap had room (or is observe_only) - commit,
        // tracking any cap that crosses its threshold on this exact call.
        const crossings = [];
        for (const entry in applicable) {
            const cap: Cap = entry[0];
            const converted = entry[1];
            const ceiling = entry[2];
            const before = cap.meter_value ?? 0;
            const after = before + converted;
            cap.meter_value = after;
            if (changed != null && converted != 0) changed.push_back(cap); // caller syncs the holders
            if (Num::round(before, 9) < Num::round(ceiling, 9) && Num::round(after, 9) >= Num::round(ceiling, 9)) crossings.push_back(cap); // at 1e-9
        }

        crossings
    }


    /**
     * Build a list of transient, unattached Cap objects from either a
     * single Cap (returned as a one-element list) or a bare map shorthand
     * of credit -> ceiling pairs, e.g. map(('ai_credits', 2), ('usd', 5)).
     *
     * A map with multiple entries expands into multiple transient Caps
     * (one per credit), since the Cap type is single-credit by design.
     * The resulting list is what check_caps / check_and_apply_caps expect
     * for their `extra` parameter.
     *
     * Caller owns the returned object(s) and is responsible for drop()
     * on each once the call completes - these are never inserted into any
     * customer.caps map.
     */
    fn caps_from_arg(arg: Cap | map = null) -> list {
        const out = [];
        if (arg == null) return out;
        if ((typeof arg) == 'obj' && arg.instance_of('Cap')) {
            out.push_back(arg);
            return out;
        }
        // bare map shorthand: credit -> ceiling
        for (const pair in arg) {
            const credit = pair[0];
            let ceiling = pair[1];

            if ((typeof ceiling) == 'fn') {
                ceiling = ceiling();
            }

            if ((typeof ceiling) == 'obj') {
                out.push_back(ceiling as Cap);
            } else {
                const tmp = new Cap {
                    id: `tmp-${credit}`,
                    credit: credit,
                    value: ceiling,
                    created_on: Time::now(),
                    temp: true, // for document mem management
                };
                out.push_back(tmp);
            }
        }
        out
    }
}
