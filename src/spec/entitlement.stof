#[type]
/**
 * A Limitr entitlement limit.
 */
Limit: {
    #[schema(<LimitrValidation>.valid_credit_id)]
    /// Credit ID.
    str! credit: '';

    #[schema((target_val: str): bool => {
        set('hard', 'soft', 'observe').contains(target_val) ? true :
        <LimitrValidation>.error(`Limits cannot have a "${target_val}" mode - only hard, soft, or observe`)
    })]
    /// Mode.
    /// "hard" - (default) Deny immediately.
    /// "soft" - Allow, but emit overage events instead of changed events after limit.
    /// "observe" - Never deny, only record (unlimited value).
    str! mode: 'hard';

    /// Should grants be allowed to apply to this limit?
    /// Default true. Set to false on enforcement/governor entitlements where
    /// grants should never extend a rate ceiling, or on soft entitlements
    /// where you want a clean unmodified consumption signal.
    bool grants_apply: true;

    #[schema(<LimitrValidation>.valid_limit_number)]
    /// Value of this limit.
    /// If a str, can use units, but must be a valid stof number.
    float | str value: 0;

    #[schema(<LimitrValidation>.valid_limit_number)]
    /// Increment for an operation with this limit.
    /// Used with <Limitr>.increment.
    /// If a str, can use units, but must be a valid stof number.
    float | str increment: 1;

    #[schema(<LimitrValidation>.valid_limit_number)]
    #[schema_optional]
    /// Optional minimum value.
    float | str minimum: null;

    /// Should the meter reset after a certain period?
    bool resets: false;

    #[schema((target: obj, target_val: float): bool => {
        if (target.resets) {
            if (target_val == null && target.reset_sch == null) {
                target.reset_inc = 30days;
                return true;
            }
            if (target_val != null && target.reset_sch != null) {
                return <LimitrValidation>.error('Limit reset_inc and reset_sch are mutually exclusive');
            }
            if (target_val != null) return target_val > 0 ? true : <LimitrValidation>.error(`Limit reset increment value must be greater than zero`);
        }
        true
    })]
    /// Duration-based reset increment. Mutually exclusive with reset_sch.
    /// Defaults to 30 days when resets is true and reset_sch is not set.
    ms reset_inc: null;

    #[schema((target: obj, target_val: str): bool => {
        if (!target_val.starts_with('monthly') &&
            !target_val.starts_with('weekly') &&
            !target_val.starts_with('nth_weekday') &&
            !target_val.starts_with('yearly') &&
            !target_val.starts_with('quarterly')) return <LimitrValidation>.error(`Invalid reset schedule '${target_val}' - must start with monthly, weekly, nth_weekday, yearly, or quarterly`);
        true
    })]
    #[schema_optional]
    /// Calendar reset schedule. Mutually exclusive with reset_inc.
    /// Formats: 'monthly:N', 'monthly:last', 'weekly:mon', 'nth_weekday:N:mon', 'yearly:M-D', 'quarterly:D'
    /// All schedules use UTC. When set, reset_inc is ignored.
    str reset_sch: null;

    /// Expires on date (optional) for Limit overrides.
    /// Not used outside of customer overrides.
    ms override_expires_on: null;

    /// Optional governor: rate ceiling below the hard limit.
    /// When enabled, consumption is shaped before the hard limit is reached.
    bool governor_enabled: false;

    #[schema((target: obj, target_val: unknown): bool => target.governor_enabled && target_val == null ? <LimitrValidation>.error(`Limit governor_capacity must be set when governor_enabled is true`) : true)]
    /// Governor bucket capacity (max burst).
    /// Required if governor_enabled is true.
    float | str governor_capacity: null;

    #[schema((target: obj, target_val: unknown): bool => target.governor_enabled && target_val == null ? <LimitrValidation>.error(`Limit governor_refill_rate must be set when governor_enabled is true`) : true)]
    /// Governor refill rate (tokens per ms).
    /// Required if governor_enabled is true.
    float governor_refill_rate: null;

    #[schema((target_val: float): bool => target_val >= 0 && target_val <= 1 ? true : <LimitrValidation>.error(`Limit ewma_alpha value must be between 0.0 and 1.0`))]
    /// EWMA smoothing factor for rate trend calculation (0.0–1.0).
    /// Lower values smooth more aggressively (better for bursty workloads).
    /// Higher values track recent changes faster (better for steady consumption).
    /// Defaults to 0.2 if not set.
    float ewma_alpha: 0.2;


    /**
     * Check this limit against a value.
     */
    fn check(value: float = 0) -> bool {
        if (value > (self.value as float) && self.mode != 'observe') {
            return false; // delay the "soft" mode check for events in limitr.stof
        }
        true
    }
}


#[type]
/**
 * A Limitr entitlement.
 */
Entitlement: {
    /// Description for this entitlement.
    str description: '';

    #[schema((target_val: obj): bool => <Limit>.schemafy(target_val))]
    #[schema_optional]
    /// Optional limit for this entitlement.
    Limit limit: null;

    /// Scope of this entitlement.
    /// Must match customer type for operations if defined, will look through customer refs for proper type match.
    str scope: null;

    /// Hidden entitlement?
    bool hidden: false;


    /**
     * Check this entitlement.
     */
    fn check(value: float = 0, override?: Limit) -> bool {
        let limit = override ?? self.limit;
        if (limit != null) return limit.check(value);
        true
    }
}
