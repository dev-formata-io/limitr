#[type]
/**
 * A Limitr entitlement limit.
 */
Limit: {
    /// Credit ID.
    str! credit: '';

    /// Unlimited?
    /// If true, this limit defines a credit type and meter, but does not enforce an actual limit.
    bool unlimited: false;

    /// Value of this limit.
    float value: 0;

    /// Enforcement callback when this limit is reached.
    fn | obj enforcement: null;

    /// Optional resets on timestamp.
    ms resets_on: null;

    /// Optional reset increment (default 30 days).
    ms reset_inc: 30days;


    /**
     * Check this limit against a value.
     */
    fn check(value: float = 0, enforce: bool = true) -> bool {
        if (value > self.value && !self.unlimited) {
            if (enforce) {
                if ((typeof self.enforcement) == 'fn') self.enforcement();
                else if ((typeof self.enforcement) == 'obj') {
                    if ((typeof self.enforcement.callback) == 'fn') self.enforcement.callback();
                    else self.enforcement.run();
                }
            }
            return false;
        }
        true
    }
}


#[type]
/**
 * A Limitr entitlement.
 */
Entitlement: {
    /// Enabled?
    bool enabled: true;

    /// Description for this entitlement.
    str description: '';

    /// Optional limit for this entitlement.
    Limit limit: null;


    /**
     * Check this entitlement.
     */
    fn check(value: float = 0, enforce: bool = true) -> bool {
        if (!self.enabled) return false;
        if (self.limit != null) return self.limit.check(value, enforce);
        true
    }
}
