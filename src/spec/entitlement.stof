#[type]
/**
 * A Limitr entitlement limit.
 */
Limit: {
    #[schema(<LimitrValidation>.valid_credit_id)]
    /// Credit ID.
    str! credit: '';

    #[schema((target_val: str): bool => {
        set('hard', 'soft', 'observe').contains(target_val) ? true :
        <LimitrValidation>.error(`Limits cannot have a "${target_val}" mode - only hard, soft, or observe`)
    })]
    /// Mode.
    /// "hard" - (default) Deny immediately.
    /// "soft" - Allow, but emit overage events instead of changed events after limit.
    /// "observe" - Never deny, only record (unlimited value).
    str! mode: 'hard';

    #[schema(<LimitrValidation>.valid_limit_number)]
    /// Value of this limit.
    /// If a str, can use units, but must be a valid stof number.
    float | str value: 0;

    #[schema(<LimitrValidation>.valid_limit_number)]
    /// Increment for an operation with this limit.
    /// Used with <Limitr>.increment.
    /// If a str, can use units, but must be a valid stof number.
    float | str increment: 1;

    #[schema(<LimitrValidation>.valid_limit_number)]
    #[schema_optional]
    /// Optional minimum value.
    float | str minimum: null;

    /// Should the meter reset after a certain period?
    bool resets: false;

    #[schema((target_val: float): bool => target_val > 0 ? true : <LimitrValidation>.error(`Limit reset increment value must be greater than zero`))]
    /// Optional reset increment (default 30 days).
    ms reset_inc: 30days;

    /// Expires on date (optional) for Limit overrides.
    /// Not used outside of customer overrides.
    ms override_expires_on: null;


    /**
     * Check this limit against a value.
     */
    fn check(value: float = 0) -> bool {
        if (value > (self.value as float) && self.mode != 'observe') {
            return false; // delay the "soft" mode check for events in limitr.stof
        }
        true
    }
}


#[type]
/**
 * A Limitr entitlement.
 */
Entitlement: {
    /// Description for this entitlement.
    str description: '';

    #[schema((target_val: obj): bool => <Limit>.schemafy(target_val))]
    #[schema_optional]
    /// Optional limit for this entitlement.
    Limit limit: null;

    /// Scope of this entitlement.
    /// Must match customer type for operations if defined, will look through customer refs for proper type match.
    str scope: null;

    /// Hidden entitlement?
    bool hidden: false;


    /**
     * Check this entitlement.
     */
    fn check(value: float = 0, override?: Limit) -> bool {
        let limit = override ?? self.limit;
        if (limit != null) return limit.check(value);
        true
    }
}
