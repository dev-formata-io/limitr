#[type]
/**
 * A Limitr entitlement limit.
 */
Limit: {
    #[schema(<LimitrValidation>.valid_credit_id)]
    /// Credit ID.
    str! credit: '';

    #[schema((target_val: str): bool => {
        set('hard', 'soft', 'observe').contains(target_val) ? true :
        <LimitrValidation>.error(`Limits cannot have a "${target_val}" mode - only hard, soft, or observe`)
    })]
    /// Mode.
    /// "hard" - (default) Deny immediately.
    /// "soft" - Allow, but emit overage events instead of changed events after limit.
    /// "observe" - Never deny, only record (unlimited value).
    str! mode: 'hard';

    #[schema((target: obj, target_val: bool): bool => {
        target_val && target.mode != 'hard' ? <LimitrValidation>.error(`Limit hard_trailing can only be true when mode is 'hard'`) : true
    })]
    /// When mode is 'hard': deny based on the current meter value instead of
    /// the projected post-operation value. Lets a single call cross the limit
    /// if the meter was already under it beforehand, then hard-blocks every
    /// call after that until the meter resets below the limit again.
    bool! hard_trailing: false;

    /// Should grants be allowed to apply to this limit?
    /// Default true. Set to false on enforcement/governor entitlements where
    /// grants should never extend a rate ceiling, or on soft entitlements
    /// where you want a clean unmodified consumption signal.
    bool grants_apply: true;

    #[schema(<LimitrValidation>.valid_limit_number)]
    /// Value of this limit.
    /// If a str, can use units, but must be a valid stof number.
    float | str value: 0;

    #[schema(<LimitrValidation>.valid_limit_number)]
    /// Increment for an operation with this limit.
    /// Used with <Limitr>.increment.
    /// If a str, can use units, but must be a valid stof number.
    float | str increment: 1;

    #[schema(<LimitrValidation>.valid_limit_number)]
    #[schema_optional]
    /// Optional minimum value.
    float | str minimum: null;

    /// Should the meter reset after a certain period?
    bool resets: false;

    #[schema((target: obj, target_val: float): bool => {
        if (target.resets) {
            if (target_val == null && target.reset_sch == null) {
                target.reset_inc = 30days;
                return true;
            }
            if (target_val != null && target.reset_sch != null) {
                return <LimitrValidation>.error('Limit reset_inc and reset_sch are mutually exclusive');
            }
            if (target_val != null) return target_val > 0 ? true : <LimitrValidation>.error(`Limit reset increment value must be greater than zero`);
        }
        true
    })]
    /// Duration-based reset increment. Mutually exclusive with reset_sch.
    /// Defaults to 30 days when resets is true and reset_sch is not set.
    ms reset_inc: null;

    #[schema((target: obj, target_val: str): bool => {
        if (!target_val.starts_with('monthly') &&
            !target_val.starts_with('weekly') &&
            !target_val.starts_with('nth_weekday') &&
            !target_val.starts_with('yearly') &&
            !target_val.starts_with('quarterly')) return <LimitrValidation>.error(`Invalid reset schedule '${target_val}' - must start with monthly, weekly, nth_weekday, yearly, or quarterly`);
        true
    })]
    #[schema_optional]
    /// Calendar reset schedule. Mutually exclusive with reset_inc.
    /// Formats: 'monthly:N', 'monthly:last', 'weekly:mon', 'nth_weekday:N:mon', 'yearly:M-D', 'quarterly:D'
    /// All schedules use UTC. When set, reset_inc is ignored.
    str reset_sch: null;

    /// Expires on date (optional) for Limit overrides.
    /// Not used outside of customer overrides.
    ms override_expires_on: null;

    /// Optional governor: rate ceiling below the hard limit.
    /// When enabled, consumption is shaped before the hard limit is reached.
    bool governor_enabled: false;

    #[schema((target: obj, target_val: unknown): bool => target.governor_enabled && target_val == null ? <LimitrValidation>.error(`Limit governor_capacity must be set when governor_enabled is true`) : true)]
    /// Governor bucket capacity (max burst).
    /// Required if governor_enabled is true.
    float | str governor_capacity: null;

    #[schema((target: obj, target_val: unknown): bool => target.governor_enabled && target_val == null ? <LimitrValidation>.error(`Limit governor_refill_rate must be set when governor_enabled is true`) : true)]
    /// Governor refill rate (tokens per ms).
    /// Required if governor_enabled is true.
    float governor_refill_rate: null;

    #[schema((target_val: float): bool => target_val >= 0 && target_val <= 1 ? true : <LimitrValidation>.error(`Limit ewma_alpha value must be between 0.0 and 1.0`))]
    /// EWMA smoothing factor for rate trend calculation (0.0–1.0).
    /// Lower values smooth more aggressively (better for bursty workloads).
    /// Higher values track recent changes faster (better for steady consumption).
    /// Defaults to 0.2 if not set.
    float ewma_alpha: 0.2;


    /**
     * Effective duration-based reset increment: reset_inc, or 30 days when this limit
     * resets without an interval or calendar schedule. Computed here (not only in the
     * schema pass) so unvalidated policies (set_plan, Cloud updates) still reset.
     * Null when not duration-based (no resets, or a reset_sch calendar schedule).
     */
    fn reset_increment() -> ms {
        if (!self.resets || self.reset_sch != null) return null;
        const inc: ms = self.reset_inc ?? 30days;
        inc > 0 ? inc : null
    }


    /**
     * Start of the current period for a meter that started at `started` - read-only.
     * Returns `started` when no reset is due, a later timestamp when a reset is pending,
     * and null if this limit doesn't reset.
     */
    fn current_period_start(started: ms, now: ms) -> ms {
        if (!self.resets || started == null) return null;
        if (self.reset_sch != null) {
            const period_start = Time::start_of_period(now, self.reset_sch);
            return period_start != null && started < period_start ? period_start : started;
        }
        const inc = self.reset_increment();
        if (inc == null) return started;
        const elapsed = now - started;
        if (elapsed <= inc) return started;
        const steps = (elapsed / inc).remove_units().ceil() - 1; // whole periods elapsed
        started + inc * steps
    }


    /**
     * Would the next operation on a meter that started at `started` begin a new period?
     */
    fn reset_pending(started: ms, now: ms) -> bool {
        const period_start = self.current_period_start(started, now);
        period_start != null && period_start != started
    }


    /**
     * Check this limit against a value.
     * Compares at 1e-9 so float drift can't flip the decision (0.1 + 0.2 reaches a 0.3 limit);
     * the values themselves are never rounded.
     */
    fn check(new_value: float = 0, meter_value: float = 0) -> bool {
        const next = Num::round(new_value, 9);
        const current = Num::round(meter_value, 9);
        const lim = Num::round(self.value as float, 9);
        if (self.mode == 'observe' || next <= current) return true; // decrements/no-ops never trip
        if (self.hard_trailing && self.mode == 'hard') return current < lim;
        next <= lim
    }
}


#[type]
/**
 * A Limitr entitlement.
 */
Entitlement: {
    /// Description for this entitlement.
    str description: '';

    #[schema((target_val: obj): bool => <Limit>.schemafy(target_val))]
    #[schema_optional]
    /// Optional limit for this entitlement.
    Limit limit: null;

    /// Scope of this entitlement.
    /// Must match customer type for operations if defined, will look through customer refs for proper type match.
    str scope: null;

    /// Hidden entitlement?
    bool hidden: false;

    /// Event data field holding this entitlement's estimate basis (Ex. 'input' for input tokens).
    /// When set, estimates learn usage per unit of that value and scale each prediction by it, so a
    /// larger call gets a larger hold. It is read from the context or event data given to reserve(),
    /// settle(), observe(), and estimate() (a `basis` argument wins). Use the same field in every plan.
    str estimate_basis: null;

    /// Event data field whose value picks the estimate segment (Ex. 'model'): each value keeps its own
    /// estimate. A `segment` argument wins. Keep the values few: a model or a feature, never a user or
    /// request ID.
    str estimate_segment: null;


    /**
     * This entitlement's estimate inputs for one call, as (basis, segment, per_basis). A `basis` or
     * `segment` argument wins; otherwise the estimate_basis and estimate_segment fields are read from
     * the call's context (its event data). Basis is null when estimates aren't per basis, or when the
     * call has none - logged when `required`, since such a call can't be predicted or learned from.
     */
    fn estimate_inputs(context?: obj, basis?: float, segment?: str, required: bool = true) -> (float, str, bool) {
        const per_basis = self.estimate_basis != null && self.estimate_basis.len() > 0;
        let found_basis = null;
        if (per_basis) {
            found_basis = basis ?? context?.get(self.estimate_basis);
            if (found_basis != null) found_basis = (found_basis as float).remove_units();
            else if (required) err(`Limitr: '${Obj::name(self)}' estimates per '${self.estimate_basis}', but the call has none (pass it in the event data, or as basis)`);
        } else if (basis != null) {
            err(`Limitr: a basis was given for '${Obj::name(self)}', which has no estimate_basis (ignored)`);
        }

        let found_segment = segment;
        if (found_segment == null && self.estimate_segment != null && context != null) {
            const value = context.get(self.estimate_segment);
            if (value != null) found_segment = str(value);
        }
        (found_basis, found_segment, per_basis)
    }
}
