#[type]
/**
 * A Limitr entitlement limit.
 */
Limit: {
    /// Credit ID.
    str! credit: '';

    /// Mode.
    /// "hard" - (default) Deny immediately.
    /// "soft" - Allow, but emit overage events instead of changed events after limit.
    /// "observe" - Never deny, only record (unlimited value).
    str! mode: 'hard';

    /// Value of this limit.
    /// If a str, can use units, but must be a valid stof number.
    float | str value: 0;

    /// Optional increment for an operation with this limit.
    /// Used with <Limitr>.increment.
    /// If a str, can use units, but must be a valid stof number.
    float | str increment: 0;

    /// Should the meter reset after a certain period?
    bool resets: false;

    /// Optional reset increment (default 30 days).
    ms reset_inc: 30days;


    /**
     * Check this limit against a value.
     */
    fn check(value: float = 0) -> bool {
        if (value > (self.value as float) && self.mode != 'observe') {
            return false; // delay the "soft" mode check for events in limitr.stof
        }
        true
    }
}


#[type]
/**
 * A Limitr entitlement.
 */
Entitlement: {
    /// Enabled?
    bool enabled: true;

    /// Description for this entitlement.
    str description: '';

    /// Optional limit for this entitlement.
    Limit limit: null;


    /**
     * Check this entitlement.
     */
    fn check(value: float = 0) -> bool {
        if (!self.enabled) return false;
        if (self.limit != null) return self.limit.check(value);
        true
    }
}
