//
// Decision tests: allow() and check() with `detail = true`.
//
// By default both return a bool. With `detail` they return a map saying what was decided and why: `allowed`,
// `reason` (null when allowed), whose meter it is, the call's value, and where the customer stands after the call
// (allow) or as things are (check): used, limit, remaining, allowance, held, resets, access, and limit_source.
// Each way a call can be refused has its own reason, and some add fields (Ex. the denying cap).
//
Limitr TestDecisionsPolicy: {
    credits: {
        req: { label: 'Request' }
        tok: { price: { amount: 1 } } // 1 tok = $1, so a $5 cap is 5 tok
        mb: { label: 'Megabyte', stof_units: 'MB' }
    }

    plans: {
        p: {
            default: true
            entitlements: {
                api: { limit: { credit: 'req', mode: 'hard', value: 10 } }
                soft: { limit: { credit: 'req', mode: 'soft', value: 5 } }
                spend: { limit: { credit: 'tok', mode: 'soft', value: 0 } }
                flag: {}
                killed: { enabled: false }
                burst: {
                    limit: {
                        credit: 'req', mode: 'hard', value: 1000
                        governor_enabled: true, governor_capacity: 3, governor_refill_rate: 0.000001
                    }
                }
                pool: { scope: 'org', limit: { credit: 'req', mode: 'hard', value: 100 } }
                watch: { limit: { credit: 'req', mode: 'observe' } }
                storage: { limit: { credit: 'mb', mode: 'hard', value: '1000MB' } }
            }
        }
    }

    rules: {
        no_flag: { taken: { flag: {} } }
    }


    #[test]
    /**
     * Without `detail`, allow() and check() still return a bool.
     */
    fn test_default_is_bool() {
        self.create_customer('dec_bool', 'p');
        assert_eq(typeof self.check('dec_bool', 'api', 1), 'bool');
        assert_eq(typeof self.allow('dec_bool', 'api', 1, false), 'bool');
        assert_eq(typeof self.check('nobody', 'api', 1), 'bool');
        assert_eq(typeof self.allow('nobody', 'api', 1, false), 'bool');
    }


    #[test]
    /**
     * An allowed call: allow() reports where the customer stands after it, check() as things are.
     */
    fn test_allowed() {
        const id = 'dec_ok';
        self.create_customer(id, 'p');

        const checked: map = self.check(id, 'api', 4, detail = true);
        assert(checked.get('allowed'));
        assert_null(checked.get('reason'));
        assert_eq(checked.get('used'), 0);                 // check() counts nothing

        const d: map = self.allow(id, 'api', 4, false, detail = true);
        assert(d.get('allowed'));
        assert_null(d.get('reason'));
        assert_eq(d.get('customer'), id);
        assert_eq(d.get('entitlement'), 'api');
        assert_eq(d.get('value'), 4);
        assert_eq(d.get('credit'), 'req');
        assert_eq(d.get('mode'), 'hard');
        assert_eq(d.get('used'), 4);
        assert_eq(d.get('limit'), 10);
        assert_eq(d.get('remaining'), 6);
        assert_eq(d.get('allowance'), 6);
        assert_eq(d.get('held'), 0);
        assert_eq(d.get('access'), 'plan');
        assert_eq(d.get('limit_source'), 'plan');
        assert_eq(self.value(id, 'api'), 4);
    }


    #[test]
    /**
     * A feature flag (no limit) is allowed with no credit, mode, or limit to report.
     */
    fn test_flag() {
        const id = 'dec_flag';
        self.create_customer(id, 'p');
        const d: map = self.check(id, 'flag', detail = true);
        assert(d.get('allowed'));
        assert_null(d.get('credit'));
        assert_null(d.get('limit'));
        assert_null(d.get('limit_source'));
    }


    #[test]
    /**
     * A hard limit refuses with 'limit' and changes nothing. A soft limit allows past it.
     */
    fn test_limit() {
        const id = 'dec_limit';
        self.create_customer(id, 'p');
        assert(self.allow(id, 'api', 8, false));

        const checked: map = self.check(id, 'api', 5, detail = true);
        assert_not(checked.get('allowed'));
        assert_eq(checked.get('reason'), 'limit');

        const d: map = self.allow(id, 'api', 5, false, detail = true);
        assert_not(d.get('allowed'));
        assert_eq(d.get('reason'), 'limit');
        assert_eq(d.get('used'), 8);
        assert_eq(d.get('remaining'), 2);
        assert_eq(self.value(id, 'api'), 8);

        const soft: map = self.allow(id, 'soft', 7, false, detail = true);
        assert(soft.get('allowed'));
        assert_eq(soft.get('mode'), 'soft');
        assert_eq(soft.get('remaining'), -2);              // past the limit (billed as overage)
    }


    #[test]
    /**
     * A call that fits on its own, but not with room held by a reservation, is refused with 'held'.
     */
    fn test_held() {
        const id = 'dec_held';
        self.create_customer(id, 'p');
        const hold = self.reserve(id, 'api', 7);
        assert(hold != null);

        const checked: map = self.check(id, 'api', 5, detail = true);
        assert_eq(checked.get('reason'), 'held');
        assert_eq(checked.get('held'), 7);

        const d: map = self.allow(id, 'api', 5, false, detail = true);
        assert_eq(d.get('reason'), 'held');
        assert_eq(self.value(id, 'api'), 0);

        assert(self.release(id, 'api', hold));
        assert(self.allow(id, 'api', 5, false, detail = true).get('allowed'));
    }


    #[test]
    /**
     * A cap without room refuses with 'cap', naming the cap and the customer holding it.
     */
    fn test_cap() {
        const id = 'dec_cap';
        self.create_customer(id, 'p');
        assert(self.add_customer_cap(id, 5, 'budget', events = false));

        const checked: map = self.check(id, 'spend', 6, detail = true);
        assert_eq(checked.get('reason'), 'cap');
        assert_eq(checked.get('cap'), 'budget');
        assert_eq(checked.get('cap_customer'), id);

        const d: map = self.allow(id, 'spend', 6, false, detail = true);
        assert_not(d.get('allowed'));
        assert_eq(d.get('reason'), 'cap');
        assert_eq(d.get('cap'), 'budget');
        assert_eq(self.value(id, 'spend'), 0);

        assert(self.allow(id, 'spend', 5, false, detail = true).get('allowed'));
    }


    #[test]
    /**
     * A governor without enough tokens refuses with 'governor' and says how many are available.
     */
    fn test_governor() {
        const id = 'dec_gov';
        self.create_customer(id, 'p');
        assert(self.allow(id, 'burst', 2, false));

        const checked: map = self.check(id, 'burst', 2, detail = true);
        assert_eq(checked.get('reason'), 'governor');
        assert(checked.get('available') < 2);

        const d: map = self.allow(id, 'burst', 2, false, detail = true);
        assert_eq(d.get('reason'), 'governor');
        assert(d.get('available') < 2);
        assert_eq(self.value(id, 'burst'), 2);
    }


    #[test]
    /**
     * An entitlement whose `enabled` says no is refused with 'disabled'.
     */
    fn test_disabled() {
        const id = 'dec_off';
        self.create_customer(id, 'p');
        assert_eq(self.check(id, 'killed', detail = true).get('reason'), 'disabled');
        assert_eq(self.allow(id, 'killed', 1, false, detail = true).get('reason'), 'disabled');
    }


    #[test]
    /**
     * Each way of having no entitlement has its own reason.
     */
    fn test_missing() {
        assert_eq(self.check('dec_nobody', 'api', 1, detail = true).get('reason'), 'no_customer');
        assert_eq(self.allow('dec_nobody', 'api', 1, false, detail = true).get('reason'), 'no_customer');

        self.create_customer('dec_none', 'p');
        assert_eq(self.check('dec_none', 'teleport', detail = true).get('reason'), 'not_entitled');
        assert_eq(self.check('dec_none', 'pool', 1, detail = true).get('reason'), 'no_scope'); // no org up its refs

        self.create_customer('dec_taken', 'p');
        assert(self.take_entitlement('dec_taken', 'flag'));
        const taken: map = self.check('dec_taken', 'flag', detail = true);
        assert_eq(taken.get('reason'), 'taken');
        assert_eq(taken.get('access'), 'taken');

        self.create_customer('dec_expired', 'p');
        assert(self.set_customer_expires('dec_expired', Time::now() - 1ms, false));
        assert_eq(self.allow('dec_expired', 'api', 1, false, detail = true).get('reason'), 'expired');
    }


    #[test]
    /**
     * An alt ID decides for the customer it points at.
     */
    fn test_alt_id() {
        self.create_customer('dec_alt', 'p');
        assert(self.set_alt_customer_id('dec_alt', 'dec_alt_x', false));
        const d: map = self.allow('dec_alt_x', 'api', 1, false, detail = true);
        assert(d.get('allowed'));
        assert_eq(d.get('customer'), 'dec_alt');
        assert_eq(d.get('used'), 1);
    }


    #[test]
    /**
     * A scoped entitlement reports the customer whose meter it is (the org) and where access comes from.
     */
    fn test_scoped_customer() {
        self.create_customer('dec_org', 'p', 'org', 'Org');
        self.create_customer('dec_member', '', 'user', 'User', ['dec_org']);
        const d: map = self.allow('dec_member', 'pool', 3, false, detail = true);
        assert(d.get('allowed'));
        assert_eq(d.get('customer'), 'dec_org');
        assert_eq(d.get('used'), 3);
        assert_eq(self.value('dec_org', 'pool'), 3);
    }


    #[test]
    /**
     * A customer's own limit (an override) is the limit that decides, and the decision says so.
     */
    fn test_override_limit() {
        const id = 'dec_override';
        self.create_customer(id, 'p');
        assert(self.create_customer_override(id, 'api', value = 2) != null);
        const d: map = self.check(id, 'api', 3, detail = true);
        assert_eq(d.get('reason'), 'limit');
        assert_eq(d.get('limit'), 2);
        assert_eq(d.get('limit_source'), 'override');
    }


    #[test]
    /**
     * An entitlement taken by one of the customer's rules is 'taken', and `access` names the rule.
     */
    fn test_taken_by_rule() {
        const id = 'dec_rule';
        self.create_customer(id, 'p');
        assert(self.set_customer_rules(id, ['no_flag'], false));
        const d: map = self.check(id, 'flag', detail = true);
        assert_eq(d.get('reason'), 'taken');
        assert_eq(d.get('access'), 'rule:no_flag');
    }


    #[test]
    /**
     * An observe limit always allows and has no remaining (it only counts).
     */
    fn test_observe() {
        const id = 'dec_observe';
        self.create_customer(id, 'p');
        const d: map = self.allow(id, 'watch', 50, false, detail = true);
        assert(d.get('allowed'));
        assert_eq(d.get('mode'), 'observe');
        assert_eq(d.get('used'), 50);
        assert_null(d.get('remaining'));
    }


    #[test]
    /**
     * Values with units are reported in the credit's units, and refusals still say why.
     */
    fn test_units() {
        const id = 'dec_units';
        self.create_customer(id, 'p');
        const d: map = self.allow(id, 'storage', '500MB', false, detail = true);
        assert(d.get('allowed'));
        assert_eq(d.get('value'), 500);
        assert_eq(d.get('used'), 500);
        assert_eq(d.get('remaining'), 500);
        assert_eq(self.check(id, 'storage', '0.6GB', detail = true).get('reason'), 'limit');
    }


    #[test]
    /**
     * A decrement is allowed and reported like any call.
     */
    fn test_decrement() {
        const id = 'dec_down';
        self.create_customer(id, 'p');
        assert(self.allow(id, 'api', 5, false));
        const d: map = self.allow(id, 'api', -2, false, detail = true);
        assert(d.get('allowed'));
        assert_eq(d.get('value'), -2);
        assert_eq(d.get('used'), 3);
    }
}
