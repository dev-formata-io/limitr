Limitr TestMarginsPolicy: {
    credits: {
        basic_plan: {
            description: 'Basic Plan Subscription'
            stof_units: 'int'
            price: { amount: 10 }
        }

        pro_plan: {
            description: 'Basic Plan Subscription'
            stof_units: 'int'
            price: { amount: 50 }
        }

        ai_token: {
            description: 'AI token'
            overhead_cost: 0.000004
            stof_units: 'int'
            price: { amount: 0.000006 }
            resets: true
        }

        mb_storage: {
            description: 'MB of storage'
            overhead_cost: 0.6
            stof_units: 'MB'

            pricing_model: 'tiered'
            tiers: [
                { up_to: 5, price: { amount: 0.8 } },
                { up_to: 10, price: { amount: 0.7 } },
                { up_to: 50, price: { amount: 0.6 } },
                { price: { amount: 0.55 } },
            ]
        }
    }

    plans: {
        basic: {
            label: 'Basic'
            entitlements: {
                subscription: {
                    description: 'Base plan subscription'
                    limit: {
                        credit: 'basic_plan'
                        mode: 'soft'
                        value: 0
                    }
                }
                file_storage: {
                    description: 'File storage'
                    limit: {
                        credit: 'mb_storage'
                        mode: 'soft'
                        value: 2MB
                    }
                }
            }
        }
        pro: {
            label: 'Pro'
            entitlements: {
                subscription: {
                    description: 'Pro plan subscription'
                    limit: {
                        credit: 'pro_plan'
                        mode: 'soft'
                        value: 0
                    }
                }
                file_storage: {
                    description: 'File storage'
                    limit: {
                        credit: 'mb_storage'
                        mode: 'soft'
                        value: 10MB
                    }
                }

                tokens: {
                    description: 'AI tokens'
                    limit: {
                        credit: 'ai_token'
                        mode: 'soft'
                        value: 100_000
                        resets: true
                        reset_inc: 1day
                    }
                }
            }
        }
    }


    #[test]
    fn test_storage_margins() {
        const id = 'local_margin_customer';
        self.create_customer(id, 'pro');

        self.increment(id, 'subscription');
        self.allow(id, 'file_storage', 70MB);
        self.allow(id, 'tokens', 2_300_000);

        const breakdown = self.customer_local_margin_breakdown(id);
        assert_eq(breakdown.get('revenue') - 50, 50.2);
        assert_eq(breakdown.get('margin'), 48.9);
    }


    #[test]
    fn test_local_breakdown() {
        const breakdown = self.local_margin_breakdown('pro', {
            'subscription': 1,
            'file_storage': 70MB,
            'tokens': {
                'meter': 100_000,
                'limit': 100_000
            }
        });
        assert_eq(breakdown.get('revenue') - 50, 37);
        assert_eq(breakdown.get('margin'), 37.93);
        drop(breakdown);
    }
}
