Limitr TestPlansPolicy: {
    const base_user: 'base_user'
    const pro_user: 'pro_user'

    credits: {
        seat: {}
        base: { price: { amount: 10 } }
        pro: { price: { amount: 50 } }
    }
    plans: {
        base: {
            default: true
            trial_period: 50ms
            label: 'Base Plan'
            period: 'monthly'
            entitlements: {
                subscription: {
                    limit: {
                        credit: 'base'
                        mode: 'soft'
                    }
                }

                seats: {
                    limit: {
                        credit: 'seat'
                        hard_trailing: true
                        value: 5
                    }
                }
            }
        }
        pro: {
            label: 'Pro Plan'
            period: 'daily'
            entitlements: {
                subscription: {
                    limit: {
                        credit: 'pro'
                        mode: 'soft'
                    }
                }

                seats: {
                    limit: {
                        credit: 'seat'
                        hard_trailing: true
                        value: 2
                    }
                }
            }
        }
    }


    #[init]
    fn add_test_customers() {
        self.create_customer(self.base_user, 'base', 'user', 'Base User');
        self.create_customer(self.pro_user, 'pro', 'user', 'Pro User');

        self.ensure_plan_subscription(self.base_user);
        self.ensure_plan_subscription(self.pro_user);
    }


    #[test]
    fn valid_policy() {
        assert(self.valid());
    }


    #[test]
    fn get_plan_by_id() {
        const plan = self.plan('base');
        assert(plan);
        assert_eq(plan.name, 'base');
        assert_eq(plan.label, 'Base Plan');
    }


    #[test]
    fn get_plan_for_customer() {
        const base = self.plan(self.base_user);
        assert(base);
        assert_eq(base, self.plans.base);

        const pro = self.plan(self.pro_user);
        assert(pro);
        assert_eq(pro, self.plans.pro);
    }


    #[test]
    fn get_default_plan() {
        const default = self.default_plan();
        assert(default);
        assert_eq(default, self.plans.base);
    }


    #[test]
    fn delete_set_plan() {
        const base = self.plan('base');
        assert(base);

        const base_json = stringify('json', base);
        assert(self.delete_plan('base'));
        assert_not(base.exists());

        self.set_plan('base', base_json);
        const def = self.default_plan();
        assert(def);
        assert_eq(def, self.plans.base);
    }


    #[test]
    fn subscription_quantities() {
        const sub_name = self.plan_sub_entitlement_name(self.base_user);
        assert_eq(sub_name, 'subscription');
        assert_eq(self.value(self.base_user, sub_name), 0);
        assert_eq(self.value(self.pro_user, sub_name), 1); // no trial period

        sleep(50ms);
        self.ensure_plan_subscription(self.base_user);
        assert_eq(self.value(self.base_user, sub_name), 1); // trial is up
    }


    #[meter-changed]
    fn meter_changing_events(context: obj) {
        if (context.event_data.context == 'trailing_limits') ?context.event_data.op();
    }

    
    #[test]
    fn hard_trailing_limits() {
        const id = 'test_base_user';

        const ctx = new {
            context: 'trailing_limits'
            count: 0
            op: () => { self.count += 1; }
        };

        self.create_customer(id, 'base', 'user', 'Base User');
        assert(self.allow(id, 'seats', 5, ctx));
        assert_not(self.increment(id, 'seats'));

        assert(self.allow(id, 'seats', -1, ctx));
        assert(self.allow(id, 'seats', 3, ctx));
        assert_not(self.increment(id, 'seats'));
        assert_eq(self.remaining(id, 'seats'), -2);

        assert_eq(ctx.count, 3);
        drop(ctx);
    }
}