Limitr policy: {
    credits: {
        Credit seat: {
            unit: 'seat'
            version: 0.1.0-test
            label: 'Seat'
        }

        Credit token: {
            unit: 'token'
            label: 'Token'
        }

        Credit mb: {
            unit: 'megabyte'
            description: 'A single megabyte of usage in our platform.'
            label: 'Megabytes'
            stof_units: 'MB'
        }
    }

    plans: {
        #[type('Free')]
        Plan free: {
            label: 'Free Plan'
            version: 0.1.0-test
            entitlements: {
                Entitlement prep: {
                    description: 'Allow a user to do prep.'
                }
                Entitlement spend: {
                    description: 'Unlimited token spend.'
                    Limit limit: {
                        credit: 'token'
                        mode: 'observe'
                    }
                }
                Entitlement usage: {
                    description: 'How many Megabytes of usage does this user get?'
                    Limit limit: {
                        credit: 'mb'
                        value: 1GB
                        resets: true
                        reset_inc: 30days // 1GB per month, tracked in MB
                    }
                }
            }
        }

        Plan paid: {
            label: 'Paid Plan'
            version: 0.1.2-test
            entitlements: {
                Entitlement prep: <Free>.entitlements.prep
                Entitlement spend: <Free>.entitlements.spend
                Entitlement usage: {
                    description: 'How many Megabytes of usage does this user get?'
                    Limit limit: {
                        credit: 'mb'
                        value: '2GB' // can just be 2GB too ofc
                        resets: true
                        reset_inc: 30days // 2GB per month, tracked in MB
                    }
                }
                Entitlement chat: {
                    description: 'Allow user to chat.'
                    Limit limit: {
                        credit: 'seat'
                        increment: 1
                        value: 3
                    }
                }
            }
        }
    }

    #[init]
    fn init_test_subjects() {
        self.create_subject('me', 'paid', alts=['cj']);
    }
}

#[test]
fn global_policy() {
    assert_eq(<Limitr>.api.get(), self.policy);
}

#[test]
fn verify_plans() {
    assert(self.policy.plan('free'));
    assert(self.policy.plan('paid'));
}

#[test]
fn verify_me_subject() {
    const me = self.policy.subject('me');
    assert(me);
    assert_eq(self.policy.plan_for('me'), self.policy.plan('paid'));
    assert_eq(self.policy.subject('cj'), me);
    assert_eq(self.policy.plan_for('cj'), self.policy.plan('paid'));
}

#[test]
fn add_remove_subject() {
    assert(self.policy.create_subject('formata', 'free', 'organization', 'Formata'));
    assert_eq(self.policy.plan_for('formata'), self.policy.plan('free'));

    self.policy.set_alt_subject_id('formata', 'fmta');
    assert(self.policy.subject('fmta'));
    self.policy.delete_alt_subject_id('fmta');
    assert_not(self.policy.subject('fmta'));
    assert(self.policy.subject('formata'));

    self.policy.delete_subject('formata');
    assert_not(self.policy.subject('formata'));
}

#[test]
fn plan_entitlements() {
    const prep = self.policy.entitlement('cj', 'prep');
    assert(prep);
    const chat = self.policy.entitlement('paid', 'chat');
    assert(chat);

    const free_prep = <Limitr>.api.entitlement('free', 'prep');
    assert(free_prep);
    assert_eq(free_prep, prep);
}

#[test]
fn seat_credit() {
    assert(self.policy.credit('seat'));
}

#[test]
fn boolean_check() {
    assert(self.policy.check('cj', 'prep'));
}

#[test]
fn seat_check() {
    assert_eq(self.policy.limit('cj', 'chat'), 3);

    assert(self.policy.meter('cj', 'chat', 1));
    assert_eq(self.policy.balance('cj', 'chat'), 2);
    assert(self.policy.meter('cj', 'chat', 1));
    assert_eq(self.policy.balance('cj', 'chat'), 1);
    assert(self.policy.check('cj', 'chat', 1));
    assert(self.policy.increment('cj', 'chat')); // max 3
    assert_eq(self.policy.balance('cj', 'chat'), 0);
    assert_not(self.policy.check('cj', 'chat', 1));
    assert_not(self.policy.increment('cj', 'chat'));

    assert(self.policy.meter('cj', 'chat', -1));
    assert(self.policy.meter('cj', 'chat', 1)); // max 3
    assert_not(self.policy.meter('cj', 'chat', 1));

    assert_eq(self.policy.cost('me', 'chat'), 1);
}

#[test]
fn unlimited_spend() {
    assert(self.policy.meter('cj', 'spend', 30.56));
    assert(self.policy.check('cj', 'spend', 100));
    assert(self.policy.meter('cj', 'spend', 44.34));
    assert(self.policy.meter('cj', 'spend', -34));
    assert_eq(self.policy.value('cj', 'spend').round(1), 40.9);

    const credit = self.policy.credit_for('cj', 'spend');
    assert_eq(credit.unit, 'token');
    assert_eq(credit.exchange, 1);
}

#[test]
fn usage_units() {
    // paid plan usage test
    assert_eq(self.policy.limit('cj', 'usage'), 2GB);
    assert_eq(typename self.policy.limit('cj', 'usage'), 'MB'); // return in credit's units

    assert(self.policy.meter('cj', 'usage', 3)); // default is credit units (MB)
    assert_eq(self.policy.value('cj', 'usage'), 3MB);
    assert(self.policy.meter('cj', 'usage', '-3MB')); // can use strings instead of just numbers (non-stof contexts)

    assert(self.policy.meter('cj', 'usage', 500MB));
    assert(self.policy.meter('cj', 'usage', 1GB));
    assert(self.policy.meter('cj', 'usage', 2_000_000bytes));

    let val = self.policy.value('cj', 'usage');
    assert_eq(typename val, 'MB');
    assert_eq(val, 1502MB);
    assert_eq(val, 1.502GB);

    assert_not(self.policy.meter('cj', 'usage', 500MB));
    assert_not(self.policy.meter('cj', 'usage', 1GB));
    assert(self.policy.meter('cj', 'usage', 10MiB));

    val = self.policy.value('cj', 'usage');
    let balance = self.policy.balance('cj', 'usage');
    assert_eq(val.round(2), 1512.49MB);
    assert_eq(balance.round(2), 487.51MB); // The MiB made things more floaty
}
