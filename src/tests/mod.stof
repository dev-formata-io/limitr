Policy: {
    #[run]
    Credit seat: {
        id: 'seat'
        unit: 'seat'
        version: 0.1.0-test
        label: 'Seat'
    }


    #[run]
    Credit token: {
        id: 'token'
        unit: 'token'
        version: 0.1.0-test
        label: 'Token'
    }


    #[run]
    #[type('FreePlan')]
    Plan free: {
        id: 'free'
        label: 'Free Plan'
        version: 0.1.0-test
        entitlements: {
            Entitlement prep: {
                description: 'Allow a user to do prep.'
            }

            Entitlement spend: {
                description: 'Unlimited token spend.'
                Limit limit: {
                    credit: 'token'
                    unlimited: true
                }
            }
        }
    }


    #[run]
    Plan paid: {
        id: 'paid'
        label: 'Paid Plan'
        version: 0.1.2-test
        entitlements: {
            free: <FreePlan> // add all entitlements from the free plan

            Entitlement chat: {
                description: 'Allow user to chat.'
                Limit limit: {
                    credit: 'seat'
                    increment: 1
                    value: 3
                }
            }
        }
    }


    #[run]
    Subject me: {
        id: 'me'
        plan: 'paid'
        alt_ids: ['cj']
    }
}

#[init]
fn init_policy_state() {
    self.Policy.run();
}

#[test]
fn verify_plans() {
    assert(<State>.plan('free'));
    assert(<State>.plan('paid'));
}

#[test]
fn verify_me_subject() {
    const me = <State>.subject('me');
    assert(me);
    assert_eq(<State>.plan_for('me'), <State>.plan('paid'));
    assert_eq(<State>.subject('cj'), me);
    assert_eq(<State>.plan_for('cj'), <State>.plan('paid'));
}

#[test]
fn add_remove_subject() {
    assert(<State>.create_subject('formata', 'free', 'organization', 'Formata'));
    assert_eq(<State>.plan_for('formata'), <State>.plan('free'));

    <State>.set_alt_subject_id('formata', 'fmta');
    assert(<State>.subject('fmta'));
    <State>.delete_alt_subject_id('fmta');
    assert_not(<State>.subject('fmta'));
    assert(<State>.subject('formata'));

    <State>.delete_subject('formata');
    assert_not(<State>.subject('formata'));
}

#[test]
fn plan_entitlements() {
    const prep = <State>.entitlement('cj', 'prep');
    assert(prep);
    const chat = <State>.entitlement('paid', 'chat');
    assert(chat);

    const free_prep = <State>.entitlement('free', 'prep');
    assert(free_prep);
    assert_neq(free_prep, prep);
}

#[test]
fn seat_credit() {
    assert(<State>.credit('seat'));
}

#[test]
fn boolean_check() {
    assert(<State>.check('cj', 'prep'));
}

#[test]
fn seat_check() {
    assert(<State>.meter('cj', 'chat', 1));
    assert(<State>.meter('cj', 'chat', 1));
    assert(<State>.check('cj', 'chat', 1));
    assert(<State>.increment('cj', 'chat')); // max 3
    assert_not(<State>.check('cj', 'chat', 1));
    assert_not(<State>.increment('cj', 'chat'));

    assert(<State>.meter('cj', 'chat', -1));
    assert(<State>.meter('cj', 'chat', 1)); // max 3
    assert_not(<State>.meter('cj', 'chat', 1));

    assert_eq(<State>.cost('me', 'chat'), 1);
}

#[test]
fn unlimited_spend() {
    assert(<State>.meter('cj', 'spend', 30.56));
    assert(<State>.check('cj', 'spend', 100));
    assert(<State>.meter('cj', 'spend', 44.34));
    assert(<State>.meter('cj', 'spend', -34));
    assert_eq(<State>.value('cj', 'spend').round(1), 40.9);

    const credit = <State>.credit_for('cj', 'spend');
    assert_eq(credit.id, 'token');
    assert_eq(credit.exchange, 1);
}
