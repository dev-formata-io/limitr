Limitr policy: {
    credits: {
        Credit seat: {
            unit: 'seat'
            version: 0.1.0-test
            label: 'Seat'
        }

        Credit token: {
            unit: 'token'
            label: 'Token'
        }

        Credit mb: {
            unit: 'megabyte'
            description: 'A single megabyte of usage in our platform.'
            label: 'Megabytes'
            stof_units: 'MB'
        }

        Credit overage_token: {
            description: 'A token for overage'
            stof_units: 'int'
        }
    }

    plans: {
        #[type('Free')]
        Plan free: {
            default: true
            label: 'Free Plan'
            version: 0.1.0-test
            entitlements: {
                Entitlement seats: {
                    description: 'How many seats does this org get?'
                    scope: 'org'
                    Limit limit: {
                        credit: 'seat'
                        value: 3
                        increment: 1
                    }
                }
                Entitlement prep: {
                    description: 'Allow a user to do prep.'
                }
                Entitlement spend: {
                    description: 'Unlimited token spend.'
                    Limit limit: {
                        credit: 'token'
                        mode: 'observe'
                    }
                }
                Entitlement usage: {
                    description: 'How many Megabytes of usage does this user get?'
                    Limit limit: {
                        credit: 'mb'
                        value: 1GB
                        resets: true
                        reset_inc: 30days // 1GB per month, tracked in MB
                    }
                }
                Entitlement overage_spend: {
                    description: 'A test entitlement for overage credit grants'
                    Limit limit: {
                        credit: 'overage_token'
                        value: 0 // immediate overage
                        mode: 'soft'
                    }
                }
            }
        }

        Plan paid: {
            label: 'Paid Plan'
            version: 0.1.2-test
            entitlements: {
                Entitlement prep: <Free>.entitlements.prep
                Entitlement spend: <Free>.entitlements.spend
                Entitlement usage: {
                    description: 'How many Megabytes of usage does this user get?'
                    Limit limit: {
                        credit: 'mb'
                        value: '2GB' // can just be 2GB too ofc
                        resets: true
                        reset_inc: 30days // 2GB per month, tracked in MB
                    }
                }
                Entitlement chat: {
                    description: 'Allow user to chat.'
                    Limit limit: {
                        credit: 'seat'
                        increment: 1
                        value: 3
                    }
                }
            }
        }
    }


    #[init]
    fn init_test_customers() {
        self.create_customer('me', 'paid', alts=['cj']);

        self.create_customer('free_org', 'free', 'org', 'Free Org');
        self.create_customer('free_user_1', '', refs=['free_org']);
        self.create_customer('free_user_2', '', refs=['free_org']);

        self.create_customer('override_user_1', 'free', 'org', 'Overridden Org');
        self.create_customer_override('override_user_1', 'seats', value = 5);

        self.create_customer('default_user', metadata = new { email: 'info@limitr.dev' });

        self.create_customer('overage_user', label='Overage User');
    }


    #[meter-overage]
    /// Simulate the overage counters for soft usage on 'overage_user'.
    fn meter_overage_event_handler(event_value: obj) {
        const customer = event_value.customer;
        const entitlement = event_value.entitlement;
        if (customer.id == 'overage_user' && entitlement == 'overage_spend') {
            if (customer.metadata) {
                if (customer.metadata.overage) {
                    customer.metadata.overage += event_value.overage;
                } else {
                    customer.metadata.overage = event_value.overage;
                }
            } else {
                customer.metadata = new {
                    overage: event_value.overage;
                } on customer;
            }
        }
    }
}

#[test]
fn default_plans() {
    const def = self.policy.plan('');
    assert_eq(def.name, 'free');
    assert_eq(def, self.policy.plans.free);

    const pf = self.policy.plan_for('default_user');
    assert_eq(pf, def);

    const email = self.policy.customer_metadata('default_user').email;
    assert_eq(email, 'info@limitr.dev');
}

#[test]
fn credit_grant_overage() {
    const user = 'overage_user';
    const ent = 'overage_spend';
    const customer = self.policy.customer(user);
    assert(customer);

    assert(self.policy.allow(user, ent, 5));
    assert_eq(customer.metadata.overage, 5); // soft limit of 0

    // lets give our user a grant of credits
    assert(self.policy.create_customer_credit_grant(user, 'overage_token', 300));
    assert(self.policy.allow(user, ent, 200));
    assert_eq(customer.metadata.overage, 5);
    assert_eq(customer.grants[0][1].value, 100); // 100 remaining on the grant

    assert(self.policy.allow(user, ent, 200));
    assert_eq(customer.metadata.overage, 105); // all time overage of 105
    assert_not(customer.grants[0]); // ont-time grant was used up completely!
}

#[test]
fn customer_seat_override() {
    const user = 'override_user_1';
    assert(self.policy.increment(user, 'seats'));
    assert_eq(self.policy.limit(user, 'seats'), 5);
    assert_eq(self.policy.remaining(user, 'seats'), 4);
    assert_eq(self.policy.value(user, 'seats'), 1);
    assert(self.policy.allow(user, 'seats', 3));
    assert(self.policy.allow(user, 'seats', 1)); // 5
    assert_not(self.policy.increment(user, 'seats')); // blocked by override
}

#[test]
fn global_policy() {
    assert_eq(<Limitr>.api.get(), self.policy);
}

#[test]
fn verify_plans() {
    assert(self.policy.plan('free'));
    assert(self.policy.plan('paid'));
}

#[test]
fn verify_me_customer() {
    const me = self.policy.customer('me');
    assert(me);
    assert_eq(self.policy.plan_for('me'), self.policy.plan('paid'));
    assert_eq(self.policy.customer('cj'), me);
    assert_eq(self.policy.plan_for('cj'), self.policy.plan('paid'));
}

#[test]
fn add_remove_customer() {
    assert(self.policy.create_customer('formata', 'free', 'organization', 'Formata'));
    assert_eq(self.policy.plan_for('formata'), self.policy.plan('free'));

    self.policy.set_alt_customer_id('formata', 'fmta');
    assert(self.policy.customer('fmta'));
    self.policy.delete_alt_customer_id('fmta');
    assert_not(self.policy.customer('fmta'));
    assert(self.policy.customer('formata'));

    self.policy.delete_customer('formata');
    assert_not(self.policy.customer('formata'));
}

#[test]
fn plan_entitlements() {
    const prep = self.policy.entitlement('cj', 'prep');
    assert(prep);
    const chat = self.policy.entitlement('paid', 'chat');
    assert(chat);

    const free_prep = <Limitr>.api.entitlement('free', 'prep');
    assert(free_prep);
    assert_eq(free_prep, prep);
}

#[test]
fn seat_credit() {
    assert(self.policy.credit('seat'));
}

#[test]
fn boolean_check() {
    assert(self.policy.check('cj', 'prep'));
}

#[test]
fn seat_check() {
    assert_eq(self.policy.limit('cj', 'chat'), 3);

    assert(self.policy.allow('cj', 'chat', 1));
    assert_eq(self.policy.remaining('cj', 'chat'), 2);
    assert(self.policy.allow('cj', 'chat', 1));
    assert_eq(self.policy.remaining('cj', 'chat'), 1);
    assert(self.policy.check('cj', 'chat', 1));
    assert(self.policy.increment('cj', 'chat')); // max 3
    assert_eq(self.policy.remaining('cj', 'chat'), 0);
    assert_not(self.policy.check('cj', 'chat', 1));
    assert_not(self.policy.increment('cj', 'chat'));

    assert(self.policy.allow('cj', 'chat', -1));
    assert(self.policy.allow('cj', 'chat', 1)); // max 3
    assert_not(self.policy.allow('cj', 'chat', 1));

    assert_eq(self.policy.cost('me', 'chat'), 1);
}

#[test]
fn unlimited_spend() {
    assert(self.policy.allow('cj', 'spend', 30.56));
    assert(self.policy.check('cj', 'spend', 100));
    assert(self.policy.allow('cj', 'spend', 44.34));
    assert(self.policy.allow('cj', 'spend', -34));
    assert_eq(self.policy.value('cj', 'spend').round(1), 40.9);

    const credit = self.policy.credit_for('cj', 'spend');
    assert_eq(credit.unit, 'token');
    assert_eq(credit.exchange, 0);
}

#[test]
fn usage_units() {
    // paid plan usage test
    assert_eq(self.policy.limit('cj', 'usage'), 2GB);
    assert_eq(typename self.policy.limit('cj', 'usage'), 'MB'); // return in credit's units

    assert(self.policy.allow('cj', 'usage', 3)); // default is credit units (MB)
    assert_eq(self.policy.value('cj', 'usage'), 3MB);
    assert(self.policy.allow('cj', 'usage', '-3MB')); // can use strings instead of just numbers (non-stof contexts)

    assert(self.policy.allow('cj', 'usage', 500MB));
    assert(self.policy.allow('cj', 'usage', 1GB));
    assert(self.policy.allow('cj', 'usage', 2_000_000bytes));

    let val = self.policy.value('cj', 'usage');
    assert_eq(typename val, 'MB');
    assert_eq(val, 1502MB);
    assert_eq(val, 1.502GB);

    assert_not(self.policy.allow('cj', 'usage', 500MB));
    assert_not(self.policy.allow('cj', 'usage', 1GB));
    assert(self.policy.allow('cj', 'usage', 10MiB));

    val = self.policy.value('cj', 'usage');
    let remaining = self.policy.remaining('cj', 'usage');
    assert_eq(val.round(2), 1512.49MB);
    assert_eq(remaining.round(2), 487.51MB); // The MiB made things more floaty
}

#[test]
fn org_scope_entitlements() {
    assert(self.policy.increment('free_user_1', 'seats'));
    assert(self.policy.increment('free_org', 'seats'));

    // test limit, remaining, costs, & value
    assert_eq(self.policy.limit('free_user_1', 'seats'), 3);
    assert_eq(self.policy.limit('free_user_2', 'seats'), 3);
    assert_eq(self.policy.limit('free_org', 'seats'), 3);
    assert_eq(self.policy.remaining('free_user_1', 'seats'), 1);
    assert_eq(self.policy.remaining('free_user_2', 'seats'), 1);
    assert_eq(self.policy.remaining('free_org', 'seats'), 1);
    assert_eq(self.policy.cost('free_user_1', 'seats'), 1);
    assert_eq(self.policy.cost('free_user_2', 'seats'), 1);
    assert_eq(self.policy.cost('free_org', 'seats'), 1);
    assert_eq(self.policy.value('free_user_1', 'seats'), 2);
    assert_eq(self.policy.value('free_user_2', 'seats'), 2);
    assert_eq(self.policy.value('free_org', 'seats'), 2);

    assert(self.policy.increment('free_user_2', 'seats')); // last for org

    assert_not(self.policy.increment('free_user_1', 'seats'));
    assert_not(self.policy.increment('free_user_2', 'seats'));
    assert_not(self.policy.increment('free_org', 'seats'));
}
