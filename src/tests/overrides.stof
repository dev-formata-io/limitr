//
// Override tests: a type that extends Limitr (or a function on the policy itself) replaces an engine
// function and can still call the engine's version with self.<name><Limitr>(...). An override keeps the
// engine function's signature (SDKs pass arguments by position).
//
#[type]
Limitr TestGuardedLimitr: {
    /// Entitlements this policy refuses before the engine looks at them.
    list blocked: ['beta'];

    fn allow(id: str!, entitlement: str!, value: float | str = 0, event: bool | str | obj = true, cap: Cap | map = null, overhead?: float, force: bool = false) -> bool {
        if (self.blocked.contains(entitlement)) return false;
        self.allow<Limitr>(id, entitlement, value, event, cap, overhead, force)
    }
}


OverrideTests: {
    #[test]
    fn test_type_override_calls_engine() {
        using holder = new {};
        parse(`TestGuardedLimitr policy: {
            credits: { req: {} }
            plans: { p: { default: true, entitlements: {
                api: { limit: { credit: 'req', mode: 'hard', value: 2 } }
                beta: { limit: { credit: 'req', mode: 'hard', value: 2 } }
            } } }
        }`, holder, 'stof');
        const policy: Limitr = holder.policy;
        assert(policy.instance_of('TestGuardedLimitr'));
        policy.create_customer('ada');

        assert(policy.allow('ada', 'api', 1, false));
        assert(policy.allow('ada', 'api', 1, false));
        assert_not(policy.allow('ada', 'api', 1, false)); // the engine's limit still applies
        assert_not(policy.allow('ada', 'beta', 1, false)); // refused by the override
        assert_eq(policy.value('ada', 'beta'), 0);
    }


    #[test]
    fn test_policy_function_override_calls_engine() {
        using holder = new {};
        parse(`Limitr policy: {
            calls: 0
            credits: { req: {} }
            plans: { p: { default: true, entitlements: { api: { limit: { credit: 'req', mode: 'hard', value: 1 } } } } }

            fn allow(id: str!, entitlement: str!, value: float | str = 0, event: bool | str | obj = true, cap: Cap | map = null, overhead?: float, force: bool = false) -> bool {
                self.calls += 1;
                self.allow<Limitr>(id, entitlement, value, event, cap, overhead, force)
            }
        }`, holder, 'stof');
        const policy: Limitr = holder.policy;
        policy.create_customer('bo');
        assert(policy.allow('bo', 'api', 1, false));
        assert_not(policy.allow('bo', 'api', 1, false));
        assert_eq(policy.calls, 2);
    }
}
