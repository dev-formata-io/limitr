//
// Limitr Network (see SPEC.md): one policy uses another's services and pays for them, peer to peer.
//
// A policy's `network` object says who it is and what it offers:
//
//   network: {
//       key: '<public key>'                 // this policy's identity (the host holds the secret key)
//       provider: {                         // optional: what this policy offers
//           name: 'acme_weather'            // letters, numbers, _ and - (names its capabilities on the other side)
//           label: 'Acme Weather'
//           url: 'https://api.acme.example'
//           offers: ['agent']               // plans offered on the network
//           endpoints: { forecast: { method: 'GET', path: '/forecast', entitlement: 'forecasts', ... } }
//       }
//   }
//
// Every function here is static and takes the policy (a Limitr object) first. The host moves messages (HTTP) and
// signs with the policy's key; everything else happens here, the same in every SDK.
//

#[type]
/**
 * The Limitr Network protocol.
 */
Network: {
    /// Module version.
    ver version: 0.1.0;

    #[type_ignore]
    /// Prototype-only constant - reference as <Network>.PROTOCOL.
    str PROTOCOL: 'limitr-network/0.1';

    #[type_ignore]
    /// Prototype-only constant - reference as <Network>.SKEW. How far a request's time may be from ours.
    ms SKEW: 60s;

    #[type_ignore]
    /// Prototype-only constant - reference as <Network>.WINDOW. How many recent request numbers a voucher keeps
    /// (calls can arrive out of order; anything older than the window is refused).
    int WINDOW: 64;

    #[type_ignore]
    /// Prototype-only constant - reference as <Network>.LINK. The one function in a connection's link: the HTTP
    /// call to the provider. It runs confined to the provider's host.
    str LINK: "fn fetch(method: str, path: str, body: str, headers: map) -> map { const resp = await Http::fetch(self.url + path, method.lower(), body.len() > 0 ? body : null, headers); map(('status', resp.get('status')), ('headers', resp.get('headers') ?? map()), ('body', Http::text(resp))) }";


    /*****************************************************************************
     * Provider.
     *****************************************************************************/

    #[static]
    /**
     * This policy's manifest: the terms it offers (plans, the credits they use, and endpoints), signed. Publish it
     * at GET /.well-known/limitr-network.
     */
    fn manifest(policy: obj!) -> str {
        using body = new {};
        <Network>.terms(policy, body);
        <Network>.envelope(policy, 'manifest', '', body, 1day)
    }


    #[static]
    /**
     * Accept (or refuse) a consumer's voucher. Creates or updates the voucher's customer (type 'voucher', ID
     * 'nv_<voucher>') on its plan, with a cap from its spend and an expiry, and returns the signed grant: the
     * endpoints it reaches. Refusals come back signed too (type 'refused', with a reason).
     */
    fn accept(policy: obj!, envelope: str!) -> str {
        using msg = new {};
        try <Network>.open(policy, envelope, 'voucher', msg);
        catch (e, message) return <Network>.refuse(policy, null, null, message);

        const b = msg.body;
        const provider = policy.network.provider;
        const now: ms = Time::now();
        const asked: ms = b.expires ?? 0;   // times are ms (a time with other units would compare by its number)
        const longest: ms = now + (provider.max_voucher ?? 30days);
        const id = 'nv_' + (b.voucher ?? '');
        let reason = null;
        if (!<Network>.valid_name(b.voucher)) reason = 'the voucher needs an ID (letters, numbers, _ and -)';
        else if (!(provider.offers ?? []).contains(b.plan) || policy.plans.get(b.plan) == null) reason = `plan '${b.plan}' isn't offered`;
        else if ((typeof b.spend != 'int' && typeof b.spend != 'float') || b.spend <= 0) reason = 'the voucher needs a spend';
        else if (b.expires == null || asked <= now) reason = 'the voucher has expired';
        else if (b.terms != <Network>.terms_digest(policy)) reason = 'these terms have changed: read the manifest again';
        if (reason != null) return <Network>.refuse(policy, msg.from, b.voucher, reason);

        // a provider may shorten a voucher, never lengthen it
        const expires: ms = asked < longest ? asked : longest;

        let customer: Customer = policy.customer(id);
        if (customer == null) {
            customer = policy.create_customer(id, b.plan, 'voucher', b.name ?? 'Voucher');
            if (customer == null) return <Network>.refuse(policy, msg.from, b.voucher, 'the voucher could not be accepted');
            customer.metadata = new {} on customer;
            customer.metadata.network = new { key: msg.from, voucher: b.voucher, seq: 0, terms: b.terms, n: 0, seen: [] } on customer.metadata;
        } else {
            const net = customer.metadata?.network;
            if (net == null || net.key != msg.from) return <Network>.refuse(policy, msg.from, b.voucher, 'this voucher belongs to another key');
            if (b.seq <= net.seq) return <Network>.refuse(policy, msg.from, b.voucher, 'a newer voucher was already accepted');
            if (b.plan != customer.plan) return <Network>.refuse(policy, msg.from, b.voucher, 'a voucher keeps its plan: send a new voucher for another plan');
        }
        const net = customer.metadata.network;
        net.seq = b.seq;
        net.terms = b.terms;

        // the spend is a cap (in runes) on everything this customer uses
        const cap = customer.caps.get('network');
        if (cap != null) cap.value = b.spend;
        else policy.add_customer_cap(id, b.spend, 'network');
        policy.set_customer_expires(id, expires);

        using grant = new {
            voucher: b.voucher,
            seq: b.seq,
            customer: id,
            plan: b.plan,
            spend: b.spend,
            expires,
            url: provider.url,
        };
        grant.endpoints = new {} on grant;
        for (const (name, endpoint) in (provider.endpoints ?? new {}).fields()) {
            if (endpoint.plans == null || endpoint.plans.contains(b.plan)) {
                const copied = new {} on grant.endpoints;
                parse(stringify('json', endpoint), copied, 'json');
                grant.endpoints.insert(name, copied);
            }
        }
        <Network>.envelope(policy, 'grant', msg.from, grant)
    }


    #[static]
    /**
     * Handle a request to one of this policy's endpoints. `headers` are the request's headers (lower-case names);
     * `path` includes the query string. Checks the signature, the voucher, and replay, then meters the call with
     * allow(). Returns a map:
     *   allowed (bool), status (200, 401 bad request, 402 not allowed: limit, spend, or expiry), endpoint (its
     *   name), customer (the voucher's customer), reason (when not allowed), and receipt (the signed receipt to send
     *   back in the Limitr-Network-Receipt header, when the voucher is known).
     * Do the work only when allowed is true.
     */
    fn handle(policy: obj!, method: str!, path: str!, body: str!, headers: map!) -> map {
        const request = headers.get('limitr-network-request');
        const signature = headers.get('limitr-network-signature');
        if (typeof request != 'str' || typeof signature != 'str') return <Network>.result(false, 401, null, null, 'not a Limitr Network request', null);

        using req = new {};
        try parse(request, req, 'json');
        catch return <Network>.result(false, 401, null, null, 'not a Limitr Network request', null);

        const id = 'nv_' + (req.voucher ?? '');
        const customer: Customer = <Network>.valid_name(req.voucher) ? policy.customer(id) : null;
        const net = customer?.metadata?.network;
        if (net == null) return <Network>.result(false, 401, null, null, 'unknown voucher', null);

        let valid = false;
        try valid = Key::verify(net.key, 'limitr-network/v1/request', request, signature);
        catch valid = false;
        const now: ms = Time::now();
        const oldest: ms = now - <Network>.SKEW;
        const newest: ms = now + <Network>.SKEW;
        const issued: ms = req.issued ?? 0;
        const endpoint_name = <Network>.endpoint_for(policy, method, path);
        let reason = null;
        if (!valid) reason = 'the signature does not match';
        else if (req.protocol != <Network>.PROTOCOL || req.type != 'request') reason = 'not a Limitr Network request';
        else if (req.method != method.upper() || req.path != path) reason = 'the signature is for another request';
        else if (req.body != <Network>.text_digest(body)) reason = 'the signature is for another body';
        else if (req.issued == null || issued < oldest || issued > newest) reason = 'the request is too old (or from the future)';
        else if (typeof req.n != 'int' || req.n < 1 || req.n <= net.n - <Network>.WINDOW || net.seen.contains(req.n)) reason = 'this request was already used';
        else if (endpoint_name == null) reason = 'no such endpoint';
        if (reason != null) return <Network>.result(false, 401, endpoint_name, id, reason, null);

        // a valid request is used up whether or not it's allowed
        net.seen.push_back(req.n);
        if (net.seen.len() > <Network>.WINDOW) net.seen.pop_front();
        if (req.n > net.n) net.n = req.n;

        const endpoint = policy.network.provider.endpoints.get(endpoint_name);
        const value = endpoint.value ?? 1;
        const allowed = policy.allow(id, endpoint.entitlement, value);
        const receipt = <Network>.receipt(policy, customer, req.n, endpoint.entitlement, allowed ? value : 0, allowed);
        <Network>.result(allowed, allowed ? 200 : 402, endpoint_name, id, allowed ? null : 'not allowed: a limit, the voucher\'s spend, or its expiry', receipt)
    }


    #[static]
    /**
     * End a voucher from this side (the provider): it stops being allowed now. Returns the signed revoke for the
     * consumer. Its usage is kept until the sweep (see sweep()).
     */
    fn revoke(policy: obj!, voucher: str!, reason: str = '') -> str {
        const customer: Customer = policy.customer('nv_' + voucher);
        const net = customer?.metadata?.network;
        if (net == null) return null;
        policy.set_customer_expires(customer.id, Time::now());
        using body = new { voucher, reason };
        <Network>.envelope(policy, 'revoke', net.key, body)
    }


    #[static]
    /**
     * A consumer ended its voucher: it stops being allowed now. True when the cancel was valid.
     */
    fn cancelled(policy: obj!, envelope: str!) -> bool {
        using msg = new {};
        try <Network>.open(policy, envelope, 'cancel', msg);
        catch return false;
        const customer: Customer = <Network>.valid_name(msg.body.voucher) ? policy.customer('nv_' + msg.body.voucher) : null;
        const net = customer?.metadata?.network;
        if (net == null || net.key != msg.from) return false;
        const now: ms = Time::now();
        const ends: ms = customer.expires ?? now;
        policy.set_customer_expires(customer.id, ends < now ? ends : now);
        true
    }


    #[static]
    /**
     * Remove voucher customers that ended more than `keep_ended` ago (provider.keep_ended, 7 days by default), so
     * their usage could be read and billed first. Sends 'network-voucher-ended' with each one before it's removed.
     * Returns how many were removed.
     */
    fn sweep(policy: obj!, now?: ms) -> int {
        const at: ms = now ?? Time::now();
        const keep: ms = policy.network?.provider?.keep_ended ?? 7days;
        const ended = [];
        for (const (id, customer) in policy.customers.fields()) {
            if (customer.type != 'voucher' || customer.metadata?.network == null || customer.expires == null) continue;
            const removed_at: ms = customer.expires + keep;
            if (removed_at <= at) ended.push_back(id);
        }
        for (const id in ended) {
            await <Event>.send('network-voucher-ended', policy.customer(id));
            policy.delete_customer(id);
        }
        ended.len()
    }


    /*****************************************************************************
     * Consumer.
     *****************************************************************************/

    #[static]
    /**
     * Start using a provider: read its manifest and sign a voucher for one of its plans, for up to `spend` (runes)
     * until `expires`. Returns the signed voucher to send to the provider. The connection is kept under
     * network.connections.<the provider's name>; a new voucher for a provider replaces the old one.
     */
    fn voucher(policy: obj!, manifest: str!, plan: str!, spend: float!, expires: ms!) -> str {
        using msg = new {};
        <Network>.open(policy, manifest, 'manifest', msg);
        const terms = msg.body;
        if (!<Network>.valid_name(terms.name)) throw('the provider needs a name (letters, numbers, _ and -)');
        if (terms.plans?.get(plan) == null) throw(`the provider doesn't offer plan '${plan}'`);
        if (spend <= 0) throw('a voucher needs a spend');
        const now: ms = Time::now();
        if (expires <= now) throw('a voucher needs an expiry in the future');

        if (policy.network.connections == null) policy.network.connections = new {} on policy.network;
        <Network>.disconnect(policy, terms.name);

        const conn = new {
            provider: msg.from,
            name: terms.name,
            label: terms.label ?? terms.name,
            url: terms.url,
            terms: <Network>.terms_digest_of(terms),
            voucher: nanoid(),
            seq: 1,
            plan,
            spend,
            expires,
            n: 0,
            spent: 0,
            remaining: spend,
            customer: null,
            link: null,
        } on policy.network.connections;
        policy.network.connections.insert(terms.name, conn);
        <Network>.voucher_message(policy, conn)
    }


    #[static]
    /**
     * Change a connection's voucher: more (or less) spend, a later (or earlier) expiry. Returns the signed voucher to
     * send to the provider; its grant comes back through connect() as before.
     */
    fn update(policy: obj!, name: str!, spend?: float, expires?: ms) -> str {
        const conn = policy.network.connections?.get(name);
        if (conn == null) throw(`no connection '${name}'`);
        conn.seq += 1;
        if (spend != null) conn.spend = spend;
        if (expires != null) conn.expires = expires;
        <Network>.voucher_message(policy, conn)
    }


    #[static]
    /**
     * Take the provider's grant: check it, then build the connection's link (sealed, confined to the provider's
     * host) and a capability for each endpoint. Returns the capability names.
     */
    fn connect(policy: obj!, envelope: str!) -> list {
        using peek = new {};
        parse(envelope, peek, 'json');
        using inner = new {};
        parse(peek.message ?? '{}', inner, 'json');
        const conn = <Network>.connection_for(policy, inner.body?.voucher);
        if (conn == null) throw('no connection for this voucher');

        using msg = new {};
        <Network>.open(policy, envelope, 'grant', msg, conn.provider);
        const g = msg.body;
        if (g.seq != conn.seq) throw('the grant is for another voucher');
        if (g.spend > conn.spend || g.expires > conn.expires) throw('the grant is for more than the voucher');
        if (g.url != conn.url) throw("the grant's URL isn't the manifest's");
        conn.customer = g.customer;
        conn.spend = g.spend;
        conn.expires = g.expires;
        conn.remaining = g.spend - conn.spent;

        // a new grant replaces the link and capabilities
        <Network>.remove_capabilities(policy, conn.name);
        if (conn.link != null) drop(conn.link);

        const link = new { url: conn.url } on conn;
        link.endpoints = new {} on link;
        parse(stringify('json', g.endpoints), link.endpoints, 'json');
        parse(<Network>.LINK, link);
        conn.link = link;
        seal(link, true, removable = true, reads = [], hosts = [<Network>.host(conn.url)]);

        const names = [];
        for (const (endpoint, decl) in link.endpoints.fields()) {
            const params = [];
            for (const p in decl.parameters ?? []) {
                params.push_back(new CapabilityParam {
                    name: p.name ?? '',
                    description: p.description ?? '',
                    schema_type: p.schema_type ?? 'string',
                    required: p.required ?? true,
                });
            }
            const cap = new NetworkCapability {
                name: conn.name + '_' + endpoint,
                description: decl.description ?? '',
                parameters: params,
                connection: conn.name,
                endpoint,
            };
            for (const p in params) p.move(cap);
            policy.set_capability(cap);
            names.push_back(cap.name);
        }
        names
    }


    #[static]
    /**
     * Call a connection's endpoint with arguments: a signed request to the provider, through the link (or
     * network.transport when the policy has one, Ex. in tests). Checks the receipt that comes back, and returns
     * the response body (text). Throws when the provider refuses (with its reason).
     */
    fn call(policy: obj!, name: str!, endpoint: str!, args: map = map()) -> str {
        const conn = policy.network.connections?.get(name);
        if (conn == null || conn.link == null) throw(`no connection '${name}'`);
        const decl = conn.link.endpoints.get(endpoint);
        if (decl == null) throw(`'${name}' has no endpoint '${endpoint}'`);

        const method = (decl.method ?? 'GET').upper();
        let path = decl.path ?? '/';
        let body = '';
        if (method == 'GET' || method == 'DELETE') {
            const query = [];
            for (const (k, v) in args) query.push_back(<Network>.encode(str(k)) + '=' + <Network>.encode(str(v)));
            if (query.len() > 0) path = path + (path.contains('?') ? '&' : '?') + query.join('&');
        } else {
            using json = Obj::from_map(args);
            body = stringify('json', json);
        }

        conn.n += 1;
        using req = new {
            protocol: <Network>.PROTOCOL,
            type: 'request',
            voucher: conn.voucher,
            n: conn.n,
            method,
            path,
            body: <Network>.text_digest(body),
            issued: Time::now(),
        };
        const request = stringify('json', req);
        const headers = map(
            ('content-type', 'application/json'),
            ('limitr-network-request', request),
            ('limitr-network-signature', <Network>.sign(policy, 'request', request)),
        );

        const transport = policy.network.transport;
        const resp: map = transport != null ? transport(conn.url, method, path, body, headers) : conn.link.fetch(method, path, body, headers);

        // the receipt says what this call cost and what's left, signed by the provider
        const receipt = (resp.get('headers') ?? map()).get('limitr-network-receipt');
        if (typeof receipt == 'str') {
            using r = new {};
            try {
                <Network>.open(policy, receipt, 'receipt', r, conn.provider);
                if (r.body.voucher == conn.voucher) {
                    conn.spent = r.body.spent;
                    conn.remaining = r.body.remaining;
                    await <Event>.send('network-receipt', conn);
                }
            } catch {}
        }

        const status = resp.get('status') ?? 0;
        if (status < 200 || status > 299) throw(`${conn.label} refused the call (${status}): ${resp.get('body') ?? ''}`);
        resp.get('body') ?? ''
    }


    #[static]
    /**
     * Stop using a provider: returns the signed cancel to send it, and removes the connection and its capabilities
     * here.
     */
    fn cancel(policy: obj!, name: str!) -> str {
        const conn = policy.network.connections?.get(name);
        if (conn == null) return null;
        using body = new { voucher: conn.voucher };
        const out = <Network>.envelope(policy, 'cancel', conn.provider, body);
        <Network>.disconnect(policy, name);
        out
    }


    #[static]
    /**
     * The provider ended a voucher (its revoke): removes the connection and its capabilities. True when it was valid.
     */
    fn revoked(policy: obj!, envelope: str!) -> bool {
        using peek = new {};
        parse(envelope, peek, 'json');
        using inner = new {};
        parse(peek.message ?? '{}', inner, 'json');
        const conn = <Network>.connection_for(policy, inner.body?.voucher);
        if (conn == null) return false;
        using msg = new {};
        try <Network>.open(policy, envelope, 'revoke', msg, conn.provider);
        catch return false;
        <Network>.disconnect(policy, conn.name);
        true
    }


    /*****************************************************************************
     * Messages.
     *****************************************************************************/

    #[static]
    /**
     * A signed message, as JSON text: { message, key, signature }. `message` is the JSON text of { protocol, type,
     * from, to, id, issued, expires, body }, and the signature is over exactly that text, under the context
     * 'limitr-network/v1/<type>'.
     */
    fn envelope(policy: obj!, type: str!, to: str, body: obj!, ttl: ms = 5min) -> str {
        const now: ms = Time::now();
        const expires: ms = now + ttl;
        using msg = new {
            protocol: <Network>.PROTOCOL,
            type,
            from: policy.network.key,
            to: to ?? '',
            id: nanoid(),
            issued: now,
            expires,
        };
        msg.body = new {} on msg;
        parse(stringify('json', body), msg.body, 'json');
        const message = stringify('json', msg);
        using env = new { message, key: policy.network.key, signature: <Network>.sign(policy, type, message) };
        stringify('json', env)
    }


    #[static]
    /**
     * Open a signed message: check its signature (under the context for `type`), that it's the protocol we speak,
     * from `from` (when given), for this policy (or anyone), and current. Parses the message into `into` and
     * returns it; throws with the reason when anything is off.
     */
    fn open(policy: obj!, envelope: str!, type: str!, into: obj!, from?: str) -> obj {
        using env = new {};
        try parse(envelope, env, 'json');
        catch throw('not a Limitr Network message');
        if (typeof env.message != 'str' || typeof env.key != 'str' || typeof env.signature != 'str') throw('not a Limitr Network message');
        if (from != null && env.key != from) throw('signed by an unexpected key');

        let valid = false;
        try valid = Key::verify(env.key, 'limitr-network/v1/' + type, env.message, env.signature);
        catch valid = false;
        if (!valid) throw('the signature does not match');

        parse(env.message, into, 'json');
        const now: ms = Time::now();
        const newest: ms = now + <Network>.SKEW;
        const expires: ms = into.expires ?? 0;
        const issued: ms = into.issued ?? 0;
        if (into.protocol != <Network>.PROTOCOL) throw(`not ${<Network>.PROTOCOL}`);
        if (into.type != type) throw(`not a ${type}`);
        if (into.from != env.key) throw('signed by a key other than its sender');
        if (into.to != null && into.to != '' && into.to != policy.network.key) throw('not for this policy');
        if (into.expires == null || now > expires) throw('the message has expired');
        if (into.issued == null || issued > newest) throw('the message is from the future');
        into
    }


    #[static]
    /**
     * Sign a message under 'limitr-network/v1/<type>' with this policy's key: the policy's network.signer function
     * when it has one (Ex. tests), otherwise the host's NetworkKey::sign. The policy never holds the secret key.
     */
    fn sign(policy: obj!, type: str!, message: str!) -> str {
        const context = 'limitr-network/v1/' + type;
        const signer = policy.network.signer;
        if (signer != null) return signer(context, message);
        NetworkKey::sign(context, message)
    }


    /*****************************************************************************
     * Internal.
     *****************************************************************************/

    #[static]
    /// The terms a provider offers (into `into`): name, label, url, plans, the credits they use, and endpoints. Each
    /// is written field by field with its default (never exported whole: the engine fills in a plan's typed fields
    /// as it uses it), then through JSON, so both sides read the same text and its digest matches.
    fn terms(policy: obj!, into: obj!) {
        const provider = policy.network.provider;
        using raw = new { name: provider.name, label: provider.label ?? provider.name, url: provider.url, currency: 'rune' };
        raw.plans = new {} on raw;
        raw.credits = new {} on raw;
        raw.endpoints = new {} on raw;
        for (const name in provider.offers ?? []) {
            const plan = policy.plans.get(name);
            if (plan == null) continue;
            const p = new { label: plan.label ?? name, period: plan.period ?? 'monthly' } on raw.plans;
            p.entitlements = new {} on p;
            raw.plans.insert(name, p);
            for (const (ent_name, ent) in plan.entitlements.fields()) {
                if (typeof ent != 'obj') continue;
                const e = new { description: ent.description ?? '' } on p.entitlements;
                p.entitlements.insert(ent_name, e);
                const limit = ent.limit;
                if (limit == null) continue;
                e.limit = new {
                    credit: limit.credit,
                    mode: limit.mode ?? 'hard',
                    value: <Network>.number(limit.value ?? 0),
                    increment: <Network>.number(limit.increment ?? 1),
                    resets: limit.resets ?? false,
                } on e;
                if (limit.reset_sch != null) e.limit.reset_sch = limit.reset_sch;
                if (limit.reset_inc != null) e.limit.reset_inc = limit.reset_inc;
                <Network>.credit_terms(policy, limit.credit, raw.credits);
            }
        }
        for (const (name, endpoint) in (provider.endpoints ?? new {}).fields()) {
            if (endpoint.plans != null && !endpoint.plans.any((plan: str): bool => (provider.offers ?? []).contains(plan))) continue;
            const e = new {
                description: endpoint.description ?? '',
                method: (endpoint.method ?? 'GET').upper(),
                path: endpoint.path ?? '/',
                entitlement: endpoint.entitlement,
                value: <Network>.number(endpoint.value ?? 1),
            } on raw.endpoints;
            const params = [];
            for (const param in endpoint.parameters ?? []) {
                params.push_back(map(
                    ('name', param.name ?? ''),
                    ('description', param.description ?? ''),
                    ('schema_type', param.schema_type ?? 'string'),
                    ('required', param.required ?? true),
                ));
            }
            e.parameters = params;
            if (endpoint.plans != null) e.plans = endpoint.plans;
            raw.endpoints.insert(name, e);
        }
        parse(stringify('json', raw), into, 'json');
    }


    #[static]
    /// A credit's terms (once, into `credits`): what it costs the consumer, never what it costs the provider.
    fn credit_terms(policy: obj!, name: str, credits: obj!) {
        if (name == null || credits.get(name) != null) return;
        const credit: Credit = policy.credit(name);
        if (credit == null) return;
        const c = new {
            label: credit.label ?? name,
            unit: credit.unit ?? 'credit',
            description: credit.description ?? '',
            pricing_model: credit.pricing_model ?? 'flat',
            price: <Network>.number(credit.price?.amount ?? 0),
        } on credits;
        if (credit.tiers != null) {
            const tiers = [];
            for (const tier in credit.tiers) tiers.push_back(map(('up_to', <Network>.number(tier.up_to)), ('price', <Network>.number(tier.price?.amount ?? 0))));
            c.tiers = tiers;
        }
        credits.insert(name, c);
    }


    #[static]
    /// A number for the terms: always a float (an int and a float of the same value are different JSON text), a
    /// string with units as written (Ex. '10GB'), null as null.
    fn number(value: unknown) -> unknown {
        typeof value == 'int' ? (value as float) : value
    }


    #[static]
    /// The digest of the terms a provider offers now.
    fn terms_digest(policy: obj!) -> str {
        using t = new {};
        <Network>.terms(policy, t);
        <Network>.terms_digest_of(t)
    }


    #[static]
    /// The digest of terms (read from a manifest, or built by terms()): SHA-256 of their JSON, which is the same
    /// text on both sides (the terms are built through JSON).
    fn terms_digest_of(terms: obj!) -> str {
        <Network>.text_digest(stringify('json', terms))
    }


    #[static]
    /// The digest of a text (a request body): SHA-256, through a one-field object.
    fn text_digest(text: str!) -> str {
        digest(using new { text }, true)
    }


    #[static]
    /// The signed voucher for a connection.
    fn voucher_message(policy: obj!, conn: obj!) -> str {
        using body = new {
            voucher: conn.voucher,
            seq: conn.seq,
            plan: conn.plan,
            terms: conn.terms,
            spend: conn.spend,
            expires: conn.expires,
            name: policy.network.name ?? '',
        };
        <Network>.envelope(policy, 'voucher', conn.provider, body)
    }


    #[static]
    /// A signed refusal.
    fn refuse(policy: obj!, to: str, voucher: str, reason: str!) -> str {
        using body = new { voucher, reason };
        <Network>.envelope(policy, 'refused', to, body)
    }


    #[static]
    /// A signed receipt for a call: what it used, and what the voucher has spent and has left (runes).
    fn receipt(policy: obj!, customer: Customer!, n: int!, entitlement: str!, value: float!, allowed: bool!) -> str {
        const cap: Cap = customer.caps.get('network');
        const limit: float = cap != null ? cap.value as float : 0;
        const spent: float = cap != null ? Num::round(cap.meter_value, 9) : 0;
        using body = new {
            voucher: customer.metadata.network.voucher,
            n,
            entitlement,
            value,
            allowed,
            spent,
            remaining: Num::round(max(0, limit - spent), 9),
        };
        <Network>.envelope(policy, 'receipt', customer.metadata.network.key, body)
    }


    #[static]
    /// The result of handle().
    fn result(allowed: bool, status: int, endpoint: str, customer: str, reason: str, receipt: str) -> map {
        map(('allowed', allowed), ('status', status), ('endpoint', endpoint), ('customer', customer), ('reason', reason), ('receipt', receipt))
    }


    #[static]
    /// The provider's endpoint for a method and path (the path without its query string).
    fn endpoint_for(policy: obj!, method: str!, path: str!) -> str {
        const bare = path.split('?')[0];
        for (const (name, endpoint) in (policy.network.provider?.endpoints ?? new {}).fields()) {
            if ((endpoint.method ?? 'GET').upper() == method.upper() && endpoint.path == bare) return name;
        }
        null
    }


    #[static]
    /// The connection holding a voucher.
    fn connection_for(policy: obj!, voucher: str) -> obj {
        if (voucher == null) return null;
        for (const (_, conn) in (policy.network.connections ?? new {}).fields()) {
            if (conn.voucher == voucher) return conn;
        }
        null
    }


    #[static]
    /// Remove a connection and its capabilities.
    fn disconnect(policy: obj!, name: str!) {
        <Network>.remove_capabilities(policy, name);
        const conn = policy.network.connections?.get(name);
        if (conn == null) return;
        if (conn.link != null) drop(conn.link); // the sealed (removable) link first
        drop(conn);
    }


    #[static]
    /// Remove a connection's capabilities.
    fn remove_capabilities(policy: obj!, name: str!) {
        const names = [];
        for (const (cap_name, cap) in policy.capabilities.fields()) {
            if (cap.connection == name) names.push_back(cap_name);
        }
        for (const cap_name in names) drop(policy.capabilities.get(cap_name));
    }


    #[static]
    /// A URL's host (no scheme, port, or path).
    fn host(url: str!) -> str {
        const rest = url.contains('://') ? url.split('://')[1] : url;
        rest.split('/')[0].split('?')[0].split(':')[0].lower()
    }


    #[static]
    /// Letters, numbers, _ and - (a name, or an ID).
    fn valid_name(name: unknown) -> bool {
        typeof name == 'str' && name.matches(r#"^[A-Za-z0-9_-]{1,64}$"#)
    }


    #[static]
    /// Percent-encode a query string part (the characters that would change its meaning).
    fn encode(text: str!) -> str {
        let out = text.replace('%', '%25').replace(' ', '%20').replace('&', '%26').replace('=', '%3D');
        out.replace('?', '%3F').replace('#', '%23').replace('+', '%2B').replace('/', '%2F')
    }
}


#[type]
#[extends('Capability')]
/**
 * A capability built from a provider's endpoint (Network.connect()): running it calls the provider.
 */
NetworkCapability: {
    /// The connection it calls (network.connections.<name>).
    str connection: '';

    /// The endpoint it calls.
    str endpoint: '';

    #[run]
    fn network_call() {
        const policy = self.parent().parent();
        self.set_result(<Network>.call(policy, self.connection, self.endpoint, self.input.to_map()));
    }
}
