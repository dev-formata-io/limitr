#[test]
fn vector_keys() {
    assert_eq(Key::public(self.Vectors.consumer_secret), self.Vectors.consumer_public);
    assert_eq(Key::public(self.Vectors.provider_secret), self.Vectors.provider_public);
}

#[test]
fn vector_digests() {
    const v = self.Vectors;
    assert_eq(sha256(v.terms), v.terms_digest);
    assert_eq(sha256(''), v.empty_digest);
    assert_eq(sha256(v.request_body), v.request_body_digest);
}

#[test]
fn vector_signatures() {
    const v = self.Vectors;
    using env = new {};
    parse(v.voucher_envelope, env, 'json');
    assert_eq(Key::sign(v.consumer_secret, <Network>.CONTEXT + 'voucher', env.message), v.voucher_signature, 'Ed25519 is deterministic');
    assert(<Network>.verify(v.consumer_public, 'voucher', env.message, v.voucher_signature));
    assert_not(<Network>.verify(v.consumer_public, 'grant', env.message, v.voucher_signature), 'the context is the type');
    assert(<Network>.verify(v.consumer_public, 'request', v.request_header, v.request_signature));
    assert_eq(Key::sign(v.consumer_secret, <Network>.CONTEXT + 'request', v.request_header), v.request_signature);
    using rec = new {};
    parse(v.receipt_envelope, rec, 'json');
    assert_eq(Key::sign(v.provider_secret, <Network>.CONTEXT + 'receipt', rec.message), v.receipt_signature);
}

#[test]
fn vector_envelopes_open() {
    const v = self.Vectors;
    // the provider opens the consumer's voucher (not current: these are from a fixed time)
    using provider = new Network { key: v.provider_public };
    using msg = new {};
    provider.open(v.voucher_envelope, 'voucher', msg, v.consumer_public, null, false);
    assert_eq(msg.body.plan, 'agent');
    assert_eq(msg.body.terms, v.terms_digest, 'the voucher agrees to the terms by their digest');
    assert(<TestNetwork>.refused(() => provider.open(v.voucher_envelope, 'voucher', msg, v.consumer_public)).contains('expired'), 'its time has passed');

    // the consumer opens the receipt, and it binds the response body
    using consumer = new Network { key: v.consumer_public };
    using r = new {};
    consumer.open(v.receipt_envelope, 'receipt', r, v.provider_public, null, false);
    assert_eq(r.body.body, sha256(v.response_body));
    assert_eq(r.body.cost, 0.01);

    // one byte changed: the signature doesn't check out
    using t = new {};
    assert(<TestNetwork>.refused(() => consumer.open(v.receipt_envelope.replace('0.01', '0.02'), 'receipt', t, v.provider_public, null, false)).contains('signature'));
}
