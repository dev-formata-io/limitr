//
// Network protocol tests: a provider and a consumer policy in one document. The consumer's network.transport hands
// each request to its provider's handle() (what the provider's HTTP server does), so everything runs the whole way:
// manifest, voucher, grant, signed calls, receipts, cancels.
//
// Test keys (never use these anywhere else):
//   provider  secret f0hrbcBxEsY/2hs5j3AGA4Pv6ETSnIZvjk9bBvimM/o=  public eKFw/TZJJlkCuIgkPEz/Dc887hVDNlUYZm3VJvz8DyE=
//   consumer  secret a47o0A9U6j7LYo/7XUvHLr+wNc8lPWPi79Pn3FPCaxI=  public quMqUnOWtAeYIIxUlcMBO7HdUb5GASQMJFUZTQCFXig=
//   stranger  secret SErKz820ZSInmfSAxwBnnBzEV+YbwVqw3fr6MjY5g8Q=  public 4u1k0ceiPMzbEFPlt5Uj/gxaR93jpFeVuYh6tE0OFEE=
//

#[type_ignore]
Limitr Provider: {
    /// The work of a route the provider allowed (see <TestNetwork>.work).
    fn work(route: str, customer: str, req: map) -> str { <TestNetwork>.work(self, route, customer, req) }

    credits: {
        forecast: {
            label: 'Forecast'
            unit: 'forecast'
            price: { amount: 0.01 }
            overhead_cost: 0.002
        }
    }

    plans: {
        agent: {
            label: 'Agent'
            entitlements: {
                forecasts: { limit: { credit: 'forecast', mode: 'soft', value: 0 } }
            }
        }
        internal: {
            label: 'Internal'
            entitlements: {
                forecasts: {}
            }
        }
    }

    network: {
        key: 'eKFw/TZJJlkCuIgkPEz/Dc887hVDNlUYZm3VJvz8DyE='
        provider: {
            name: 'acme_weather'
            label: 'Acme Weather'
            url: 'https://api.acme.example'
            offers: ['agent']
            routes: {
                forecast: {
                    description: 'The forecast for a city'
                    path: '/forecast'
                    parameters: [{ name: 'city', description: 'City name' }]
                    entitlement: 'forecasts'
                }
                alert: {
                    description: 'Set a weather alert for a city'
                    method: 'POST'
                    path: '/alerts'
                    parameters: [{ name: 'city', description: 'City name' }, { name: 'when', description: 'rain or snow' }]
                    entitlement: 'forecasts'
                    value: 2
                }
                staff: {
                    description: 'Internal only'
                    path: '/staff'
                    entitlement: 'forecasts'
                    plans: ['internal']
                }
            }
        }

        fn signer(context: str, message: str) -> str { Key::sign('f0hrbcBxEsY/2hs5j3AGA4Pv6ETSnIZvjk9bBvimM/o=', context, message) }
    }
}

#[type_ignore]
Limitr Consumer: {
    network: {
        key: 'quMqUnOWtAeYIIxUlcMBO7HdUb5GASQMJFUZTQCFXig='
        name: 'test_agent'

        /// Set by each test: the provider this consumer's requests go to.
        peer: null

        /// The last request this consumer sent (for replay tests).
        last: null

        fn signer(context: str, message: str) -> str { Key::sign('a47o0A9U6j7LYo/7XUvHLr+wNc8lPWPi79Pn3FPCaxI=', context, message) }

        /// Instead of HTTP: what the provider's server does with the request.
        fn transport(request: map) -> map {
            self.last = request;
            <TestNetwork>.serve(self.peer, request)
        }
    }
}


#[type]
/**
 * Test helpers.
 */
TestNetwork: {
    #[static]
    /// What a provider's HTTP server does: serve() the request, doing a route's work when it's allowed. The work is
    /// the provider's own function (not an arrow: an arrow's captured variables are shared by every evaluation of it,
    /// so tests running at once would see each other's provider).
    fn serve(provider: obj!, request: map!) -> map {
        provider.network.provider.serve(request, provider.work)
    }

    #[static]
    /// A route's work, for the test providers.
    fn work(provider: obj!, route: str!, customer: str!, req: map!) -> str {
        switch (route) {
            case 'forecast': 'sunny in ' + req.get('url').split('city=')[1]
            case 'alert': 'alert set'
            case 'bulk': {
                // a route with no declared metering: the work meters (Ex. tests add one)
                const count = (req.get('url').split('count=')[1] ?? '1') as int;
                provider.allow(customer, 'forecasts', count) ? `${count} forecasts` : 'more than this request may spend'
            }
            default: 'ok'
        }
    }

    #[static]
    /// A provider and a consumer of its own (both typed and checked). Drop both when done.
    fn pair(context: obj!) -> (obj, obj) {
        const provider = copy(context.Provider);
        const consumer = copy(context.Consumer);
        assert(<Network>.load(provider), <LimitrValidation>.error_message);
        assert(<Network>.load(consumer), <LimitrValidation>.error_message);
        consumer.network.peer = provider;
        (provider, consumer)
    }

    #[static]
    /// A provider and a consumer connected for `spend` runes for an hour. Drop both when done.
    fn connected(context: obj!, spend: float = 1) -> (obj, obj) {
        const pair = <TestNetwork>.pair(context);
        pair[1].network.connect('https://api.acme.example', 'agent', spend, Time::now() + 1hr);
        pair
    }

    #[static]
    /// The message inside a signed envelope (into `into`).
    fn message(envelope: str!, into: obj!) -> obj {
        using env = new {};
        parse(envelope, env, 'json');
        parse(env.message, into, 'json');
        into
    }

    #[static]
    /// The same message, signed by the stranger (a key nobody trusts).
    fn forge(envelope: str!, type: str!) -> str {
        using env = new {};
        parse(envelope, env, 'json');
        using forged = new {
            message: env.message,
            key: '4u1k0ceiPMzbEFPlt5Uj/gxaR93jpFeVuYh6tE0OFEE=',
            signature: Key::sign('SErKz820ZSInmfSAxwBnnBzEV+YbwVqw3fr6MjY5g8Q=', <Network>.CONTEXT + type, env.message),
        };
        stringify('json', forged)
    }

    #[static]
    /// What a call to `fn` throws ('' when it doesn't).
    fn refused(fn: fn) -> str {
        let out = '';
        try fn();
        catch (e, message) out = message;
        out
    }
}


/*****************************************************************************
 * Policies.
 *****************************************************************************/

#[test]
fn a_policy_network_is_typed_and_checked() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    assert_eq(typename provider.network, 'Network');
    assert_eq(typename provider.network.provider, 'NetworkProvider');
    assert_eq(typename provider.network.provider.routes.forecast, 'NetworkRoute');
    assert_eq(provider.network.provider.routes.forecast.method, 'GET', 'defaults filled in');
    assert_eq(provider.network.provider.routes.forecast.value, 1);
    assert_eq(provider.network.provider.max_voucher, 30days);

    provider.network.provider.routes.forecast.path = 'forecast';
    assert_not(<Network>.load(provider));
    assert(<LimitrValidation>.error_message.contains('must start with /'), <LimitrValidation>.error_message);
    provider.network.provider.routes.forecast.path = '/forecast';
    provider.network.provider.name = 'acme weather';
    assert_not(<Network>.load(provider));
    assert(<LimitrValidation>.error_message.contains('letters, numbers'), <LimitrValidation>.error_message);
}


/*****************************************************************************
 * Manifest.
 *****************************************************************************/

#[test]
fn manifest_offers_what_the_provider_offers() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    using m = new {};
    consumer.network.open(provider.network.provider.manifest(), 'manifest', m);
    assert_eq(m.from, provider.network.key);
    using t = new {};
    parse(m.body.terms, t, 'json'); // the terms come as text

    assert_eq(t.name, 'acme_weather');
    assert(t.plans.agent != null, 'the offered plan');
    assert_null(t.plans.internal, 'not the others');
    assert_eq(t.credits.forecast.price, 0.01, 'what it costs the consumer');
    assert_null(t.credits.forecast.overhead_cost, 'never what it costs the provider');
    assert(t.routes.forecast != null && t.routes.alert != null);
    assert_null(t.routes.staff, 'routes for plans it does not offer stay out');
}

#[test]
fn terms_price_credits_through_the_exchange() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    // a credit priced in USD by an exchange pair (it takes precedence over its own price), a tiered credit, and a
    // credit worth 10 of the tiered one; and a rune that's worth 0.9 EUR to this provider
    parse(`
        exchange: {
            forecast: { value: 0.02, currency: 'usd' }
            pack: { value: 10, currency: 'call' }
            rune: { value: 0.9, currency: 'eur' }
            eur: { value: 1.11, currency: 'rune' }
        }
        credits: {
            call: { label: 'Call', unit: 'call', pricing_model: 'tiered', tiers: [{ up_to: 100, price: { amount: 0.001 } }, { price: { amount: 0.0005 } }] }
            pack: { label: 'Pack', unit: 'pack' }
        }
        plans: { agent: { entitlements: {
            calls: { limit: { credit: 'call', mode: 'soft', value: 0 } }
            packs: { limit: { credit: 'pack', mode: 'soft', value: 0 } }
        } } }
    `, provider, 'stof');
    using t = new {};
    parse(provider.network.provider.terms_text(), t, 'json');

    assert_eq(t.rune.value, 0.9, "the provider's rune, from its exchange");
    assert_eq(t.rune.currency, 'eur');
    assert_eq(t.credits.forecast.price, 0.02, 'through its exchange pair, in runes');
    assert_eq(t.credits.forecast.pricing_model, 'flat');
    assert_eq(t.credits.call.pricing_model, 'tiered');
    assert_eq(t.credits.call.tiers[0].price, 0.001);
    assert_eq(t.credits.call.tiers[0].up_to, 100.0);
    assert_null(t.credits.call.tiers[1].up_to);
    assert_eq(t.credits.pack.pricing_model, 'tiered', "the tiered credit's pricing");
    assert_eq(t.credits.pack.tiers[0].price, 0.01, 'a pack is 10 calls');
    assert_eq(t.credits.pack.tiers[0].up_to, 10.0, 'the first 100 calls are the first 10 packs');
    assert_eq(t.credits.pack.tiers[1].price, 0.005);
    // what the terms say a unit costs is what the policy charges for it
    assert_eq(Num::round(provider.price_units('forecast', 1), 9), t.credits.forecast.price);
    assert_eq(Num::round(provider.price_units('pack', 1), 9), t.credits.pack.tiers[0].price);
}

#[test]
fn terms_digest_is_the_same_on_both_sides() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    using m = new {};
    consumer.network.open(provider.network.provider.manifest(), 'manifest', m);
    // the SHA-256 of the terms text as sent: anyone can compute it, in any language
    assert_eq(<Network>.text_digest(m.body.terms), provider.network.provider.terms_digest());
    assert_eq(provider.network.provider.terms_digest(), sha256(provider.network.provider.terms_text()));
    assert_eq(provider.network.provider.terms_digest().len(), 64);
}

#[test]
fn a_failed_fetch_is_a_response() {
    // too large, or timed out (Http::fetch's max and timeout: the network's max_response and request_timeout)
    const out = <Network>.response(map(('error', 'the response is larger than 10485760 bytes')));
    assert_eq(out.get('status'), 0);
    assert(out.get('body').contains('larger than'));
}

#[test]
fn a_changed_manifest_is_refused() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    using env = new {};
    parse(provider.network.provider.manifest(), env, 'json');
    env.message = env.message.replace('0.01', '0.0001');
    const tampered = stringify('json', env);
    using m = new {};
    assert(<TestNetwork>.refused(() => consumer.network.open(tampered, 'manifest', m)).contains('signature'));
}


/*****************************************************************************
 * Vouchers and grants.
 *****************************************************************************/

#[test]
fn connect_builds_capabilities() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];

    const conn = consumer.network.connection('acme_weather');
    assert_eq(typename conn, 'NetworkConnection');
    assert_eq(conn.customer, 'nv_' + conn.voucher);
    assert(consumer.capability('acme_weather_forecast') != null);
    assert(consumer.capability('acme_weather_alert') != null);
    assert_null(consumer.capability('acme_weather_staff'));

    // the provider meters a normal customer of type voucher, capped at the voucher's spend
    const customer = provider.customer(conn.customer);
    assert_eq(customer.type, 'voucher');
    assert_eq(customer.plan, 'agent');
    assert_eq(customer.caps.network.value, 1);
    const latest: ms = Time::now() + 1hr;
    assert(customer.expires != null && customer.expires <= latest);

    // the tools an agent sees
    assert(consumer.claude_tools().contains('acme_weather_forecast'));
}

#[test]
fn a_call_runs_end_to_end() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];

    assert_eq(consumer.run_capability('acme_weather_forecast', {'city': 'Boston'}), 'sunny in Boston');
    assert_eq(consumer.run_capability('acme_weather_alert', {'city': 'Boston', 'when': 'rain'}), 'alert set');

    // both sides agree on what it cost: 1 + 2 forecasts at 0.01
    const conn = consumer.network.connection('acme_weather');
    assert_eq(conn.spent, 0.03);
    assert_eq(conn.remaining, 0.97);
    assert_eq(provider.customer(conn.customer).caps.network.meter_value, 0.03);
    assert_eq(provider.value(conn.customer, 'forecasts'), 3);
}

#[test]
fn the_spend_is_a_cap_and_an_update_raises_it() {
    const pair = <TestNetwork>.connected(self, 0.015);
    using provider = pair[0];
    using consumer = pair[1];

    assert_eq(consumer.run_capability('acme_weather_forecast', {'city': 'Boston'}), 'sunny in Boston');
    // a refusal is the tool's result (so an agent can act on it), with what the voucher has spent and has left
    using result = new {};
    parse(consumer.run_capability('acme_weather_forecast', {'city': 'Denver'}), result, 'json');
    assert_eq(result.refused.provider, 'acme_weather');
    assert_eq(result.refused.status, 402);
    assert(result.refused.reason.contains('not allowed'));
    assert_eq(result.refused.spent, 0.01);
    assert_eq(result.refused.remaining, 0.005);

    // more spend: a newer voucher, a new grant
    consumer.network.update('acme_weather', 1);
    assert_eq(consumer.run_capability('acme_weather_forecast', {'city': 'Denver'}), 'sunny in Denver');
    assert_eq(provider.customer(consumer.network.connection('acme_weather').customer).caps.network.value, 1);
}

#[test]
fn refused_vouchers() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];

    // a plan it doesn't offer
    assert(<TestNetwork>.refused(() => consumer.network.connect('https://api.acme.example', 'internal', 1, Time::now() + 1hr)).contains('internal'));

    // terms that changed since the voucher
    consumer.network.connect('https://api.acme.example', 'agent', 1, Time::now() + 1hr);
    provider.credits.forecast.price.amount = 0.02;
    const failed = <TestNetwork>.refused(() => consumer.network.update('acme_weather', 2));
    assert(failed.contains('terms have changed'), failed);

    // a voucher someone else signed
    const last: map = consumer.network.last;
    using forged = <TestNetwork>.message(provider.network.provider.accept(<TestNetwork>.forge(last.get('body'), 'voucher')), new {});
    assert_eq(forged.type, 'refused', 'signed by a key that is not its sender');
}

#[test]
fn a_provider_shortens_a_voucher() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    provider.network.provider.max_voucher = 1hr;
    consumer.network.connect('https://api.acme.example', 'agent', 1, Time::now() + 30days);
    const latest: ms = Time::now() + 1hr;
    assert(consumer.network.connection('acme_weather').expires <= latest);
}

#[test]
fn a_grant_from_someone_else_is_refused() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    consumer.network.transport = (request: map): map => {
        const out = <TestNetwork>.serve(provider, request);
        if (request.get('url').ends_with('/limitr-network/voucher')) out.insert('body', <TestNetwork>.forge(out.get('body'), 'grant'));
        out
    };
    const failed = <TestNetwork>.refused(() => consumer.network.connect('https://api.acme.example', 'agent', 1, Time::now() + 1hr));
    assert(failed.contains('unexpected key'), failed);
    assert_null(consumer.capability('acme_weather_forecast'));
}

#[test]
fn a_voucher_without_an_end_is_refused() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    assert(<TestNetwork>.refused(() => consumer.network.connect('https://api.acme.example', 'agent', 1, Time::now() - 1s)).contains('expiry'));
}


/*****************************************************************************
 * Requests.
 *****************************************************************************/

#[test]
fn a_request_works_once() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];
    consumer.run_capability('acme_weather_forecast', {'city': 'Boston'});

    const again = provider.network.provider.handle(consumer.network.last);
    assert_eq(again.get('status'), 401);
    assert_eq(again.get('reason'), 'this request was already used');
    assert_eq(provider.value(consumer.network.connection('acme_weather').customer, 'forecasts'), 1, 'and it was not metered again');
}

#[test]
fn a_request_is_for_exactly_what_was_signed() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];
    consumer.network.transport = (request: map): map => {
        consumer.network.last = request;
        map(('status', 200), ('headers', map()), ('body', ''))
    };
    consumer.run_capability('acme_weather_alert', {'city': 'Boston', 'when': 'rain'});
    const sent = consumer.network.last;
    const handle = (change: map): map => {
        const request = copy(sent);
        for (const (k, v) in change) request.insert(k, v);
        provider.network.provider.handle(request)
    };

    assert_eq(handle(map(('body', sent.get('body').replace('rain', 'snow')))).get('reason'), 'the signature is for another body');
    assert_eq(handle(map(('url', 'https://api.acme.example/forecast'), ('method', 'GET'))).get('reason'), 'the signature is for another request');
    const forged = copy(sent.get('headers'));
    forged.insert('limitr-network-signature', Key::sign('SErKz820ZSInmfSAxwBnnBzEV+YbwVqw3fr6MjY5g8Q=', 'limitr-network/v1/request', forged.get('limitr-network-request')));
    assert_eq(handle(map(('headers', forged))).get('reason'), 'the signature does not match');
    assert_eq(handle(map(('headers', map()))).get('status'), 401);

    // the real one still works (none of the above used it up)
    assert_eq(provider.network.provider.handle(sent).get('customer'), consumer.network.connection('acme_weather').customer);
}

#[test]
fn requests_can_arrive_out_of_order() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];
    const sent = [];
    consumer.network.transport = (request: map): map => {
        sent.push_back(request);
        map(('status', 200), ('headers', map()), ('body', ''))
    };
    for (const i in 3) consumer.run_capability('acme_weather_forecast', {'city': 'Boston'});
    for (const i in [2, 0, 1]) {
        assert_eq(provider.network.provider.handle(sent[i]).get('status'), 200, `request ${i}`);
    }
    assert_eq(provider.value(consumer.network.connection('acme_weather').customer, 'forecasts'), 3);
}


/*****************************************************************************
 * Connections.
 *****************************************************************************/

#[test]
fn a_connection_is_sealed_and_confined() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];
    const link = consumer.network.connection('acme_weather').link;
    assert_eq(typename link, 'NetworkLink');
    const info = sealed(link);
    assert(info.get('fields'));
    assert(info.get('removable'));
    assert_eq(info.get('confined')[0].get('hosts'), ['api.acme.example']);
    assert_eq(info.get('confined')[0].get('reads'), []);

    assert(<TestNetwork>.refused(() => { link.url = 'https://elsewhere.example'; }).contains('sealed'));
    assert_eq(link.url, 'https://api.acme.example');
}


/*****************************************************************************
 * Ending.
 *****************************************************************************/

#[test]
fn cancel_ends_it_on_both_sides() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];
    const id = consumer.network.connection('acme_weather').customer;

    assert(consumer.network.cancel('acme_weather'));
    assert_null(consumer.network.connection('acme_weather'));
    assert_null(consumer.capability('acme_weather_forecast'));
    assert_not(provider.allow(id, 'forecasts', 1), 'the voucher customer has ended');
    assert(provider.customer(id) != null, 'and is kept until the sweep');
}

#[test]
fn revoke_ends_it_on_both_sides() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];
    const conn = consumer.network.connection('acme_weather');
    const id = conn.customer;

    // a revoke counts only when the provider signed it, whoever delivers it (Ex. an operator relaying it)
    using body = new { voucher: conn.voucher, reason: 'not the provider' };
    assert_not(consumer.network.revoked(consumer.network.envelope('revoke', consumer.network.key, body)), 'another key');
    assert(consumer.network.connection('acme_weather') != null);

    assert(consumer.network.revoked(provider.network.provider.revoke(conn.voucher, 'done')));
    assert_null(consumer.network.connection('acme_weather'));
    assert_null(consumer.capability('acme_weather_forecast'));
    assert_not(provider.allow(id, 'forecasts', 1));
}

#[test]
fn the_sweep_removes_ended_vouchers() {
    const pair = <TestNetwork>.connected(self);
    using provider = pair[0];
    using consumer = pair[1];
    const id = consumer.network.connection('acme_weather').customer;
    consumer.run_capability('acme_weather_forecast', {'city': 'Boston'});

    const sweeper = provider.network.provider;
    assert_eq(sweeper.sweep(), 0, 'not ended');
    consumer.network.cancel('acme_weather');
    assert_eq(sweeper.sweep(), 0, 'ended, but kept for a week');
    assert_eq(sweeper.sweep(Time::now() + 8days), 1);
    assert_null(provider.customer(id));
}

#[test]
fn a_provider_must_fit_its_policy() {
    const pair = <TestNetwork>.pair(self);
    using provider = pair[0];
    using consumer = pair[1];
    assert(provider.valid(), <LimitrValidation>.error_message); // the policy's valid() checks its network

    provider.network.provider.offers.push_back('enterprise');
    assert_not(provider.valid());
    assert(<LimitrValidation>.error_message.contains('enterprise'));
    provider.network.provider.offers.pop_back();

    provider.network.provider.routes.forecast.entitlement = 'maps';
    assert_not(provider.valid());
    assert(<LimitrValidation>.error_message.contains("doesn't have"));
    provider.network.provider.routes.forecast.entitlement = 'forecasts';

    provider.network.provider.routes.alert.method = 'GET';
    provider.network.provider.routes.alert.path = '/forecast';
    assert_not(provider.valid());
    assert(<LimitrValidation>.error_message.contains('both GET /forecast'));
    provider.network.provider.routes.alert.method = 'POST';
    provider.network.provider.routes.alert.path = '/alerts';
    assert(provider.valid(), <LimitrValidation>.error_message);

    // a policy without a network gets none from valid()
    assert(consumer.valid());
    using plain = new Limitr {};
    assert(plain.valid());
    assert_null(plain.network);
}
